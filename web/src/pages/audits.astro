---
import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/AppHeader.astro';
import { usePageLang } from '../lib/page-lang.js';

const tr = usePageLang(Astro);
---
<Layout title={tr('scans.title')} description={tr('scans.description')}>
  <div class="app-shell">
    <AppHeader crumb={tr('scans.crumb')} />
    <main id="main" class="app-main" tabindex="-1">
      <div data-screen-label="All audits" style="background: var(--us-cream); min-height: calc(100dvh - 65px); min-height: calc(100vh - 65px); position: relative; overflow: hidden;">
        <div aria-hidden="true" class="motion-drift" style="position: absolute; top: -180px; right: -120px; width: 520px; height: 520px; border-radius: 50%; background: var(--us-grad-iridescent); opacity: 0.35; filter: blur(60px); animation: drift 24s ease-in-out infinite; pointer-events: none;"></div>

        <div class="container" style="padding: clamp(32px, 5vw, 56px) 0 clamp(48px, 8vw, 96px); position: relative;">
          <div class="audits-head">
            <div>
              <span class="eyebrow"><span class="dot"></span>{tr('scans.eyebrow')}</span>
              <h1 class="audits-title">{tr('scans.h1')}</h1>
              <p class="p-large muted" style="max-width: 680px;">{tr('scans.lead')}</p>
            </div>
            <a class="btn btn-primary btn-lg" href="/">
              {tr('header.startScan')}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7" /></svg>
            </a>
          </div>

          <div class="card-flat" style="padding: 22px; margin-bottom: 24px;">
            <p class="muted" style="font-size: 14px; margin: 0 0 12px;">{tr('scans.info')}</p>
            <button type="button" class="btn btn-secondary" id="refresh-audits">{tr('scans.refresh')}</button>
            <div id="audits-msg" role="status" style="margin-top: 10px; font-size: 14px; color: var(--us-peach-text); min-height: 20px;"></div>
          </div>

          <div class="card-flat" style="padding: 0;" id="list-wrap">
            <div class="list-row audits-row head">
              <span>{tr('scans.col.site')}</span>
              <span>{tr('scans.col.latest')}</span>
              <span>{tr('scans.col.status')}</span>
              <span>{tr('scans.col.pages')}</span>
              <span>{tr('scans.col.issues')}</span>
              <span>{tr('scans.col.scans')}</span>
              <span>{tr('scans.col.updated')}</span>
              <span></span>
            </div>
            <div id="rows">
              <div class="list-row audits-row" style="grid-template-columns: 1fr;">
                <span class="muted" style="text-align: center; padding: 8px 0;">{tr('scans.loading')}</span>
              </div>
            </div>
          </div>

          <p class="muted" style="font-size: 13px; margin-top: 18px; text-align: center;">
            {tr('scans.help')} <a class="link" href="/contact?source=history">{tr('cta.expert')}</a>
          </p>
        </div>
      </div>
    </main>
  </div>
</Layout>

<script>
  import { dateLocale, pageLang, t } from '../../../i18n/index.mjs';

  const tx = (key: string, vars?: Record<string, unknown>) => t(pageLang(), key, vars);

  function escapeHtml(s: unknown): string {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function formatDate(value: unknown): string {
    if (!value) return '—';
    const d = new Date(value as string);
    if (Number.isNaN(d.getTime())) return '—';
    return d.toLocaleString(dateLocale(pageLang()), { dateStyle: 'medium', timeStyle: 'short' });
  }

  function formatRunId(runId: string): string {
    return runId.replace(/Z-[0-9a-f]+$/, 'Z');
  }

  function statusTag(status: string): string {
    const s = String(status || '').toLowerCase();
    if (s === 'done' || s === 'completed') return '<span class="tag tag-success">' + escapeHtml(tx('acct.status.done')) + '</span>';
    if (s === 'running') return '<span class="tag tag-warning">' + escapeHtml(tx('acct.status.running')) + '</span>';
    if (s === 'pending' || s === 'queued') return '<span class="tag tag-warning">' + escapeHtml(tx('acct.status.queued')) + '</span>';
    if (s === 'error' || s === 'failed') return '<span class="tag tag-error">' + escapeHtml(tx('acct.status.error')) + '</span>';
    return '<span class="tag">' + escapeHtml(status || tx('scans.unknown')) + '</span>';
  }

  async function loadAudits() {
    // Looked up on every call: after a view transition the old elements are gone.
    const rowsEl = document.getElementById('rows');
    const msgEl = document.getElementById('audits-msg');
    if (!rowsEl) return;
    if (msgEl) msgEl.textContent = '';
    const abs = typeof globalThis.wcagApiUrl === 'function' ? (p) => globalThis.wcagApiUrl(p) : (p) => p;
    rowsEl.innerHTML =
      '<div class="list-row audits-row" style="grid-template-columns: 1fr;"><span class="muted" style="text-align: center; padding: 8px 0;">' + escapeHtml(tx('acct.loading')) + '</span></div>';
    try {
      const res = await fetch(
        typeof globalThis.wcagApiUrl === 'function' ? globalThis.wcagApiUrl('/api/audits') : '/api/audits',
        { credentials: typeof globalThis.wcagFetchCredentials === 'function' ? globalThis.wcagFetchCredentials() : 'same-origin' }
      );
      const data = await res.json().catch(() => ({}));
      if (res.status === 401) {
        document.dispatchEvent(new CustomEvent('wcag:login-required'));
        if (msgEl) {
          msgEl.textContent = tx('scans.signIn');
          msgEl.removeAttribute('lang');
        }
        rowsEl.innerHTML =
          '<div class="list-row audits-row" style="grid-template-columns: 1fr;"><span class="muted" style="text-align: center; padding: 8px 0;">' + escapeHtml(tx('scans.signIn')) + '</span></div>';
        return;
      }
      if (!res.ok) {
        const serverError = (data as { error?: string }).error;
        if (msgEl) {
          msgEl.textContent = serverError || tx('scans.failed');
          // Server messages are English for now.
          if (serverError && pageLang() !== 'en') msgEl.setAttribute('lang', 'en');
          else msgEl.removeAttribute('lang');
        }
        rowsEl.innerHTML = '';
        return;
      }
      const audits = (data.audits || []) as Array<{
        id: string;
        domain?: string;
        latestRunId?: string;
        status: string;
        pages?: number;
        issues?: number;
        totalRuns?: number;
        updatedAt?: string | null;
      }>;
      if (!audits.length) {
        rowsEl.innerHTML =
          '<div class="list-row audits-row" style="grid-template-columns: 1fr;"><span class="muted" style="text-align: center; padding: 8px 0;">' + escapeHtml(tx('scans.empty')) + '</span></div>';
        return;
      }
      rowsEl.innerHTML = audits
        .map((a) => {
          const domain = a.domain || a.id;
          const latestRunId = a.latestRunId || '';
          const reportHref = latestRunId
            ? abs(`/report/${encodeURIComponent(domain)}/${encodeURIComponent(latestRunId)}/`)
            : abs(`/report/${encodeURIComponent(domain)}/`);
          const historyHref = abs(`/report/${encodeURIComponent(domain)}/history`);
          const totalRuns = Number(a.totalRuns || 1);
          return `<div class="list-row audits-row">
            <a class="link" style="font-weight: 500; text-decoration: none; color: var(--fg-1);" href="${historyHref}">
              <strong>${escapeHtml(domain)}</strong>
            </a>
            <span class="mono" style="font-size: 12px;">${escapeHtml(latestRunId ? formatRunId(latestRunId) : '—')}</span>
            <span>${statusTag(a.status)}</span>
            <span class="muted mono" style="font-size: 12px;">${Number(a.pages || 0)}</span>
            <span class="tag tag-error">${Number(a.issues || 0)}</span>
            <span style="font-weight: 600; font-variant-numeric: tabular-nums;">${totalRuns}</span>
            <span class="muted" style="font-size: 12px;">${escapeHtml(formatDate(a.updatedAt))}</span>
            <span style="display: flex; gap: 6px; justify-content: flex-end;">
              <a class="btn btn-cream btn-sm" href="${reportHref}">${escapeHtml(tx('scans.open'))}</a>
              <a class="btn btn-secondary btn-sm" href="${historyHref}">${escapeHtml(tx('scans.history', { n: totalRuns }))}</a>
            </span>
          </div>`;
        })
        .join('');
    } catch {
      if (msgEl) {
        msgEl.textContent = tx('home.error.network');
        msgEl.removeAttribute('lang');
      }
      rowsEl.innerHTML = '';
    }
  }

  // Bound once on the document: this page is also reached by view transition,
  // where DOMContentLoaded has long since fired and the old button is detached.
  if (!globalThis.__wcagAuditsBound) {
    globalThis.__wcagAuditsBound = true;
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest('#refresh-audits')) loadAudits();
    });
    document.addEventListener('astro:page-load', () => loadAudits());
    document.addEventListener('wcag:logged-in', () => loadAudits());
  }
</script>

<style>
  .audits-head {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    align-items: flex-end;
    margin-bottom: 28px;
  }
  .audits-title {
    font-size: clamp(36px, 4.5vw, 56px);
    margin-top: 12px;
    margin-bottom: 10px;
  }
  .audits-row {
    grid-template-columns: 1.4fr 1fr 100px 80px 90px 70px 1.2fr 220px;
    align-items: center;
    gap: 12px;
  }
  .audits-row.head {
    background: var(--us-n-20);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-3);
    font-weight: 600;
  }
  .audits-row + .audits-row {
    border-top: 1px solid var(--border-subtle);
  }
  @media (max-width: 980px) {
    .audits-head { grid-template-columns: 1fr; }
    .audits-row { grid-template-columns: 1fr; }
    .audits-row.head { display: none; }
    .audits-row .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
