---
import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/AppHeader.astro';

const cookieHeader = Astro.request.headers.get('cookie') || '';
const ssrStaff = /(?:^|;\s*)wcag_ui=1(?:;|$)/.test(cookieHeader) || /(?:^|;\s*)wcag_access=1(?:;|$)/.test(cookieHeader);
const ssrCustomer = /(?:^|;\s*)wcag_ui=c(?:;|$)/.test(cookieHeader);
const ssrSignedIn = ssrStaff || ssrCustomer;

export const prerender = false;
---
<Layout title="Run a free accessibility check · Us" indexable={true} authMode="guest-ok">
  <div class="app-shell">
    <AppHeader />
    <main class="app-main">
      <div class="container-narrow run-audit-page" style="position: relative; padding: clamp(32px, 5vw, 56px) 0 clamp(48px, 8vw, 96px);">
        <div
          aria-hidden="true"
          style="position: absolute; top: -120px; right: -100px; width: 460px; height: 460px; border-radius: 50%; background: var(--us-grad-iridescent); opacity: 0.5; filter: blur(40px); pointer-events: none; animation: drift 22s ease-in-out infinite;"
        >
        </div>
        <div class="fade-up guest-only" hidden={ssrSignedIn} style="text-align: left; margin-bottom: 40px;">
          <span class="eyebrow"><span class="dot"></span>Free snapshot · 1 page · automated WCAG 2.2 AA checks</span>
          <h1 class="run-hero-title">
            Run a free accessibility check on your page
          </h1>
          <p class="p-large muted" style="max-width: 620px;">
            Enter a public URL. One free snapshot per person — guests and new accounts share that same free scan.
            This is not a full audit or legal sign-off.
          </p>
        </div>

        <form
          id="guest-run-form"
          class="card guest-only"
          method="post"
          action="/api/run"
          data-astro-reload
          hidden={ssrSignedIn}
          style="padding: 0; overflow: hidden;"
        >
          <div style="padding: 32px 32px 28px;">
            <label class="field-label" for="guest-url">Page URL</label>
            <input
              id="guest-url"
              name="url"
              class="input"
              type="url"
              inputmode="url"
              autocomplete="url"
              placeholder="https://example.com"
              required
            />
            <p class="muted" style="font-size: 13px; margin-top: 12px;">
              One free snapshot per visitor. By starting a scan you confirm you are allowed to request this URL.
            </p>
            <div id="guest-turnstile" style="margin-top: 18px;"></div>
          </div>
          <div
            style="background: var(--us-ink); color: var(--us-cream); padding: 24px 32px; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap;"
          >
            <div>
              <div style="font-family: var(--font-display); font-size: 20px; font-weight: 700; letter-spacing: -0.01em;">
                Scan one page for free
              </div>
              <div style="opacity: 0.7; font-size: 13px; margin-top: 4px;">No account. Results as soon as the scan is complete.</div>
            </div>
            <button type="submit" class="btn btn-grad btn-lg" style="min-width: 200px;" id="guest-submit-btn">
              Scan this page for free
            </button>
          </div>
        </form>

        <p class="muted guest-only" hidden={ssrSignedIn} style="font-size: 13px; margin-top: 16px; text-align: center;">
          <a class="link" href="/pricing">Buy tokens or subscribe to Pro</a>
          ·
          <a class="link" href="https://about-us.be/contact/">Talk to a WCAG expert</a>
          ·
          <a class="link" href="/signup">Create an account</a>
        </p>

        <div class="fade-up customer-only" hidden={!ssrCustomer} style="text-align: left; margin-bottom: 40px;">
          <span class="eyebrow"><span class="dot"></span>Your account · Pro pages or tokens</span>
          <h1 class="run-hero-title">Scan pages into your account</h1>
            <p class="p-large muted" style="max-width: 620px;">
            Signed-in scans use your complimentary token first (if unused), then Pro’s monthly page budget, then paid tokens. Each URL is one page-scan. Up to 50 URLs per run.
          </p>
          <p id="customer-usage" class="muted" style="max-width: 620px; margin-top: 8px;"></p>
          <p class="muted" style="font-size: 13px; margin-top: 8px;">
            <a class="link" href="/pricing">Pricing</a>
            ·
            <a class="link" href="/account">Buy extra tokens</a>
            ·
            <a class="link" href="https://about-us.be/contact/">Request Us services</a>
          </p>
        </div>

        <form
          id="customer-run-form"
          class="card customer-only"
          method="post"
          action="/api/run"
          data-astro-reload
          hidden={!ssrCustomer}
          style="padding: 0; overflow: hidden;"
        >
          <div style="padding: 32px 32px 28px;">
            <label class="field-label" for="customer-url">Page URLs</label>
            <textarea
              id="customer-url"
              name="urls"
              class="textarea"
              placeholder="https://example.com"
              required
              style="min-height: 96px;"
            ></textarea>
            <p class="muted" style="font-size: 13px; margin-top: 12px;">
              One public URL per line, same domain. Pro includes 300 pages/month; extra pages spend tokens.
            </p>
            <input type="hidden" name="csrfToken" class="wcag-csrf-field" value="" />
          </div>
          <div
            style="background: var(--us-ink); color: var(--us-cream); padding: 24px 32px; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap;"
          >
            <div>
              <div style="font-family: var(--font-display); font-size: 20px; font-weight: 700; letter-spacing: -0.01em;">
                Save this page to your account
              </div>
              <div style="opacity: 0.7; font-size: 13px; margin-top: 4px;">Full report, keyed to your email and this domain.</div>
            </div>
            <button type="submit" class="btn btn-grad btn-lg" style="min-width: 200px;" id="customer-submit-btn">
              Scan this page
            </button>
          </div>
        </form>

        <p class="muted customer-only" hidden={!ssrCustomer} style="font-size: 12px; margin-top: 14px; text-align: center;">
          <a href="/account" class="link">Account</a>
          ·
          <a href="/pricing" class="link">Pricing</a>
          ·
          <a href="/audits" class="link">Your projects</a>
        </p>

        <div class="fade-up staff-only" hidden={!ssrStaff} style="text-align: left; margin-bottom: 40px;">
          <span class="eyebrow"><span class="dot"></span>Automated WCAG 2.2 AA checks · EN 301 549 informed</span>
          <h1 class="run-hero-title">
            Scan your website for accessibility
          </h1>
          <p class="p-large muted" style="max-width: 620px;">
            Add URLs or a sitemap. We scan the pages and deliver HTML reports with scores and issues.
            Results are automated findings, not a conformance certificate.
          </p>
        </div>

        <form
          id="run-form"
          class="card staff-only"
          method="post"
          action="/api/run"
          data-astro-reload
          hidden={!ssrStaff}
          style="padding: 0; overflow: hidden;"
        >
          <input type="hidden" name="csrfToken" class="wcag-csrf-field" value="" />
          <div style="padding: 32px 32px 36px;">
            <div style="display: flex; align-items: baseline; gap: 14px; margin-bottom: 6px;">
              <span style="font-family: var(--font-mono); font-size: 12px; color: var(--fg-3); letter-spacing: 0.04em;"
                >01</span
              >
              <h2 style="font-size: 24px; font-weight: 700; letter-spacing: -0.01em;">What should we scan?</h2>
            </div>
            <p class="muted" style="font-size: 14px; margin-bottom: 22px; margin-left: 32px;">
              Paste URLs (one domain per run) or upload CSV / XML.
            </p>
            <div style="margin-left: 32px;">
              <div class="field">
                <label class="field-label" for="urls">URLs to scan</label>
                <textarea
                  id="urls"
                  name="urls"
                  class="textarea"
                  placeholder="https://example.com&#10;https://example.com/about"
                  style="min-height: 168px;"
                ></textarea>
                <div id="url-hint" class="field-hint">0 URLs · one per line or comma-separated in text</div>
              </div>
              <div class="field" style="margin-top: 20px;">
                <label class="field-label" for="file">Optional file (CSV, XML sitemap, or .txt)</label>
                <div class="file-field">
                  <input id="file" name="file" type="file" class="file-input-native" accept=".csv,.xml,.txt" />
                  <label class="file-input-ui" for="file">
                    <span class="file-input-btn">Select a file</span>
                    <span class="file-input-name" id="file-name">No file selected</span>
                  </label>
                </div>
              </div>
            </div>
          </div>

          <hr class="hr" style="margin: 0;" />

          <details class="statement-details" style="margin: 0; border: 0; border-radius: 0; border-top: 1px solid var(--border-subtle);">
            <summary style="padding: 20px 32px;" title="Show optional statement fields">
              <span class="statement-summary-icon" aria-hidden="true"></span>
              Accessibility statement fields (optional)
            </summary>
            <div class="statement-inner" style="padding: 0 32px 28px 56px;">
              <p class="statement-note">
                Used to pre-fill the generated accessibility statement. All optional.
              </p>
              <div class="statement-fields-grid">
                <div class="field">
                  <label class="field-label" for="statement_org_name">Organization</label>
                  <input class="input" id="statement_org_name" name="statement_org_name" type="text" />
                </div>
                <div class="field">
                  <label class="field-label" for="statement_org_short">Short name</label>
                  <input class="input" id="statement_org_short" name="statement_org_short" type="text" />
                </div>
                <div class="field">
                  <label class="field-label" for="statement_phone">Phone</label>
                  <input class="input" id="statement_phone" name="statement_phone" type="tel" />
                </div>
                <div class="field">
                  <label class="field-label" for="statement_email">Contact email</label>
                  <input class="input" id="statement_email" name="statement_email" type="email" />
                </div>
                <div class="field" style="grid-column: span 2;">
                  <label class="field-label" for="statement_visitor_address">Visitor address</label>
                  <input class="input" id="statement_visitor_address" name="statement_visitor_address" type="text" />
                </div>
                <div class="field" style="grid-column: span 2;">
                  <label class="field-label" for="statement_postal_address">Postal address</label>
                  <input class="input" id="statement_postal_address" name="statement_postal_address" type="text" />
                </div>
                <div class="field">
                  <label class="field-label" for="statement_response_days">Response days</label>
                  <input class="input" id="statement_response_days" name="statement_response_days" type="number" min="1" max="365" value="3" />
                </div>
              </div>
            </div>
          </details>

          <hr class="hr" style="margin: 0;" />

          <div style="padding: 32px 32px 36px;">
            <div style="display: flex; align-items: baseline; gap: 14px; margin-bottom: 6px;">
              <span style="font-family: var(--font-mono); font-size: 12px; color: var(--fg-3); letter-spacing: 0.04em;"
                >02</span
              >
              <h2 style="font-size: 24px; font-weight: 700; letter-spacing: -0.01em;">Notify me</h2>
            </div>
            <div style="margin-left: 32px; display: grid; gap: 16px;">
              <div class="field">
                <label class="field-label" for="notify_email">Email for notification</label>
                <input class="input" id="notify_email" name="notify_email" type="email" autocomplete="email" />
              </div>
              <label class="check">
                <input type="checkbox" name="notify_on_complete" value="1" id="notify_on_complete" />
                <span class="box"></span>
                <span>Email me when the audit finishes</span>
              </label>
            </div>
          </div>

          <div
            style="background: var(--us-ink); color: var(--us-cream); padding: 28px 32px; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap;"
          >
            <div>
              <div style="font-family: var(--font-display); font-size: 22px; font-weight: 700; letter-spacing: -0.01em;">
                Ready to run
              </div>
              <div style="opacity: 0.7; font-size: 13px; margin-top: 4px;" id="run-summary">Add at least one URL</div>
            </div>
            <button type="submit" class="btn btn-grad btn-lg" style="min-width: 220px;" id="submit-btn">
              Start audit
            </button>
          </div>
        </form>

        <p id="form-err" class="muted" style="font-size: 14px; margin-top: 14px; color: var(--status-error); display: none;"></p>

        <p class="muted" style="font-size: 12px; margin-top: 14px; text-align: center;">
          <a href="/limitations" class="link">What this scan can and cannot test</a>
        </p>

        <p class="muted staff-only" hidden={!ssrStaff} style="font-size: 12px; margin-top: 14px; text-align: center;">
          <a href="/audits" class="link">All domain audits</a>
          ·
          <a href="/admin/leads" class="link">Leads</a>
        </p>
      </div>
    </main>
  </div>
</Layout>

<script>
  function wcUrl(path) {
    return typeof globalThis.wcagApiUrl === 'function' ? globalThis.wcagApiUrl(path) : path;
  }
  function wcCreds() {
    return typeof globalThis.wcagFetchCredentials === 'function' ? globalThis.wcagFetchCredentials() : 'same-origin';
  }
  function wcHeaders(extra) {
    return typeof globalThis.wcagHeaders === 'function' ? globalThis.wcagHeaders(extra) : extra || {};
  }
  function csrfToken() {
    return typeof globalThis.wcagCsrfToken === 'function' ? globalThis.wcagCsrfToken() : '';
  }

  function applyRole(role) {
    const staff = role === 'staff';
    const customer = role === 'customer';
    document.querySelectorAll('.staff-only').forEach((el) => {
      el.hidden = !staff;
    });
    document.querySelectorAll('.customer-only').forEach((el) => {
      el.hidden = !customer;
    });
    document.querySelectorAll('.guest-only').forEach((el) => {
      el.hidden = staff || customer;
    });
  }

  async function parseJsonResponse(res) {
    const ct = (res.headers.get('content-type') || '').toLowerCase();
    if (ct.includes('application/json')) {
      return res.json().catch(() => ({}));
    }
    const raw = await res.text().catch(() => '');
    if (raw && raw.trim().startsWith('{')) {
      try {
        return JSON.parse(raw);
      } catch {
        return {};
      }
    }
    return {};
  }

  function formErrorEl() {
    return document.getElementById('form-err');
  }

  function showFormError(message, ctas) {
    const errEl = formErrorEl();
    if (!errEl) return;
    errEl.replaceChildren();
    errEl.append(document.createTextNode(message || 'Request failed'));
    if (ctas && (ctas.tokens || ctas.pro || ctas.services)) {
      errEl.append(document.createTextNode(' '));
      const links = [
        ctas.tokens ? ['Buy tokens', ctas.tokens] : null,
        ctas.pro ? ['Subscribe to Pro', ctas.pro] : null,
        ctas.services ? ['Request Us-diensten', ctas.services] : null,
      ].filter(Boolean);
      links.forEach((pair, index) => {
        if (index) errEl.append(document.createTextNode(' · '));
        const a = document.createElement('a');
        a.className = 'link';
        a.href = pair[1];
        a.textContent = pair[0];
        errEl.append(a);
      });
    }
    errEl.style.display = 'block';
  }

  function clearFormError() {
    const errEl = formErrorEl();
    if (!errEl) return;
    errEl.replaceChildren();
    errEl.style.display = 'none';
  }

  function countUrls() {
    const t = document.getElementById('urls')?.value || '';
    return t.split(/[\n,]+/).map((s) => s.trim()).filter((s) => s.startsWith('http')).length;
  }

  function refreshHint() {
    const n = countUrls();
    const hint = document.getElementById('url-hint');
    const summary = document.getElementById('run-summary');
    if (hint) hint.textContent = `${n} URL${n === 1 ? '' : 's'} · one per line`;
    if (summary) summary.textContent = n ? `${n} URL(s) queued` : 'Add at least one URL';
  }

  function goToRun(data, { guestFallback = false } = {}) {
    if (guestFallback && data.guestToken) {
      window.location.href = wcUrl(`/loading?token=${encodeURIComponent(data.guestToken)}`);
      return true;
    }
    const domain = data.domain || data.id || data.reportId;
    const runId = data.runId;
    if (domain && runId) {
      window.location.href = wcUrl(`/loading?domain=${encodeURIComponent(domain)}&runId=${encodeURIComponent(runId)}`);
      return true;
    }
    if (domain) {
      window.location.href = wcUrl(`/report/${encodeURIComponent(domain)}/`);
      return true;
    }
    return false;
  }

  function prefillUrlFromQuery() {
    let url = '';
    try {
      url = String(new URLSearchParams(window.location.search).get('url') || '').trim();
    } catch {
      return;
    }
    if (!url) return;
    const guest = document.getElementById('guest-url');
    const customer = document.getElementById('customer-url');
    const urls = document.getElementById('urls');
    if (guest instanceof HTMLInputElement && !guest.value) guest.value = url;
    if (customer instanceof HTMLTextAreaElement && !customer.value) customer.value = url;
    if (customer instanceof HTMLInputElement && !customer.value) customer.value = url;
    if (urls instanceof HTMLTextAreaElement && !urls.value) urls.value = url;
    refreshHint();
  }

  function syncCsrfFields() {
    const token = csrfToken();
    document.querySelectorAll('.wcag-csrf-field').forEach((el) => {
      if (el instanceof HTMLInputElement) el.value = token;
    });
  }

  async function fillCustomerUsage() {
    const el = document.getElementById('customer-usage');
    if (!el) return;
    try {
      const res = await fetch(wcUrl('/api/account/usage'), { credentials: wcCreds(), headers: wcHeaders() });
      if (!res.ok) {
        el.textContent = '';
        return;
      }
      const data = await res.json().catch(() => ({}));
      const used = Number(data.pagesScanned || data.scansUsed || 0);
      const tokensLeft = Number(data.tokens?.tokens || 0);
      const isPro = data.plan?.id === 'pro' && ['active', 'trialing', 'past_due'].includes(data.subscription?.status);
      if (isPro) {
        el.textContent = `Pro · ${used}/300 pages this month · ${tokensLeft} token${tokensLeft === 1 ? '' : 's'}`;
      } else if (tokensLeft > 0) {
        el.textContent = `No Pro · ${tokensLeft} token${tokensLeft === 1 ? '' : 's'} left`;
      } else {
        el.textContent = 'No Pro · 0 tokens — buy a pack, subscribe, or request Us services.';
      }
    } catch {
      el.textContent = '';
    }
  }

  async function refreshMode() {
    try {
      const res = await fetch(wcUrl('/api/auth/status'), { credentials: wcCreds() });
      const data = await res.json().catch(() => ({}));
      const signedIn = data.authEnabled === true && data.authenticated === true;
      applyRole(signedIn ? data.role || 'staff' : 'guest');
      if (data.role === 'customer') await fillCustomerUsage();
    } catch {
      applyRole('guest');
    }
  }

  let turnstileWidgetId = null;
  async function maybeLoadTurnstile() {
    try {
      const res = await fetch(wcUrl('/api/config'), { credentials: wcCreds() });
      const data = await res.json().catch(() => ({}));
      const siteKey = data.turnstileSiteKey;
      if (!siteKey) return;
      const mount = document.getElementById('guest-turnstile');
      if (!mount) return;
      await new Promise((resolve, reject) => {
        if (window.turnstile) {
          resolve();
          return;
        }
        const s = document.createElement('script');
        s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
        s.async = true;
        s.onload = () => resolve();
        s.onerror = () => reject(new Error('captcha'));
        document.head.appendChild(s);
      });
      if (window.turnstile) {
        if (turnstileWidgetId != null) {
          try {
            window.turnstile.remove(turnstileWidgetId);
          } catch {
            /* widget already gone after a ClientRouter swap */
          }
          turnstileWidgetId = null;
        }
        turnstileWidgetId = window.turnstile.render(mount, { sitekey: siteKey });
      }
    } catch {
      /* captcha optional when the server has no secret */
    }
  }

  function bindPageUi() {
    const urlsEl = document.getElementById('urls');
    if (urlsEl) urlsEl.oninput = refreshHint;
    const fileEl = document.getElementById('file');
    const fileNameEl = document.getElementById('file-name');
    if (fileEl) {
      fileEl.onchange = () => {
        if (!fileNameEl) return;
        const file = fileEl.files && fileEl.files[0];
        fileNameEl.textContent = file ? file.name : 'No file selected';
      };
    }
    syncCsrfFields();
    prefillUrlFromQuery();
    refreshHint();
    refreshMode();
    maybeLoadTurnstile();
  }

  async function submitStaffForm(form) {
    clearFormError();
    const fd = new FormData(form);
    const token = csrfToken();
    if (token) fd.set('csrfToken', token);
    try {
      const res = await fetch(wcUrl('/api/run'), {
        method: 'POST',
        body: fd,
        credentials: wcCreds(),
        headers: wcHeaders(),
      });
      const data = await parseJsonResponse(res);
      if (res.status === 401) {
        document.dispatchEvent(new CustomEvent('wcag:login-required'));
        showFormError(data.error || 'Sign in to run an audit.');
        return;
      }
      if (!res.ok) {
        if (res.status === 403) {
          showFormError(
            data.error ||
              'The server refused this request (403). If the response body mentions cross-site POST, you may be hitting Astro’s standalone listener: ensure `cd web && npm start` (run-server.mjs sets ASTRO_NODE_AUTOSTART), or open http://127.0.0.1:PORT instead of localhost. Otherwise: run the API on 3456, use the full stack build, and set PUBLIC_DEV_API_URL + RELAX_CORS_LOCALHOST for astro dev, or fix PUBLIC_APP_BASE.'
          );
        } else {
          showFormError(data.error || res.statusText || 'Request failed');
        }
        return;
      }
      if (!goToRun(data)) showFormError('Could not start the audit.');
    } catch {
      showFormError('Network error — is the API running? For dev, start legacy server on port 3456.');
    }
  }

  async function submitGuestForm(form) {
    clearFormError();
    const url = String(new FormData(form).get('url') || '').trim();
    const fd = new FormData();
    fd.set('url', url);
    const csrf = csrfToken();
    if (csrf) fd.set('csrfToken', csrf);
    if (window.turnstile && turnstileWidgetId != null) {
      const token = window.turnstile.getResponse(turnstileWidgetId);
      if (token) fd.set('turnstileToken', token);
    }
    const btn = document.getElementById('guest-submit-btn');
    if (btn) btn.disabled = true;
    try {
      const res = await fetch(wcUrl('/api/run'), {
        method: 'POST',
        body: fd,
        credentials: wcCreds(),
        headers: wcHeaders(),
      });
      const data = await parseJsonResponse(res);
      if (!res.ok) {
        showFormError(data.error || res.statusText || 'Request failed', data.ctas);
        if (window.turnstile && turnstileWidgetId != null) window.turnstile.reset(turnstileWidgetId);
        return;
      }
      if (!goToRun(data, { guestFallback: true })) showFormError('Could not start the free scan.');
    } catch {
      showFormError('Network error — is the API running?');
    } finally {
      if (btn) btn.disabled = false;
    }
  }

  async function submitCustomerForm(form) {
    clearFormError();
    const posted = new FormData(form);
    const urls = String(posted.get('urls') || posted.get('url') || '').trim();
    const fd = new FormData();
    fd.set('urls', urls);
    const token = csrfToken();
    if (token) fd.set('csrfToken', token);
    const btn = document.getElementById('customer-submit-btn');
    if (btn) btn.disabled = true;
    try {
      const res = await fetch(wcUrl('/api/run'), {
        method: 'POST',
        body: fd,
        credentials: wcCreds(),
        headers: wcHeaders(),
      });
      const data = await parseJsonResponse(res);
      if (res.status === 401) {
        document.dispatchEvent(new CustomEvent('wcag:login-required'));
        showFormError(data.error || 'Sign in to run a scan.');
        return;
      }
      if (!res.ok) {
        showFormError(data.error || res.statusText || 'Request failed', data.ctas);
        return;
      }
      if (!goToRun(data, { guestFallback: true })) showFormError('Could not start the scan.');
    } catch {
      showFormError('Network error — is the API running?');
    } finally {
      if (btn) btn.disabled = false;
    }
  }

  if (!globalThis.__wcagHomeScanBound) {
    globalThis.__wcagHomeScanBound = true;
    // Capture-phase delegation survives Astro ClientRouter swaps; GET forms otherwise
    // navigate to /?url=... instead of starting a scan.
    document.addEventListener(
      'submit',
      (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement)) return;
        if (form.id === 'run-form') {
          event.preventDefault();
          event.stopPropagation();
          submitStaffForm(form);
          return;
        }
        if (form.id === 'guest-run-form') {
          event.preventDefault();
          event.stopPropagation();
          submitGuestForm(form);
          return;
        }
        if (form.id === 'customer-run-form') {
          event.preventDefault();
          event.stopPropagation();
          submitCustomerForm(form);
        }
      },
      true
    );
    document.addEventListener('astro:page-load', bindPageUi);
    document.addEventListener('wcag:logged-in', (event) => {
      applyRole(event.detail?.role || 'staff');
      syncCsrfFields();
      if (event.detail?.role === 'customer') fillCustomerUsage();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindPageUi);
  } else {
    bindPageUi();
  }
</script>

