---
import Layout from '../../../../layouts/Layout.astro';
import AppHeader from '../../../../components/AppHeader.astro';
import ScoreDonut from '../../../../components/ScoreDonut.svelte';
import ScanFailedPanel from '../../../../components/ScanFailedPanel.astro';
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { buildAstroMainReportPayload } from '../../../../../../report-astro-payload.js';
import { isValidReportId } from '../../../../../../server/fs-utils.js';
import { runDir, isValidRunId } from '../../../../../../server/run-ids.js';
import { usePageLang } from '../../../../lib/page-lang.js';
import { normalizeLang, translator } from '../../../../../../i18n/index.mjs';
import { statementFileName } from '../../../../../../statement-files.js';

export const prerender = false;
// The page around the statement follows the visitor's language.
const tr = usePageLang(Astro);
// The statement itself is a document the customer publishes: its language is
// chosen on this page (?doc=nl|en), Dutch unless English is asked for.
const docLang = normalizeLang(Astro.url.searchParams.get('doc')) || 'nl';
const doc = translator(docLang);
// The statement sits in a page of another language: say so.
const docLangAttr = docLang === tr.lang ? undefined : docLang;
// Rule names in the findings list are in the language the scan ran in.
const findingAttr = (textLang: string | undefined) => {
  const of = textLang || 'en';
  return of === docLang ? undefined : of;
};

const rawDomain = Astro.params.domain ?? '';
const rawRunId = Astro.params.runId ?? '';
const domain = typeof rawDomain === 'string' ? rawDomain : String(rawDomain);
const runId = typeof rawRunId === 'string' ? rawRunId : String(rawRunId);

if (!isValidReportId(domain) || !isValidRunId(runId)) {
  return new Response('Invalid run id', { status: 400 });
}

const reportDir = runDir(domain, runId);
const resultsPath = join(reportDir, 'accessibility-results.json');
if (!existsSync(resultsPath)) {
  return new Response(tr('report.notFound.title'), { status: 404, headers: { 'Content-Type': 'text/plain; charset=utf-8' } });
}

const json = JSON.parse(readFileSync(resultsPath, 'utf8'));
// Dates in the statement are written in the statement's language.
const payload = buildAstroMainReportPayload(json, { lang: docLang });
const pagesLoaded = payload.pagesLoaded === true;

const statementMetaPath = join(reportDir, 'statement-meta.json');
let statementMeta: any = {};
try {
  if (existsSync(statementMetaPath)) {
    statementMeta = JSON.parse(readFileSync(statementMetaPath, 'utf8'));
  }
} catch {}

const company = statementMeta.organizationShortName || statementMeta.organizationName || payload.primaryHost;
const legal = statementMeta.organizationName || company;
const website = statementMeta.website || `https://${payload.primaryHost}`;
const coordinator = statementMeta.contactName || statementMeta.coordinator || doc('stmt.coordinatorDefault');
const email = statementMeta.contactEmail || statementMeta.email || `accessibility@${payload.primaryHost}`;
const phone = statementMeta.phone || '';
const visitorAddress = statementMeta.visitorAddress || statementMeta.address || '';
const postalAddress = statementMeta.postalAddress || '';
const responseDays = Number(statementMeta.responseDays || 5);
const lastAudit = statementMeta.lastAuditDate || '';
const auditDate = payload.auditedDate || new Date().toISOString().slice(0, 10);

const errorIssues = (payload.fixOrderItems || []).filter((i) => i.status === 'fail' || i.status === 'violation' || i.type === 'violation');

function nextYear(value: string): string {
  const d = json.generatedAt ? new Date(json.generatedAt) : new Date(value);
  if (Number.isNaN(d.getTime())) return '';
  d.setFullYear(d.getFullYear() + 1);
  return d.toISOString().slice(0, 10);
}
const reviewDate = nextYear(auditDate);

const base = `/report/${encodeURIComponent(domain)}/${encodeURIComponent(runId)}`;
// The HTML file in the chosen language. Scans from before it existed only have
// the English file, under the plain name.
const docFileExists = existsSync(join(reportDir, statementFileName(docLang)));
const htmlFile = docFileExists ? statementFileName(docLang) : 'accessibility-statement.html';
const htmlLang = docFileExists ? docLang : 'en';
const docLangs = [
  { code: 'nl', label: 'Nederlands' },
  { code: 'en', label: 'English' },
];
---

<Layout title={tr('stmtui.title', { company })} description={tr('stmtui.description', { company })}>
  <div class="app-shell">
    <AppHeader domain={domain} runId={runId} active="statement" />
    <main id="main" class="app-main" tabindex="-1">
      {!pagesLoaded ? (
        <ScanFailedPanel
          domain={domain}
          runId={runId}
          primaryHost={payload.primaryHost || domain}
          loadFailures={payload.loadFailures || []}
          title={tr('stmtui.notReady')}
          lang={tr.lang}
        />
      ) : (
      <div data-screen-label="05 Accessibility statement" style="background: var(--us-cream); min-height: calc(100dvh - 65px); min-height: calc(100vh - 65px);">
        <div class="container-narrow statement-page-inner">
          <div class="statement-toolbar">
            <div style="display: flex; flex-direction: column; gap: 6px;">
              <a class="btn btn-ghost btn-sm" href={`${base}/`} style="align-self: flex-start;">{tr('cov.back')}</a>
              <span class="eyebrow"><span class="dot"></span>{tr('stmtui.draft')}</span>
            </div>
            <div style="display: flex; flex-direction: column; gap: 8px; align-items: flex-end;">
              <nav class="statement-langs" aria-label={tr('stmtui.langLabel')}>
                <span class="muted" style="font-size: 13px;">{tr('stmtui.langLabel')}:</span>
                {docLangs.map((option) => (
                  <a
                    class={`btn btn-sm ${option.code === docLang ? 'btn-primary' : 'btn-ghost'}`}
                    href={`${base}/statement?doc=${option.code}`}
                    hreflang={option.code}
                    lang={option.code === tr.lang ? undefined : option.code}
                    aria-current={option.code === docLang ? 'page' : undefined}
                    data-astro-prefetch="false"
                  >{option.label}</a>
                ))}
              </nav>
              <div style="display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end;">
                <a class="btn btn-secondary btn-sm" href={`${base}/${htmlFile}`} hreflang={htmlLang}>{tr('stmtui.openHtml')}{htmlLang !== docLang ? ` ${tr('stmtui.htmlEnglish')}` : ''}</a>
                <a class="btn btn-primary btn-sm" href={`${base}/${htmlFile}`} hreflang={htmlLang} download>{tr('stmtui.download')}{htmlLang !== docLang ? ` ${tr('stmtui.htmlEnglish')}` : ''}</a>
              </div>
              {htmlLang !== docLang ? <p class="muted" style="font-size: 12px; margin: 0;">{tr('stmtui.htmlOlder')}</p> : null}
            </div>
          </div>

          <article class="statement-doc" lang={docLangAttr}>
            <header style="border-bottom: 1px solid var(--border-subtle); padding-bottom: 28px; margin-bottom: 32px;">
              <div class="muted" style="font-size: 13px; margin-bottom: 8px;">{doc('stmt.kicker')}</div>
              <h1 class="statement-h1">{company}</h1>
              <div style="display: flex; gap: 18px; font-size: 14px; color: var(--fg-2); flex-wrap: wrap;">
                <span>{doc('stmt.updated')} <strong>{auditDate}</strong></span>
                <span>·</span>
                <span>{legal}</span>
                <span>·</span>
                <a class="link" href={website}>{website}</a>
              </div>
            </header>

            <section style="margin-bottom: 28px;">
              <h2 class="statement-h2">{doc('stmt.h.commitment')}</h2>
              <p>
                {doc('stmt.commitment.aims', { legal })}
                {doc('stmt.commitment.standard')}
                <strong>{doc('stmt.commitment.draft')}</strong>
              </p>
            </section>

            <section style="margin-bottom: 28px;">
              <h2 class="statement-h2">{doc('stmt.h.status')}</h2>
              <div class="conformance-row">
                <ScoreDonut score={payload.scoreClamp} size={84} stroke={8} showLabel={false} />
                <div>
                  <div style="font-family: var(--font-display); font-weight: 700; font-size: 22px; margin-bottom: 2px;">{doc('stmt.conformance')}</div>
                  <div style="font-size: 14px; color: var(--fg-2);">{doc('stmt.errorsScore', { score: payload.scoreClamp })}</div>
                </div>
              </div>
              <p>{doc('stmt.statusNote')}</p>
            </section>

            <section style="margin-bottom: 28px;">
              <h2 class="statement-h2">{doc('stmt.h.nonAccessible')}</h2>
              {errorIssues.length === 0 ? (
                <p class="muted">{doc('stmt.noErrors')}</p>
              ) : (
                <Fragment>
                  <p style="margin-bottom: 12px;">{doc('stmt.findingsIntro')}</p>
                  <ol style="padding-left: 22px; display: flex; flex-direction: column; gap: 8px;">
                    {errorIssues.slice(0, 12).map((i) => (
                      <li style="font-size: 14px;" lang={findingAttr(i.textLang)}>
                        <strong>{i.rule || i.id}</strong>
                        {i.duplicateIdLabel ? ` — ${i.duplicateIdLabel}` : ''}
                        {i.wcag ? <Fragment> <span class="muted">(WCAG {i.wcag})</span></Fragment> : null}
                        {i.snippet ? ` — ${i.snippet}` : ''}
                      </li>
                    ))}
                  </ol>
                  {errorIssues.length > 12 && (
                    <p class="muted" style="margin-top: 8px; font-size: 13px;">{doc('stmt.more', { n: errorIssues.length - 12 })}</p>
                  )}
                </Fragment>
              )}
            </section>

            <section style="margin-bottom: 28px;">
              <h2 class="statement-h2">{doc('stmt.h.preparation')}</h2>
              <p>
                {doc.n('stmt.prep', payload.urls.length, { date: auditDate })}
                {reviewDate ? <Fragment> {doc('stmt.prep.review', { date: reviewDate })}</Fragment> : null}
              </p>
              {lastAudit && (
                <p>{doc('stmt.prep.previous', { date: lastAudit })}</p>
              )}
            </section>

            <section style="margin-bottom: 28px;">
              <h2 class="statement-h2">{doc('stmt.h.contact')}</h2>
              <p>{doc('stmt.contact.intro')}</p>
              <div class="contact-grid">
                <div>
                  <div class="kv-label">{doc('stmt.coordinatorDefault')}</div>
                  <div class="kv-value">{coordinator}</div>
                </div>
                <div>
                  <div class="kv-label">{doc('stmt.kv.email')}</div>
                  <div class="kv-value"><a class="link" href={`mailto:${email}`}>{email}</a></div>
                </div>
                {phone && (
                  <div>
                    <div class="kv-label">{doc('stmt.kv.phone')}</div>
                    <div class="kv-value">{phone}</div>
                  </div>
                )}
                {visitorAddress && (
                  <div>
                    <div class="kv-label">{doc('stmt.kv.visitor')}</div>
                    <div class="kv-value">{visitorAddress}</div>
                  </div>
                )}
                {postalAddress && (
                  <div>
                    <div class="kv-label">{doc('stmt.kv.postal')}</div>
                    <div class="kv-value">{postalAddress}</div>
                  </div>
                )}
                <div>
                  <div class="kv-label">{doc('stmt.kv.response')}</div>
                  <div class="kv-value">{doc.n('stmt.within', responseDays)}</div>
                </div>
              </div>
            </section>

            <section style="margin-bottom: 28px;">
              <h2 class="statement-h2">{doc('stmt.h.enforcement')}</h2>
              <p>{doc.n('stmt.enforcement', responseDays)}</p>
            </section>

            <footer style="margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: var(--fg-3); flex-wrap: wrap; gap: 8px;">
              <span class="mono">{doc('stmt.footer.generated', { id: `${domain}/${runId}` })}</span>
              <span style="display: flex; align-items: center; gap: 6px;">
                {doc('stmt.footer.with')} <img src="/assets/us-logo.png" width="83" height="40" alt="Us" style="height: 18px; width: auto; border-radius: 4px;" />
              </span>
            </footer>
          </article>

          <div class="statement-cta-row" style="margin-top: 32px; display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
            <a class="btn btn-secondary" href={`${base}/`}>{tr('stmtui.back')}</a>
            <a class="btn btn-primary" href={`${base}/accessibility-developers.html`}>{tr('stmtui.developer')}</a>
          </div>
        </div>
      </div>
      )}
    </main>
  </div>
</Layout>

<style>
  .statement-page-inner {
    padding: clamp(32px, 6vw, 56px) 0 clamp(48px, 8vw, 96px);
  }
  /* The two language buttons sit in a row with their label. */
  .statement-langs {
    display: flex;
    gap: 6px;
    align-items: center;
    flex-wrap: wrap;
  }
  .statement-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 16px;
  }
  .statement-h1 {
    font-size: clamp(28px, 5vw, 44px);
    margin-bottom: 14px;
  }
  @media (max-width: 560px) {
    .statement-toolbar .btn {
      width: 100%;
      justify-content: center;
    }
    .statement-cta-row .btn {
      width: 100%;
      justify-content: center;
    }
  }
  .statement-doc {
    background: var(--us-white);
    border-radius: var(--r-lg);
    padding: 56px 64px;
    box-shadow: var(--shadow-card);
    font-family: var(--font-body);
    font-weight: 300;
    line-height: 1.7;
    color: var(--fg-1);
  }
  @media (max-width: 720px) {
    .statement-doc {
      padding: 32px 24px;
    }
  }
  .statement-h2 {
    font-size: 22px;
    margin-bottom: 12px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .conformance-row {
    padding: 18px;
    background: var(--us-cream);
    border-radius: 12px;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 18px;
    align-items: center;
    margin: 12px 0;
  }
  @media (max-width: 480px) {
    .conformance-row {
      grid-template-columns: 1fr;
      justify-items: start;
    }
  }
  .contact-grid {
    padding: 20px;
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 12px;
    font-size: 14px;
  }
  @media (max-width: 540px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
  .kv-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-3);
    margin-bottom: 2px;
  }
  .kv-value {
    font-weight: 500;
  }
</style>
