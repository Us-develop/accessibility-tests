---
import Layout from '../../../../layouts/Layout.astro';
import AppHeader from '../../../../components/AppHeader.astro';
import WcagCoverage from '../../../../components/WcagCoverage.svelte';
import ScanFailedPanel from '../../../../components/ScanFailedPanel.astro';
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { isValidReportId } from '../../../../../../server/fs-utils.js';
import { runDir, isValidRunId } from '../../../../../../server/run-ids.js';
import { buildAstroMainReportPayload } from '../../../../../../report-astro-payload.js';

export const prerender = false;

const rawDomain = Astro.params.domain ?? '';
const rawRunId = Astro.params.runId ?? '';
const domain = typeof rawDomain === 'string' ? rawDomain : String(rawDomain);
const runId = typeof rawRunId === 'string' ? rawRunId : String(rawRunId);

if (!isValidReportId(domain) || !isValidRunId(runId)) {
  return new Response('Invalid run id', { status: 400 });
}

const resultsPath = join(runDir(domain, runId), 'accessibility-results.json');
if (!existsSync(resultsPath)) {
  return new Response('Report not found', { status: 404 });
}

const json = JSON.parse(readFileSync(resultsPath, 'utf8'));
const payload = buildAstroMainReportPayload(json);
const pagesLoaded = payload.pagesLoaded === true;
const primaryHost = payload.primaryHost || domain.replace(/^www\./, '');
---

<Layout title={`WCAG coverage · ${primaryHost}`} description={`WCAG 2.2 coverage matrix for ${primaryHost} from this automated run.`}>
  <div class="app-shell">
    <AppHeader domain={domain} runId={runId} active="coverage" />
    <main id="main" class="app-main" tabindex="-1">
      <div style="background: var(--us-cream); min-height: calc(100dvh - 65px);">
        {!pagesLoaded ? (
          <ScanFailedPanel
            domain={domain}
            runId={runId}
            primaryHost={primaryHost}
            loadFailures={payload.loadFailures || []}
            title="WCAG coverage is not ready"
          />
        ) : (
        <div class="container-narrow" style="padding: clamp(28px, 4vw, 48px) 0 80px;">
          <a class="btn btn-ghost btn-sm" href={`/report/${encodeURIComponent(domain)}/${encodeURIComponent(runId)}/`}>← Back to report</a>
          <span class="eyebrow" style="display: inline-flex; margin: 18px 0 8px;"><span class="dot"></span>WCAG 2.2 A + AA · {primaryHost}</span>
          <h1 style="font-size: clamp(28px, 4vw, 40px); margin: 0 0 10px;">What was checked — and what was not</h1>
          <p class="muted" style="max-width: 640px; margin-bottom: 28px;">
            The table is computed from this run. The written analysis uses Anthropic when an API key is configured; otherwise it uses the same matrix in plain language.
            Neither is an official WCAG or EAA audit.
          </p>
          <WcagCoverage client:load {domain} {runId} {primaryHost} />
        </div>
        )}
      </div>
    </main>
  </div>
</Layout>
