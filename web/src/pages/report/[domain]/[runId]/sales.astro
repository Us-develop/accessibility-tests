---
import Layout from '../../../../layouts/Layout.astro';
import AppHeader from '../../../../components/AppHeader.astro';
import SalesDeck from '../../../../components/SalesDeck.svelte';
import ScanFailedPanel from '../../../../components/ScanFailedPanel.astro';
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { buildAstroMainReportPayload } from '../../../../../../report-astro-payload.js';
import { isValidReportId } from '../../../../../../server/fs-utils.js';
import { runDir, isValidRunId } from '../../../../../../server/run-ids.js';
import { listVisibleRunsForDomain, viewerFromAstro } from '../../../../../../server/audit-viewer.mjs';
import { dbPool } from '../../../../../../server/db.js';
import { REPORTS_BASE } from '../../../../../../server/paths.js';
import { combinedScoreWithManual } from '../../../../../../report-buckets.js';
import { readReviewed } from '../../../../../../server/reviewed.mjs';
import { accessAllows } from '../../../../../../server/entitlements.mjs';
import { MANUAL_TODO_GROUPS, normalizeManualProgress } from '../../../../../../manual-checklist.js';
import { usePageLang } from '../../../../lib/page-lang.js';
import { dateLocale } from '../../../../../../i18n/index.mjs';

export const prerender = false;
const tr = usePageLang(Astro);

const rawDomain = Astro.params.domain ?? '';
const rawRunId = Astro.params.runId ?? '';
const domain = typeof rawDomain === 'string' ? rawDomain : String(rawDomain);
const runId = typeof rawRunId === 'string' ? rawRunId : String(rawRunId);

if (!isValidReportId(domain) || !isValidRunId(runId)) {
  return new Response('Invalid run id', { status: 400 });
}

// Pro only. The Express app in front already refuses; this covers `astro dev`,
// where pages are served without it.
if (!(await accessAllows(Astro.locals.access, 'salesReport'))) {
  return new Response(tr('sales.proOnly'), { status: 403, headers: { 'Content-Type': 'text/plain; charset=utf-8' } });
}

const reportDir = runDir(domain, runId);
const resultsPath = join(reportDir, 'accessibility-results.json');
if (!existsSync(resultsPath)) {
  return new Response('Report not found', { status: 404 });
}

const json = JSON.parse(readFileSync(resultsPath, 'utf8'));
const payload = buildAstroMainReportPayload(json, { lang: tr.lang });
const pagesLoaded = payload.pagesLoaded === true;

const manualProgressPath = join(reportDir, 'manual-progress.json');
let manualChecked: string[] = [];
if (existsSync(manualProgressPath)) {
  try {
    const raw = JSON.parse(readFileSync(manualProgressPath, 'utf8'));
    manualChecked = normalizeManualProgress(raw?.checked);
  } catch {}
}
const manualTotal = MANUAL_TODO_GROUPS.reduce((s, g) => s + g.items.length, 0);
// Count only the reviewed marks that belong to this scan's findings, as the report does.
const reviewed = new Set(readReviewed(domain, runId));
const combinedScore =
  combinedScoreWithManual(payload.scoreBreakdown, manualChecked.length, manualTotal, {
    reviewTotal: payload.scoreModel.reviewKeys.length,
    reviewDone: payload.scoreModel.reviewKeys.filter((key) => reviewed.has(key)).length,
  }) ?? payload.scoreClamp;

const statementMetaPath = join(reportDir, 'statement-meta.json');
let statementMeta: any = null;
try {
  if (existsSync(statementMetaPath)) {
    statementMeta = JSON.parse(readFileSync(statementMetaPath, 'utf8'));
  }
} catch {}

const principles = payload.principles || [];
const plainEnglish = payload.plainEnglish || { headline: '', cards: [] };

const allRuns = await listVisibleRunsForDomain(dbPool, REPORTS_BASE, domain, viewerFromAstro(Astro));
const trend = allRuns
  .slice()
  .reverse()
  .filter((r) => typeof r.score === 'number')
  .map((r) => {
    const d = r.updatedAt ? new Date(r.updatedAt) : null;
    const label = d && !Number.isNaN(d.getTime())
      ? d.toLocaleString(dateLocale(tr.lang), { month: 'short', day: '2-digit' })
      : r.runId.slice(5, 10);
    return { date: label, score: r.score as number };
  });
const previousScore = (() => {
  const idx = allRuns.findIndex((r) => r.runId === runId);
  if (idx < 0) return null;
  const prev = allRuns[idx + 1];
  return prev && typeof prev.score === 'number' ? prev.score : null;
})();

const fixOrderTopColors = ['var(--us-peach)', 'var(--us-lilac)', 'var(--us-mint)', 'var(--us-sky)', 'var(--us-pink)'];
const topFixes = (payload.fixOrderTop || []).slice(0, 5).map((f, i) => ({
  rank: String(i + 1).padStart(2, '0'),
  title: f.duplicateIdLabel ? `${f.rule || f.id} (${f.duplicateIdLabel})` : (f.rule || f.id || tr('sales.fixFallback')),
  impact: f.snippet || tr('sales.affects', { where: f.url || tr('sales.multiplePages') }),
  points: typeof f.effort === 'number' ? f.effort : f.impact === 'High' ? 5 : f.impact === 'Medium' ? 3 : 1,
  color: fixOrderTopColors[i % fixOrderTopColors.length],
}));

const companyName = statementMeta?.organizationName || statementMeta?.organizationShortName || payload.primaryHost;
const legalName = statementMeta?.organizationName || '';
const coordinator = statementMeta?.contactName || statementMeta?.coordinator || '';
const coordinatorEmail = statementMeta?.contactEmail || statementMeta?.email || '';

const deckProps = {
  primaryHost: payload.primaryHost,
  companyName,
  auditDate: payload.auditedDate,
  scoreClamp: payload.scoreClamp,
  combinedScore,
  manualChecked: manualChecked.length,
  manualTotal,
  previousScore,
  pagesScanned: payload.urls.length,
  rulesChecked: payload.rulesTable.length,
  trend: trend.length > 1 ? trend : [
    { date: tr('sales.now'), score: payload.scoreClamp },
  ],
  principles,
  plainEnglish,
  topFixes,
  coordinator,
  coordinatorEmail,
  legalName,
  domain,
  runId,
  lang: tr.lang,
  // Rule names and snippets come from the scan; English for now.
  findingsLang: 'en',
  auditYear: json.generatedAt ? new Date(json.generatedAt).getFullYear() : new Date().getFullYear(),
};

const autoPrint = Astro.url.searchParams.get('print') === '1';
---

<Layout title={tr('sales.title', { company: companyName })} description={tr('sales.description', { company: companyName })}>
  <div class="app-shell">
    <AppHeader domain={domain} runId={runId} active="sales" />
    <main id="main" class="app-main" tabindex="-1">
      {pagesLoaded ? (
        <SalesDeck client:only="svelte" {...deckProps} autoPrint={autoPrint} />
      ) : (
        <ScanFailedPanel
          domain={domain}
          runId={runId}
          primaryHost={payload.primaryHost || domain}
          loadFailures={payload.loadFailures || []}
          title={tr('sales.notReady')}
          lang={tr.lang}
        />
      )}
    </main>
  </div>
</Layout>

<script src="/vendor/deck-stage.js" is:inline></script>
