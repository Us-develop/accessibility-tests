---
import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/AppHeader.astro';
import { usePageLang } from '../lib/page-lang.js';
export const prerender = false;
const tr = usePageLang(Astro);
const sent = Astro.url.searchParams.get('sent') === '1';
---
<Layout title={tr('forgot.title')} description={tr('forgot.description')} noindex={true} authMode="guest-ok">
  <div class="app-shell">
    <AppHeader crumb={tr('forgot.crumb')} />
    <main id="main" class="app-main" tabindex="-1">
      <article class="container-narrow page-article">
        <h1>{tr('forgot.h1')}</h1>
        <p class="muted prose-width prose-lead">{tr('forgot.lead')}</p>
        <form id="forgot-form" class="card stack-form stack-form-spaced" method="post" action="/api/auth/forgot" data-astro-reload>
          <div class="field">
            <label class="field-label" for="email">{tr('login.email')}</label>
            <input class="input" id="email" name="email" type="email" required autocomplete="email" />
          </div>
          <button class="btn btn-primary" type="submit">{tr('forgot.submit')}</button>
          <p id="forgot-msg" class="muted" role="status">{sent ? tr('forgot.sent') : ''}</p>
        </form>
      </article>
    </main>
  </div>
</Layout>
<script>
  import { pageLang, t } from '../../../i18n/index.mjs';

  if (!globalThis.__wcagForgotDelegated) {
    globalThis.__wcagForgotDelegated = true;
    document.addEventListener('submit', async (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || form.id !== 'forgot-form') return;
      event.preventDefault();
      event.stopPropagation();
      const emailValue = new FormData(form).get('email');
      const api = typeof globalThis.wcagApiUrl === 'function' ? globalThis.wcagApiUrl : (p) => p;
      await fetch(api('/api/auth/forgot'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: emailValue }),
      });
      const msg = document.getElementById('forgot-msg');
      const emailField = document.getElementById('email');
      if (msg) {
        msg.textContent = t(pageLang(), 'forgot.sent');
        msg.setAttribute('role', 'status');
      }
      if (emailField) {
        emailField.removeAttribute('aria-invalid');
        emailField.removeAttribute('aria-describedby');
      }
    }, true);
  }
</script>
