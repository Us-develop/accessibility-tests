---
import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/AppHeader.astro';
export const prerender = false;
---
<Layout title="Reset password · Us" indexable={true} authMode="guest-ok">
  <div class="app-shell">
    <AppHeader crumb="Password" />
    <main class="app-main">
      <article class="container-narrow page-article">
        <h1>Forgot password</h1>
        <form id="forgot-form" class="card stack-form stack-form-spaced">
          <div class="field">
            <label class="field-label" for="email">Email</label>
            <input class="input" id="email" name="email" type="email" required />
          </div>
          <button class="btn btn-primary" type="submit">Send reset link</button>
          <p id="forgot-msg" class="muted" role="status"></p>
        </form>
      </article>
    </main>
  </div>
</Layout>
<script>
  document.getElementById('forgot-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = new FormData(e.currentTarget).get('email');
    const api = typeof globalThis.wcagApiUrl === 'function' ? globalThis.wcagApiUrl : (p) => p;
    await fetch(api('/api/auth/forgot'), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email }),
    });
    const msg = document.getElementById('forgot-msg');
    if (msg) msg.textContent = 'If that account exists, we sent a reset link (or logged it when SMTP is off).';
  });
</script>
