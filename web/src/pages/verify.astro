---
import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/AppHeader.astro';
import { customerLoginNext } from '../../../server/login-redirect.mjs';
import { usePageLang } from '../lib/page-lang.js';

export const prerender = false;
const tr = usePageLang(Astro);
const token = String(Astro.url.searchParams.get('token') || '').trim();
const invalid = Astro.url.searchParams.get('error') === 'invalid';
const sent = Astro.url.searchParams.get('sent') === '1';
const nextPath = customerLoginNext(Astro.url.searchParams.get('next') || '');
---
<Layout title={tr('verify.title')} description={tr('verify.description')} noindex={true} authMode="guest-ok">
  <div class="app-shell">
    <AppHeader crumb={tr('verify.crumb')} />
    <main id="main" class="app-main" tabindex="-1">
      <article class="container-narrow page-article">
        <h1>{tr('verify.h1')}</h1>
        {token && !invalid ? (
          <form id="verify-form" class="card stack-form" method="post" action="/api/auth/verify" data-astro-reload>
            <input type="hidden" name="token" value={token} />
            {nextPath && nextPath !== '/account' ? <input type="hidden" name="next" value={nextPath} /> : null}
            <p class="muted">{tr('verify.body')}</p>
            <button type="submit" class="btn btn-primary" id="verify-btn">{tr('verify.submit')}</button>
          </form>
        ) : (
          <div class="card stack-form">
            <p id="verify-msg" class="muted" role={invalid ? 'alert' : 'status'}>
              {sent ? tr('verify.sent') : invalid ? tr('verify.invalid') : tr('verify.open')}
            </p>
            <p class="muted" style="font-size: 13px; margin: 0;">
              {tr('signup.check.already')} <button type="button" class="linklike" id="verify-open-login">{tr('signup.login')}</button>
            </p>
            <form id="verify-resend-form" class="stack-form" method="post" action="/api/auth/verify/resend" data-astro-reload>
              <div class="field">
                <label class="field-label" for="verify-email">{tr('login.email')}</label>
                <input class="input" id="verify-email" name="email" type="email" autocomplete="email" required />
              </div>
              <button type="submit" class="btn btn-ghost">{tr('verify.resend')}</button>
            </form>
          </div>
        )}
      </article>
    </main>
  </div>
</Layout>
<script>
  import { isSafeRelativePath } from '../../../server/safe-path.mjs';

  if (!globalThis.__wcagVerifyDelegated) {
    globalThis.__wcagVerifyDelegated = true;
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element) || !target.closest('#verify-open-login')) return;
      document.dispatchEvent(new CustomEvent('wcag:open-login'));
    });
    document.addEventListener('submit', async (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement)) return;
      const api = typeof globalThis.wcagApiUrl === 'function' ? globalThis.wcagApiUrl : (p) => p;
      const creds = typeof globalThis.wcagFetchCredentials === 'function' ? globalThis.wcagFetchCredentials() : 'same-origin';
      if (form.id === 'verify-form') {
        event.preventDefault();
        event.stopPropagation();
        const token = String(new FormData(form).get('token') || '');
        const next = String(new FormData(form).get('next') || '');
        const res = await fetch(api('/api/auth/verify'), {
          method: 'POST',
          credentials: creds,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, next }),
        });
        if (res.ok) {
          const data = await res.json().catch(() => ({}));
          const dest = String(data.next || next || '/account');
          window.location.href = isSafeRelativePath(dest) ? dest : '/account';
          return;
        }
        window.location.href = '/verify?error=invalid';
        return;
      }
      if (form.id === 'verify-resend-form') {
        event.preventDefault();
        event.stopPropagation();
        const email = new FormData(form).get('email');
        await fetch(api('/api/auth/verify/resend'), {
          method: 'POST',
          credentials: creds,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        window.location.href = '/verify?sent=1';
      }
    }, true);
  }
</script>
