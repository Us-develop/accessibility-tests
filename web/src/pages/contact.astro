---
import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/AppHeader.astro';
import GuestLeadForm from '../components/GuestLeadForm.svelte';
import { LEAD_SOURCES } from '../../../server/plan-catalog.mjs';
import { isValidGuestToken } from '../../../server/guest.mjs';
import { usePageLang } from '../lib/page-lang.js';

export const prerender = false;
const tr = usePageLang(Astro);

// Where the visitor came from, so the team knows the context of the request.
const requested = String(Astro.url.searchParams.get('source') || '');
const source = LEAD_SOURCES.includes(requested) ? requested : 'contact';
// From a free snapshot: the request is tied to that scan, as the form on the snapshot page used to do.
const requestedGuest = String(Astro.url.searchParams.get('guest') || '');
const guestToken = isValidGuestToken(requestedGuest) ? requestedGuest : '';
---

<Layout
  title={tr('contact.title')}
  description={tr('contact.description')}
  noindex={true}
  authMode="guest-ok"
>
  <div class="app">
    <AppHeader crumb={tr('contact.crumb')} />
    <main id="main" class="app-main" tabindex="-1">
      <div class="container" style="padding: 56px 32px 96px; max-width: 760px;">
        <span class="eyebrow"><span class="dot"></span>{tr('contact.eyebrow')}</span>
        <h1 class="run-hero-title">{tr('contact.h1')}</h1>
        <p class="p-large muted" style="margin-bottom: 28px;">{tr('contact.lead')}</p>
        <GuestLeadForm
          client:load
          source={source}
          token={guestToken}
          lang={tr.lang}
          heading={tr('contact.form.heading')}
          intro={tr('contact.form.intro')}
        />
      </div>
    </main>
  </div>
</Layout>
