---
import Layout from '../../layouts/Layout.astro';
import AppHeader from '../../components/AppHeader.astro';
import { readSubprocessorsMarkdown } from '../../../../server/legal-versions.mjs';

export const prerender = false;

function inlineMarkdown(text) {
  return text
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a class="link" href="$2">$1</a>')
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
}

function renderSubprocessorsMarkdown(md) {
  const lines = String(md || '')
    .replace(/<!--[\s\S]*?-->/g, '')
    .split('\n');
  const html = [];
  let inTable = false;
  let list = [];
  const flushList = () => {
    if (!list.length) return;
    html.push(`<ul>${list.map((item) => `<li>${inlineMarkdown(item)}</li>`).join('')}</ul>`);
    list = [];
  };
  for (const raw of lines) {
    const line = raw.trimEnd();
    if (line.startsWith('|')) {
      flushList();
      const cells = line.split('|').slice(1, -1).map((c) => c.trim());
      if (cells.every((c) => /^[-:]+$/.test(c))) continue;
      if (!inTable) {
        html.push('<table class="account-table"><thead><tr>');
        html.push(cells.map((c) => `<th scope="col">${inlineMarkdown(c)}</th>`).join(''));
        html.push('</tr></thead><tbody>');
        inTable = true;
      } else {
        html.push(`<tr>${cells.map((c) => `<td>${inlineMarkdown(c)}</td>`).join('')}</tr>`);
      }
      continue;
    }
    if (inTable) {
      html.push('</tbody></table>');
      inTable = false;
    }
    if (!line.trim()) {
      flushList();
      continue;
    }
    if (line.startsWith('# ')) {
      flushList();
      html.push(`<h1>${inlineMarkdown(line.slice(2))}</h1>`);
      continue;
    }
    if (line.startsWith('## ')) {
      flushList();
      html.push(`<h2>${inlineMarkdown(line.slice(3))}</h2>`);
      continue;
    }
    if (line.startsWith('- ')) {
      list.push(line.slice(2));
      continue;
    }
    flushList();
    html.push(`<p>${inlineMarkdown(line.trim())}</p>`);
  }
  flushList();
  if (inTable) html.push('</tbody></table>');
  return html.join('\n');
}

const bodyHtml = renderSubprocessorsMarkdown(readSubprocessorsMarkdown());
---
<Layout title="Subprocessors · Us" description="Processors that may handle personal data for the Us accessibility scanner, including hosting, mail, Stripe, and optional AI or Jira tools." noindex={false} authMode="guest-ok">
  <div class="app-shell">
    <AppHeader crumb="Subprocessors" />
    <main id="main" class="app-main" tabindex="-1">
      <article class="container-narrow page-article">
        <div class="prose-width" set:html={bodyHtml} />
      </article>
    </main>
  </div>
</Layout>
