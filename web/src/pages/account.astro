---
import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/AppHeader.astro';
import { WITHDRAWAL_WAIVER_TEXT } from '../../../server/legal-versions.mjs';
import { TOKEN_PACKS } from '../../../server/plan-catalog.mjs';
import { vatParts } from '../../../server/vat-display.mjs';
import { usePageLang } from '../lib/page-lang.js';
import WideWord from '../components/WideWord.astro';

export const prerender = false;
const tr = usePageLang(Astro);
// The waiver is recorded in English, the binding language (as on pricing).
const waiverLang = tr.lang === 'en' ? undefined : 'en';
const waiverNote = tr.lang === 'en' ? '' : tr('checkout.waiver.note');
const packs = TOKEN_PACKS.map((pack) => ({ id: pack.id, n: pack.tokens, price: vatParts(pack.priceCents) }));
// "Hi Astrid" when we know the first name, as in the header.
const firstName = String(Astro.locals?.access?.firstName || '').trim();
const heading = firstName ? tr('header.greeting', { name: firstName }) : tr('acct.h1');
---
<Layout title={tr('acct.title')} description={tr('acct.description')} authMode="required">
  <div class="app-shell">
    <AppHeader crumb={tr('acct.crumb')} />
    <main id="main" class="app-main" tabindex="-1">
      <article class="page-wrap">
        <h1 class="page-title"><WideWord text={heading} word={firstName} /></h1>
        <p id="account-status" class="text-light">{tr('acct.loading')}</p>

        <div class="account-actions">
          <a class="btn btn-primary btn-sm" href="/">{tr('acct.action.scan')}</a>
          <a class="btn btn-secondary btn-sm" href="/audits">{tr('acct.action.allScans')}</a>
          <a class="btn btn-ghost btn-sm" href="/api/account/export">{tr('acct.action.exportJson')}</a>
          <a class="btn btn-ghost btn-sm" href="/api/account/export?format=csv">{tr('acct.action.exportCsv')}</a>
        </div>

        <p id="account-msg" class="muted" role="status"></p>

        <section id="billing-success" class="panel account-section" role="status" tabindex="-1" hidden>
          <h2 class="card-title">{tr('acct.paid.h2')}</h2>
          <p id="billing-success-text">{tr('acct.paid.updating')}</p>
          <div class="guest-cta-row">
            <a class="btn btn-primary" href="/">{tr('acct.paid.start')}</a>
          </div>
        </section>

        <div class="account-layout">
          <div class="account-side">
            <div id="account-nav-balance" class="account-balance" hidden>
              <p class="text-small">{tr('acct.nav.tokens')}</p>
              <div class="account-balance-row">
                <p class="account-balance-value" id="account-balance-value"></p>
                <a class="text-small account-balance-link" href="#tokens">{tr('home.customer.buyTokens')}</a>
              </div>
              <div class="meter" aria-hidden="true"><span id="account-balance-fill"></span></div>
              <p id="account-balance-long" class="text-small"></p>
            </div>
            <nav class="account-nav" aria-label={tr('acct.nav.aria')}>
              <ul>
                <li><a href="#projects">{tr('acct.nav.projects')}</a></li>
                <li><a href="#scan-history">{tr('acct.nav.history')}</a></li>
                <li data-customer-only hidden><a href="#subscription">{tr('acct.nav.subscription')}</a></li>
                <li data-customer-only hidden><a href="#tokens">{tr('acct.nav.tokens')}</a></li>
                <li><a href="#payments">{tr('acct.nav.payments')}</a></li>
                <li data-customer-only hidden><a href="#personal">{tr('acct.nav.personal')}</a></li>
              </ul>
            </nav>
          </div>

          <div class="account-main">
            <section id="projects-card" class="panel account-section">
              <h2 id="projects" class="card-title" tabindex="-1">{tr('acct.nav.projects')}</h2>
              <div id="account-projects" class="project-list"><p class="text-light">{tr('acct.loading')}</p></div>
            </section>

            <section id="scans-card" class="panel account-section" hidden>
              <h2 id="scan-history" class="card-title" tabindex="-1">{tr('acct.nav.history')}</h2>
              <div class="table-wrap">
                <table class="data-table">
                  <thead>
                    <tr>
                      <th scope="col">{tr('acct.scans.project')}</th>
                      <th scope="col">{tr('acct.scans.date')}</th>
                      <th scope="col">{tr('acct.scans.pages')}</th>
                      <th scope="col">{tr('acct.scans.score')}</th>
                      <th scope="col">{tr('acct.scans.status')}</th>
                    </tr>
                  </thead>
                  <tbody id="scans-body"></tbody>
                </table>
              </div>
            </section>

            <section id="usage-card" class="panel account-section" data-checkout-scope hidden>
              <h2 id="subscription" class="card-title" tabindex="-1">{tr('acct.sub.h2')}</h2>
              <div>
                <p id="plan-name" class="account-strong"></p>
                <p id="plan-status" class="text-light"></p>
              </div>
              <div id="usage-meter" class="account-meter" hidden>
                <p id="usage-label" class="account-meter-label"></p>
                <div class="meter" aria-hidden="true"><span id="usage-fill"></span></div>
              </div>
              <div id="subscribe-actions" class="account-stack">
                <label class="selector account-waiver">
                  <input type="checkbox" class="checkout-waiver" id="withdrawal-waiver-pro" name="withdrawalWaiver" value="true" aria-describedby={waiverNote ? 'waiver-note-pro' : undefined} />
                  <span class="selector-box" aria-hidden="true"></span>
                  <span lang={waiverLang}>{WITHDRAWAL_WAIVER_TEXT}</span>
                </label>
                {waiverNote ? <p id="waiver-note-pro" class="text-small text-grey">{waiverNote}</p> : null}
                <p class="checkout-msg muted" role="status" aria-live="polite"></p>
                <div class="account-buttons">
                  <button type="button" class="btn btn-primary pricing-checkout" data-kind="pro" data-interval="monthly">{tr('pricing.pro.monthly')}</button>
                  <button type="button" class="btn btn-primary pricing-checkout" data-kind="pro" data-interval="yearly">{tr('pricing.pro.yearly')}</button>
                </div>
              </div>
              <div class="account-sub-foot">
                <p class="text-small">{tr('acct.sub.cancelNote')}</p>
                <div id="billing-actions">
                  <button type="button" class="link-icon" id="manage-billing-btn"><img src="/assets/icons/settings.svg" width="16" height="16" alt="" />{tr('acct.sub.manage')}</button>
                </div>
              </div>
              <p id="billing-portal-msg" class="muted" role="status"></p>
            </section>

            <section id="tokens-card" class="panel account-section" data-checkout-scope hidden>
              <h2 id="tokens" class="card-title" tabindex="-1">{tr('acct.tokens.h2')}</h2>
              <div class="account-meter">
                <p id="token-balance" class="account-meter-label"></p>
                <div class="meter" aria-hidden="true"><span id="token-fill"></span></div>
              </div>
              <p class="text-light">{tr('acct.tokens.body')}</p>
              <label class="selector account-waiver">
                <input type="checkbox" class="checkout-waiver" id="withdrawal-waiver" name="withdrawalWaiver" value="true" aria-describedby={waiverNote ? 'waiver-note-tokens' : undefined} />
                <span class="selector-box" aria-hidden="true"></span>
                <span lang={waiverLang}>{WITHDRAWAL_WAIVER_TEXT}</span>
              </label>
              {waiverNote ? <p id="waiver-note-tokens" class="text-small text-grey">{waiverNote}</p> : null}
              <p id="account-billing-msg" class="checkout-msg muted" role="status" aria-live="polite"></p>
              <ul class="account-packs">
                {packs.map((pack) => (
                  <li>
                    <button type="button" class="btn btn-primary token-buy" data-pack={pack.id} aria-describedby={`pack-price-${pack.id}`}>{tr('acct.tokens.buy', { n: pack.n })}</button>
                    <span class="text-small text-grey" id={`pack-price-${pack.id}`}>
                      {tr('price.incl', { price: pack.price.incl })}
                    </span>
                  </li>
                ))}
              </ul>
              <a class="btn-text" href="/contact?source=account"><img src="/assets/icons/mail.svg" width="20" height="20" alt="" />{tr('cta.expert')}</a>
            </section>

            <section id="payments-card" class="panel account-section" hidden>
              <h2 id="payments" class="card-title" tabindex="-1">{tr('acct.nav.payments')}</h2>
              <p id="payments-empty" class="text-light">{tr('acct.payments.empty')}</p>
              <div class="table-wrap" id="payments-table-wrap" hidden>
                <table class="data-table">
                  <thead>
                    <tr>
                      <th scope="col">{tr('acct.payments.date')}</th>
                      <th scope="col">{tr('acct.payments.description')}</th>
                      <th scope="col">{tr('acct.payments.amount')}</th>
                      <th scope="col">{tr('acct.payments.status')}</th>
                    </tr>
                  </thead>
                  <tbody id="payments-body"></tbody>
                </table>
              </div>
            </section>

            <section id="contact-card" class="panel account-section" hidden>
              <h2 id="personal" class="card-title" tabindex="-1">{tr('acct.nav.personal')}</h2>
              <form id="contact-form" class="account-form" method="post" action="/account" data-astro-reload>
                <fieldset class="selector-group account-type">
                  <legend class="sr-only">{tr('signup.type.legend')}</legend>
                  <label class="selector">
                    <input type="radio" name="customerType" value="business" id="account-type-business" />
                    <span class="selector-box" aria-hidden="true"></span>
                    <span class="selector-text">{tr('signup.type.business')}</span>
                  </label>
                  <label class="selector">
                    <input type="radio" name="customerType" value="consumer" id="account-type-consumer" checked />
                    <span class="selector-box" aria-hidden="true"></span>
                    <span class="selector-text">{tr('signup.type.consumer')}</span>
                  </label>
                </fieldset>
                <div class="line-form">
                  <div class="line-row">
                    <div class="line-field">
                      <label class="line-label" for="account-first-name">{tr('signup.firstName')}</label>
                      <div class="line-control"><input class="line-input" id="account-first-name" name="firstName" type="text" autocomplete="given-name" /></div>
                    </div>
                    <div class="line-field">
                      <label class="line-label" for="account-last-name">{tr('signup.lastName')}</label>
                      <div class="line-control"><input class="line-input" id="account-last-name" name="lastName" type="text" autocomplete="family-name" /></div>
                    </div>
                  </div>
                  <div class="line-row">
                    <div class="line-field">
                      <label class="line-label" for="account-address">{tr('acct.address')}</label>
                      <div class="line-control"><input class="line-input" id="account-address" name="addressLine1" type="text" autocomplete="address-line1" /></div>
                    </div>
                    <div class="line-field">
                      <label class="line-label" for="account-address2">{tr('acct.address2')}</label>
                      <div class="line-control"><input class="line-input" id="account-address2" name="addressLine2" type="text" autocomplete="address-line2" /></div>
                    </div>
                  </div>
                  <div class="line-row">
                    <div class="line-pair">
                      <div class="line-field">
                        <label class="line-label" for="account-postal-code">{tr('acct.postalCode')}</label>
                        <div class="line-control"><input class="line-input" id="account-postal-code" name="postalCode" type="text" autocomplete="postal-code" /></div>
                      </div>
                      <div class="line-field">
                        <label class="line-label" for="account-city">{tr('acct.city')}</label>
                        <div class="line-control"><input class="line-input" id="account-city" name="city" type="text" autocomplete="address-level2" /></div>
                      </div>
                    </div>
                    <div class="line-field">
                      <label class="line-label" for="account-country">{tr('acct.country')}</label>
                      <div class="line-control"><input class="line-input" id="account-country" name="country" type="text" autocomplete="country-name" /></div>
                    </div>
                  </div>
                  <div class="line-row" id="business-fields" hidden>
                    <div class="line-field">
                      <label class="line-label" for="account-company">{tr('signup.company')}</label>
                      <div class="line-control"><input class="line-input" id="account-company" name="company" type="text" autocomplete="organization" /></div>
                    </div>
                    <div class="line-field">
                      <div class="line-label">
                        <label for="account-vat">{tr('signup.vat')}</label>
                        <span id="account-vat-hint" class="line-label-hint">{tr('signup.vat.hint')}</span>
                      </div>
                      <div class="line-control"><input class="line-input" id="account-vat" name="vatNumber" type="text" aria-describedby="account-vat-hint" /></div>
                    </div>
                  </div>
                  <div class="line-row">
                    <div class="line-field">
                      <label class="line-label" for="account-phone">{tr('acct.phone')}</label>
                      <div class="line-control"><input class="line-input" id="account-phone" name="phone" type="tel" autocomplete="tel" /></div>
                    </div>
                  </div>
                </div>
                <p id="contact-msg" class="muted" role="status"></p>
                <button type="submit" class="btn btn-primary">{tr('acct.save')}</button>
              </form>

              <div id="password-card" class="account-subsection" hidden>
                <h3 class="subsection-title">{tr('acct.password.h2')}</h3>
                <form id="password-form" class="account-form" method="post" action="/account" data-astro-reload>
                  <div class="line-row">
                    <div class="line-field">
                      <label class="line-label" for="account-current-password">{tr('acct.password.current')}</label>
                      <div class="line-control">
                        <input class="line-input" id="account-current-password" name="currentPassword" type="password" autocomplete="current-password" required />
                        <button type="button" class="line-toggle" data-password-toggle="account-current-password" aria-pressed="false" aria-label={tr('signup.password.show')}><img src="/assets/icons/visibility.svg" width="16" height="16" alt="" /></button>
                      </div>
                    </div>
                    <div class="line-field">
                      <div class="line-label">
                        <label for="account-new-password">{tr('acct.password.new')}</label>
                        <span id="account-password-hint" class="line-label-hint">{tr('signup.password.hint')}</span>
                      </div>
                      <div class="line-control">
                        <input class="line-input" id="account-new-password" name="password" type="password" autocomplete="new-password" minlength="10" required aria-describedby="account-password-hint" />
                        <button type="button" class="line-toggle" data-password-toggle="account-new-password" aria-pressed="false" aria-label={tr('signup.password.show')}><img src="/assets/icons/visibility.svg" width="16" height="16" alt="" /></button>
                      </div>
                    </div>
                  </div>
                  <p id="password-msg" class="muted" role="status"></p>
                  <button type="submit" class="btn btn-primary">{tr('acct.password.submit')}</button>
                </form>
              </div>

              <div id="email-card" class="account-subsection" hidden>
                <h3 class="subsection-title">{tr('acct.email.h2')}</h3>
                <form id="email-form" class="account-form" method="post" action="/api/account/email" data-astro-reload>
                  <input type="hidden" name="csrfToken" class="wcag-csrf-field" value="" />
                  <div class="line-row">
                    <div class="line-field">
                      <label class="line-label" for="account-current-email">{tr('acct.email.current')}</label>
                      <div class="line-control"><input class="line-input" id="account-current-email" type="email" readonly /></div>
                    </div>
                    <div class="line-field">
                      <label class="line-label" for="account-new-email">{tr('acct.email.new')}</label>
                      <div class="line-control"><input class="line-input" id="account-new-email" name="email" type="email" autocomplete="email" required /></div>
                    </div>
                  </div>
                  <div class="line-row">
                    <div class="line-field">
                      <label class="line-label" for="email-password">{tr('acct.password.current')}</label>
                      <div class="line-control"><input class="line-input" id="email-password" name="password" type="password" autocomplete="current-password" required /></div>
                    </div>
                  </div>
                  <p id="email-msg" class="muted" role="status"></p>
                  <button type="submit" class="btn btn-primary">{tr('acct.email.submit')}</button>
                </form>
              </div>
            </section>

            <p id="delete-open-row" hidden>
              <button type="button" class="link-icon account-delete-open" id="delete-open" aria-expanded="false" aria-controls="delete-card"><img src="/assets/icons/delete-large.svg" width="20" height="20" alt="" />{tr('acct.delete.open')}</button>
            </p>
            <section id="delete-card" class="panel account-section" hidden>
              <h2 id="delete-title" class="card-title" tabindex="-1">{tr('acct.delete.h2')}</h2>
              <form id="delete-form" class="account-form" method="post" action="/api/account/delete" data-astro-reload>
                <input type="hidden" name="csrfToken" class="wcag-csrf-field" value="" />
                <p class="text-light">{tr('acct.delete.body')}</p>
                <div class="line-row">
                  <div class="line-field">
                    <label class="line-label" for="delete-password">{tr('acct.password.current')}</label>
                    <div class="line-control"><input class="line-input" id="delete-password" name="password" type="password" autocomplete="current-password" required /></div>
                  </div>
                </div>
                <p id="delete-msg" class="muted" role="status"></p>
                <div class="account-buttons">
                  <button type="submit" class="btn btn-secondary" id="delete-btn">{tr('acct.delete.confirm')}</button>
                  <button type="button" class="btn btn-primary" id="delete-cancel">{tr('acct.delete.keep')}</button>
                </div>
              </form>
            </section>
          </div>
        </div>
      </article>
    </main>
  </div>
</Layout>
<style>
  /* Display rules below would otherwise beat the hidden attribute. */
  .account-section[hidden],
  .account-main .account-section[hidden],
  .account-subsection[hidden],
  .account-balance[hidden],
  #subscribe-actions[hidden],
  .account-meter[hidden] {
    display: none;
  }
  #account-status { margin-top: 8px; }
  .account-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  #account-msg:empty,
  #billing-portal-msg:empty { display: none; }
  #billing-success { margin-top: 24px; }
  /* Figma "Account": a 280px sidebar beside an 880px column of cards. */
  .account-layout {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: var(--grid-gutter);
    align-items: start;
    margin-top: 40px;
  }
  .account-side {
    position: sticky;
    top: 112px;
    padding-right: 16px;
  }
  .account-balance {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 8px;
    margin-bottom: -12px;
    padding: 16px;
    background: var(--us-lilac-light);
    border-radius: 12px;
  }
  .account-balance-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .account-balance-value {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 500;
    line-height: 32px;
  }
  .account-balance-link { color: var(--fg-1); text-underline-offset: 3px; }
  #account-balance-long:empty { display: none; }
  .account-nav {
    position: relative;
    z-index: 1;
    padding: 32px 16px 16px;
    background: var(--us-n-10);
    border-radius: 0 0 12px 12px;
  }
  .account-balance[hidden] + .account-nav {
    padding-top: 16px;
    border-radius: 12px;
  }
  .account-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .account-nav li[hidden] { display: none; }
  .account-nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    color: var(--fg-1);
    font-weight: 600;
    line-height: 28px;
    text-decoration: none;
  }
  .account-nav a::after {
    content: "";
    width: 20px;
    height: 20px;
    background: url("/assets/icons/chevron-right.svg") center / 20px 20px no-repeat;
  }
  .account-nav a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .account-main {
    display: grid;
    gap: 32px;
    min-width: 0;
  }
  .account-main .panel {
    display: grid;
    gap: 24px;
    align-content: start;
  }
  /* Let wide tables scroll inside their card instead of widening the page. */
  .account-main .panel > * { min-width: 0; }
  .account-main h2 { scroll-margin-top: 112px; }
  .project-list ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .project-row {
    display: grid;
    grid-template-columns: minmax(0, 300px) 1fr auto;
    align-items: center;
    gap: var(--grid-gutter);
    padding: 16px 32px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-sm);
  }
  .project-domain {
    color: var(--fg-1);
    font-weight: 600;
    overflow-wrap: anywhere;
    text-underline-offset: 3px;
  }
  .project-runs { font-weight: 300; }
  .project-view {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--fg-1);
    font-family: var(--font-button);
    font-size: 18px;
    font-weight: 500;
    line-height: 24px;
    text-decoration: none;
  }
  .project-view:hover { text-decoration: underline; text-underline-offset: 3px; }
  .account-strong { font-weight: 600; }
  .account-meter {
    display: grid;
    gap: 8px;
  }
  .account-meter-label { font-weight: 500; line-height: 24px; }
  .account-stack {
    display: grid;
    gap: 12px;
  }
  .account-waiver { font-size: 14px; line-height: 24px; }
  .account-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }
  .account-sub-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
  }
  .account-packs {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .account-packs li {
    display: grid;
    justify-items: center;
    gap: 4px;
    text-align: center;
  }
  .account-form {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .account-form > .line-form,
  .account-form > .line-row { width: 100%; }
  #contact-msg:empty,
  #password-msg:empty,
  #email-msg:empty,
  #delete-msg:empty { display: none; }
  .account-subsection {
    display: grid;
    gap: 20px;
    padding-top: 32px;
    border-top: 1px solid var(--border-subtle);
  }
  .account-delete-open { color: var(--fg-1); text-decoration: none; }
  .account-delete-open:hover { text-decoration: underline; }
  @media (max-width: 900px) {
    .account-layout { grid-template-columns: 1fr; }
    .account-side { position: static; padding-right: 0; }
    .project-row {
      grid-template-columns: 1fr auto;
      padding: 16px;
    }
    .project-view { grid-column: 1 / -1; }
  }
</style>
<script>
  import { announceBalanceChanged, balanceFromUsage, balanceLong } from '../lib/balance.js';
  import { bindCheckout, watchPaymentLanding } from '../lib/checkout.js';
  import { dateLocale, pageLang, serverMessageLang, t, tn } from '../../../i18n/index.mjs';
  import { bindPasswordToggles } from '../lib/password-toggle.js';

  const lang = () => pageLang();
  const tx = (key, vars) => t(lang(), key, vars);
  const day = (iso) => new Date(iso).toLocaleDateString(dateLocale(lang()));
  /** A known value in the visitor's language, anything else as it came. */
  const known = (prefix, value) => {
    const key = `${prefix}.${value}`;
    const text = tx(key);
    return text === key ? String(value || '—') : text;
  };

  bindCheckout();
  bindPasswordToggles();

  const api = (p) => (typeof globalThis.wcagApiUrl === 'function' ? globalThis.wcagApiUrl(p) : p);
  const creds = typeof globalThis.wcagFetchCredentials === 'function' ? globalThis.wcagFetchCredentials() : 'same-origin';
  const headers = () =>
    typeof globalThis.wcagHeaders === 'function' ? globalThis.wcagHeaders({ 'Content-Type': 'application/json' }) : { 'Content-Type': 'application/json' };

  /**
   * Show a message in the element that belongs to the action that caused it,
   * so a confirmation appears where the person is looking. `targetId` defaults
   * to the general line under the page title.
   */
  function setMsg(text, isError = false, targetId = 'account-msg', messageLang = '') {
    const msg = document.getElementById(targetId) || document.getElementById('account-msg');
    if (!msg) return;
    msg.textContent = text || '';
    msg.setAttribute('role', isError ? 'alert' : 'status');
    // Some server messages are still English: say so on a page in another language.
    if (messageLang && text && messageLang !== lang()) msg.setAttribute('lang', messageLang);
    else msg.removeAttribute('lang');
  }

  /** Messages from the server, or our own text when it sent none. */
  function serverMsg(data, fallbackKey, isError, targetId) {
    setMsg(data?.error || tx(fallbackKey), isError, targetId, data?.error ? serverMessageLang(data) : '');
  }

  function escapeHtml(s) {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function fillForm(form, user) {
    if (!form || !user) return;
    for (const el of form.elements) {
      if (!el.name || user[el.name] == null) continue;
      if (el instanceof HTMLInputElement && (el.type === 'checkbox' || el.type === 'radio')) continue;
      el.value = user[el.name];
    }
    // Accounts from before first and last name were asked: show the one name in "First name".
    const first = document.getElementById('account-first-name');
    if (first instanceof HTMLInputElement && !user.firstName && !user.lastName && user.name) first.value = user.name;
    setAccountType(user.customerType === 'business' ? 'business' : 'consumer');
    const currentEmail = document.getElementById('account-current-email');
    if (currentEmail instanceof HTMLInputElement) currentEmail.value = user.email || '';
  }

  /** Tick the account type and show the company fields for a business. */
  function setAccountType(type) {
    const radio = document.getElementById(type === 'business' ? 'account-type-business' : 'account-type-consumer');
    if (radio instanceof HTMLInputElement) radio.checked = true;
    const fields = document.getElementById('business-fields');
    if (fields) fields.hidden = type !== 'business';
  }

  function formatMoney(cents, currency) {
    const amount = Number(cents || 0) / 100;
    try {
      return new Intl.NumberFormat(dateLocale(lang()), { style: 'currency', currency: (currency || 'eur').toUpperCase() }).format(amount);
    } catch {
      return `${amount.toFixed(2)} ${(currency || 'eur').toUpperCase()}`;
    }
  }

  async function attachGuestIfPresent() {
    const guest = new URLSearchParams(window.location.search).get('guest') || '';
    if (!guest) return;
    const res = await fetch(api('/api/account/attach-guest'), {
      method: 'POST',
      credentials: creds,
      headers: headers(),
      body: JSON.stringify({ guestToken: guest }),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) {
      serverMsg(data, 'acct.guest.error', true, 'account-msg');
      return;
    }
    setMsg(data.project?.domain ? tx('acct.guest.saved', { domain: data.project.domain }) : tx('acct.guest.savedGeneric'));
  }

  async function load() {
    const res = await fetch(api('/api/account'), { credentials: creds });
    const data = await res.json().catch(() => ({}));
    const status = document.getElementById('account-status');
    const list = document.getElementById('account-projects');
    if (!res.ok) {
      if (status) status.textContent = data.error || tx('acct.status.signIn');
      return;
    }
    if (status) status.textContent = `${data.user?.email || ''} · ${known('acct.role', data.role)}`;

      const usageCard = document.getElementById('usage-card');
      const tokensCard = document.getElementById('tokens-card');
      const contactCard = document.getElementById('contact-card');
      const passwordCard = document.getElementById('password-card');
      const emailCard = document.getElementById('email-card');
      const deleteRow = document.getElementById('delete-open-row');
      if (data.role === 'customer') {
        if (usageCard) usageCard.hidden = false;
        if (tokensCard) tokensCard.hidden = false;
        if (contactCard) contactCard.hidden = false;
        if (passwordCard) passwordCard.hidden = false;
        if (emailCard) emailCard.hidden = false;
        // Deleting is a small link at the bottom; its form opens on request.
        if (deleteRow) deleteRow.hidden = false;
        document.querySelectorAll('.account-nav [data-customer-only]').forEach((el) => {
          el.hidden = false;
        });
        fillForm(document.getElementById('contact-form'), data.user);
        const planName = document.getElementById('plan-name');
        const planStatus = document.getElementById('plan-status');
        const usage = data.usage || {};
        const sub = data.subscription || {};
        const isPro = data.plan?.id === 'pro' && ['active', 'trialing', 'past_due'].includes(sub.status);
        if (planName) {
          planName.textContent = isPro
            ? tx(sub.billingInterval === 'yearly' ? 'acct.sub.proYearly' : 'acct.sub.proMonthly')
            : tx('acct.sub.none');
        }
        if (planStatus) {
          if (isPro && sub.cancelAtPeriodEnd && sub.currentPeriodEnd) {
            planStatus.textContent = tx('acct.sub.cancels', { date: day(sub.currentPeriodEnd) });
          } else if (isPro && sub.currentPeriodEnd) {
            planStatus.textContent = tx('acct.sub.renews', { date: day(sub.currentPeriodEnd) });
          } else {
            planStatus.textContent = tx('acct.sub.pitch');
          }
        }
        const used = Number(usage.pagesScanned || 0);
        const max = isPro ? Number(usage.maxPagesPerMonth || 300) : 0;
        const pct = max ? Math.min(100, Math.round((used / max) * 100)) : 0;
        const meter = document.getElementById('usage-meter');
        if (meter) meter.hidden = !isPro;
        const fill = document.getElementById('usage-fill');
        if (fill) fill.style.width = max ? `${pct}%` : '0%';
        const usageLabel = document.getElementById('usage-label');
        if (usageLabel) usageLabel.textContent = isPro ? tx('acct.sub.usage', { used, max }) : '';
        const tokenBalance = document.getElementById('token-balance');
        // Same sums as the header (web/src/lib/balance.js).
        const balance = balanceFromUsage({ pro: isPro, tokens: data.tokens, pagesScanned: used, pagesPerMonth: max });
        const granted = Math.max(balance.tokens, Number(data.tokens?.granted || 0));
        const expires = data.tokens?.nextExpiresAt ? ` ${tx('acct.tokens.expires', { date: day(data.tokens.nextExpiresAt) })}` : '';
        if (tokenBalance) {
          tokenBalance.textContent = granted
            ? `${tn(lang(), 'acct.tokens.remaining', granted, { left: balance.tokens, total: granted })}${expires}`
            : tx('acct.tokens.none');
        }
        const tokenShare = granted ? `${Math.min(100, Math.round((balance.tokens / granted) * 100))}%` : '0%';
        const tokenFill = document.getElementById('token-fill');
        if (tokenFill) tokenFill.style.width = tokenShare;
        // Sidebar: tokens left as a number and a bar; Pro also says the pages left.
        const navBalance = document.getElementById('account-nav-balance');
        if (navBalance) {
          const value = document.getElementById('account-balance-value');
          if (value) value.textContent = String(balance.tokens);
          const sideFill = document.getElementById('account-balance-fill');
          if (sideFill) sideFill.style.width = tokenShare;
          const long = document.getElementById('account-balance-long');
          if (long) long.textContent = balance.pro ? balanceLong(balance) : '';
          navBalance.hidden = false;
        }
        const subscribeActions = document.getElementById('subscribe-actions');
        if (subscribeActions) subscribeActions.hidden = isPro;
      }

    const projects = Array.isArray(data.projects) ? data.projects : [];
    if (list) {
      if (!projects.length) {
        list.innerHTML = `<p class="text-light">${escapeHtml(tx('acct.projects.empty'))}</p>`;
      } else {
        list.innerHTML = `<ul>${projects
          .map((p) => {
            const href = `/report/${encodeURIComponent(p.domain)}/history`;
            return `<li class="project-row">
              <a class="project-domain" href="${href}">${escapeHtml(p.domain)}</a>
              <span class="project-runs">${escapeHtml(tn(lang(), 'acct.projects.runs', p.runIds?.length || 0))}</span>
              <a class="project-view" href="${href}"><img src="/assets/icons/eye.svg" width="20" height="20" alt="" />${escapeHtml(tx('acct.projects.view'))}<span class="sr-only"> ${escapeHtml(p.domain)}</span></a>
            </li>`;
          })
          .join('')}</ul>`;
      }
    }

    const scans = Array.isArray(data.scans) ? data.scans : [];
    const scansCard = document.getElementById('scans-card');
    const scansBody = document.getElementById('scans-body');
    if (scansCard && scansBody) {
      scansCard.hidden = false;
      if (!scans.length) {
        scansBody.innerHTML = `<tr><td colspan="5">${escapeHtml(tx('acct.scans.empty'))}</td></tr>`;
      } else {
        scansBody.innerHTML = scans
          .map((row) => {
            const href = row.run_id
              ? `/report/${encodeURIComponent(row.project_domain)}/${encodeURIComponent(row.run_id)}/`
              : `/report/${encodeURIComponent(row.project_domain)}/history`;
            const date = row.scan_date ? new Date(row.scan_date).toLocaleString(dateLocale(lang())) : '—';
            const score = row.score == null ? '—' : String(row.score);
            return `<tr>
              <td><a class="link" href="${href}">${escapeHtml(row.project_domain)}</a></td>
              <td>${escapeHtml(date)}</td>
              <td>${escapeHtml(row.pages_scanned ?? '—')}</td>
              <td>${escapeHtml(score)}</td>
              <td><span class="status-chip${row.status === 'done' ? ' is-done' : row.status === 'error' ? ' is-error' : ''}">${escapeHtml(known('acct.status', row.status))}</span></td>
            </tr>`;
          })
          .join('');
      }
    }

    const payments = Array.isArray(data.payments) ? data.payments : [];
    const paymentsCard = document.getElementById('payments-card');
    const paymentsEmpty = document.getElementById('payments-empty');
    const paymentsWrap = document.getElementById('payments-table-wrap');
    const paymentsBody = document.getElementById('payments-body');
    if (paymentsCard) {
      paymentsCard.hidden = false;
      if (!payments.length) {
        if (paymentsEmpty) paymentsEmpty.hidden = false;
        if (paymentsWrap) paymentsWrap.hidden = true;
      } else {
        if (paymentsEmpty) paymentsEmpty.hidden = true;
        if (paymentsWrap) paymentsWrap.hidden = false;
        if (paymentsBody) {
          paymentsBody.innerHTML = payments
            .map((row) => {
              const date = row.createdAt ? day(row.createdAt) : '—';
              const freebie = row.status === 'freebie';
              return `<tr>
                <td>${escapeHtml(date)}</td>
                <td>${escapeHtml(row.description || '—')}</td>
                <td>${escapeHtml(freebie ? tx('acct.payments.free') : formatMoney(row.amountCents, row.currency))}</td>
                <td>${escapeHtml(freebie ? tx('acct.payments.freebie') : known('acct.payment', row.status))}</td>
              </tr>`;
            })
            .join('');
        }
      }
    }
  }

  function markInvalid(ids, isError, msgId = 'account-msg') {
    for (const id of ids) {
      const field = document.getElementById(id);
      if (!field) continue;
      if (isError) {
        field.setAttribute('aria-invalid', 'true');
        field.setAttribute('aria-describedby', msgId);
      } else {
        field.removeAttribute('aria-invalid');
        field.removeAttribute('aria-describedby');
      }
    }
  }

  function bootAccount() {
    if (!document.getElementById('account-status')) return;
    if (typeof globalThis.wcagFillCsrfFields === 'function') globalThis.wcagFillCsrfFields();
    const params = new URLSearchParams(window.location.search);
    const err = params.get('error');
    if (err === 'csrf') {
      openDeleteConfirm(false);
      setMsg(tx('acct.delete.csrf'), true, 'delete-msg');
    } else if (err === 'delete') {
      openDeleteConfirm(false);
      setMsg(tx('acct.delete.wrongPassword'), true, 'delete-msg');
      markInvalid(['delete-password'], true, 'delete-msg');
    }
    const billingFlag = params.get('billing');
    if (billingFlag === 'success') showPaymentReceived();
    if (billingFlag === 'portal') {
      setMsg(tx('acct.sub.portalBack'), false, 'billing-portal-msg');
    }
    attachGuestIfPresent().finally(load);
  }

  /**
   * Back from Stripe: confirm at the top of the page, then show the new balance
   * as soon as the payment has been processed (it can take a few seconds).
   */
  function showPaymentReceived() {
    const panel = document.getElementById('billing-success');
    const text = document.getElementById('billing-success-text');
    if (!panel || !text) return;
    panel.hidden = false;
    panel.focus();
    // Drop ?billing=success so a reload does not start the wait again.
    const url = new URL(window.location.href);
    url.searchParams.delete('billing');
    history.replaceState(history.state, '', url.pathname + url.search + url.hash);
    watchPaymentLanding(({ balance, settled, timedOut }) => {
      if (settled && balance) {
        text.textContent = tx('acct.paid.now', { balance: balanceLong(balance) });
        announceBalanceChanged();
        load();
      } else if (timedOut) {
        text.textContent = balance
          ? tx('acct.paid.pendingWithBalance', { balance: balanceLong(balance) })
          : tx('acct.paid.pending');
      } else {
        text.textContent = tx('acct.paid.updating');
      }
    });
  }

  /** Show or hide the "delete your account?" step. Opening moves focus to it. */
  function openDeleteConfirm(moveFocus = true) {
    const card = document.getElementById('delete-card');
    const opener = document.getElementById('delete-open');
    if (!card) return;
    card.hidden = false;
    opener?.setAttribute('aria-expanded', 'true');
    if (moveFocus) document.getElementById('delete-title')?.focus();
  }

  function closeDeleteConfirm() {
    const card = document.getElementById('delete-card');
    const opener = document.getElementById('delete-open');
    if (!card) return;
    card.hidden = true;
    const form = document.getElementById('delete-form');
    if (form instanceof HTMLFormElement) form.reset();
    setMsg('', false, 'delete-msg');
    opener?.setAttribute('aria-expanded', 'false');
    opener?.focus();
  }

  if (!globalThis.__wcagAccountDelegated) {
    globalThis.__wcagAccountDelegated = true;
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('#delete-open')) {
        openDeleteConfirm();
        return;
      }
      if (target.closest('#delete-cancel')) {
        closeDeleteConfirm();
        return;
      }
      // Sidebar links: move focus to the section heading as well as scrolling.
      const anchor = target.closest('.account-nav a[href^="#"]');
      if (anchor) {
        const heading = document.getElementById(anchor.getAttribute('href').slice(1));
        if (heading) setTimeout(() => heading.focus({ preventScroll: true }), 0);
      }
    });
    document.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement) || target.name !== 'customerType' || !target.closest('#contact-form')) return;
      setAccountType(target.value);
    });
    document.addEventListener(
      'submit',
      async (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement)) return;
        if (form.id === 'contact-form') {
          event.preventDefault();
          event.stopPropagation();
          const body = Object.fromEntries(new FormData(form).entries());
          body.customerType = body.customerType === 'business' ? 'business' : 'consumer';
          const res = await fetch(api('/api/account'), {
            method: 'PUT',
            credentials: creds,
            headers: headers(),
            body: JSON.stringify(body),
          });
          const data = await res.json().catch(() => ({}));
          if (res.ok) setMsg(tx('acct.saved'), false, 'contact-msg');
          else serverMsg(data, 'acct.saveError', true, 'contact-msg');
          markInvalid([data.field === 'company' ? 'account-company' : 'account-first-name'], !res.ok, 'contact-msg');
          return;
        }
        if (form.id === 'password-form') {
          event.preventDefault();
          event.stopPropagation();
          const body = Object.fromEntries(new FormData(form).entries());
          const res = await fetch(api('/api/account/password'), {
            method: 'PUT',
            credentials: creds,
            headers: headers(),
            body: JSON.stringify(body),
          });
          const data = await res.json().catch(() => ({}));
          if (res.ok) setMsg(tx('acct.password.done'), false, 'password-msg');
          else serverMsg(data, 'acct.password.error', true, 'password-msg');
          markInvalid(['account-current-password', 'account-new-password'], !res.ok, 'password-msg');
          if (res.ok) form.reset();
          return;
        }
        if (form.id === 'email-form') {
          event.preventDefault();
          event.stopPropagation();
          const body = Object.fromEntries(new FormData(form).entries());
          const res = await fetch(api('/api/account/email'), {
            method: 'PUT',
            credentials: creds,
            headers: headers(),
            body: JSON.stringify(body),
          });
          const data = await res.json().catch(() => ({}));
          if (res.ok) setMsg(tx('acct.email.done'), false, 'email-msg');
          else serverMsg(data, 'acct.email.error', true, 'email-msg');
          markInvalid(['account-new-email', 'email-password'], !res.ok, 'email-msg');
          if (res.ok) form.reset();
          return;
        }
        if (form.id === 'delete-form') {
          event.preventDefault();
          event.stopPropagation();
          const body = Object.fromEntries(new FormData(form).entries());
          const res = await fetch(api('/api/account/delete'), {
            method: 'POST',
            credentials: creds,
            headers: headers(),
            body: JSON.stringify({ password: body.password }),
          });
          const data = await res.json().catch(() => ({}));
          if (res.ok) {
            window.location.href = '/';
            return;
          }
          serverMsg(data, 'acct.delete.error', true, 'delete-msg');
          markInvalid(['delete-password'], true, 'delete-msg');
        }
      },
      true
    );
    document.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (!target.closest('#manage-billing-btn')) return;
      try {
        const res = await fetch(api('/api/billing/portal'), { method: 'POST', credentials: creds, headers: headers() });
        const data = await res.json().catch(() => ({}));
        if (data.url) {
          window.location.href = data.url;
          return;
        }
        serverMsg(data, 'acct.sub.portalError', true, 'billing-portal-msg');
      } catch {
        setMsg(tx('acct.sub.portalNetwork'), true, 'billing-portal-msg');
      }
    });
    document.addEventListener('astro:page-load', bootAccount);
  }
  bootAccount();

</script>
