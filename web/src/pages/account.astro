---
import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/AppHeader.astro';
import { WITHDRAWAL_WAIVER_TEXT } from '../../../server/legal-versions.mjs';
import { formatVatInclusivePrice } from '../../../server/vat-display.mjs';

export const prerender = false;
const pack10Label = formatVatInclusivePrice(1000);
const pack50Label = formatVatInclusivePrice(4500);
const pack100Label = formatVatInclusivePrice(8000);
---
<Layout title="Account · Us" description="Manage your Us accessibility scanner account, usage, and billing." authMode="required">
  <div class="app-shell">
    <AppHeader crumb="Account" />
    <main id="main" class="app-main" tabindex="-1">
      <article class="container-narrow page-article">
        <h1>Account</h1>
        <p id="account-status" class="muted mt-1">Loading…</p>

        <section id="usage-card" class="card stack-form account-section" hidden>
          <h2>Subscription</h2>
          <p id="plan-name" class="muted"></p>
          <p id="plan-status" class="muted"></p>
          <div class="usage-bar" aria-hidden="true"><span id="usage-fill"></span></div>
          <p id="usage-label" class="muted"></p>
          <div id="billing-actions" class="guest-cta-row">
            <button type="button" class="btn btn-ghost" id="manage-billing-btn">Manage billing</button>
          </div>
          <p class="muted" style="font-size: 13px;">Cancel at the end of the billing period through Manage billing. You keep Pro until that date.</p>
        </section>

        <section id="tokens-card" class="card stack-form account-section" hidden>
          <h2>Tokens</h2>
          <p id="token-balance" class="muted"></p>
          <p class="muted" style="font-size: 13px;">Buy extra tokens for occasional scans or to continue after this month’s Pro pages. Packs expire after 12 months. Tick the immediate-delivery box first — it also covers Subscribe on this page.</p>
          <label class="legal-check">
            <input type="checkbox" id="withdrawal-waiver" name="withdrawalWaiver" value="true" />
            <span>{WITHDRAWAL_WAIVER_TEXT}</span>
          </label>
          <p id="account-billing-msg" class="muted" role="status" aria-live="polite"></p>
          <div id="subscribe-actions" class="guest-cta-row">
            <button type="button" class="btn btn-primary pricing-checkout" data-kind="pro" data-interval="monthly">Subscribe monthly</button>
            <button type="button" class="btn btn-ghost pricing-checkout" data-kind="pro" data-interval="yearly">Subscribe yearly</button>
          </div>
          <div class="guest-cta-row">
            <button type="button" class="btn btn-primary token-buy" data-pack="pack_10">Buy 10 · {pack10Label}</button>
            <button type="button" class="btn btn-primary token-buy" data-pack="pack_50">Buy 50 · {pack50Label}</button>
            <button type="button" class="btn btn-primary token-buy" data-pack="pack_100">Buy 100 · {pack100Label}</button>
            <a class="btn btn-secondary" href="https://about-us.be/contact/">Request Us services</a>
          </div>
        </section>

        <section id="contact-card" class="card stack-form account-section" hidden>
          <h2>Contact details</h2>
          <form id="contact-form" class="account-form" method="post" action="/account" data-astro-reload>
            <label>Name <input id="account-name" name="name" type="text" autocomplete="name" /></label>
            <label class="legal-check">
              <input type="checkbox" id="buying-for-business" name="buyingForBusiness" value="true" />
              <span>I'm buying for a business</span>
            </label>
            <div id="business-fields" hidden>
              <label>Company <input name="company" type="text" autocomplete="organization" /></label>
              <label>VAT number <input name="vatNumber" type="text" /></label>
            </div>
            <label>Phone <input name="phone" type="tel" autocomplete="tel" /></label>
            <label>
              Address
              <input name="addressLine1" type="text" autocomplete="address-line1" />
            </label>
            <label>
              Address line 2
              <input name="addressLine2" type="text" autocomplete="address-line2" />
            </label>
            <div class="account-form-row">
              <label>City <input name="city" type="text" autocomplete="address-level2" /></label>
              <label>Postal code <input name="postalCode" type="text" autocomplete="postal-code" /></label>
            </div>
            <label>Country <input name="country" type="text" autocomplete="country-name" /></label>
            <button type="submit" class="btn btn-primary">Save details</button>
          </form>
        </section>

        <section id="password-card" class="card stack-form account-section" hidden>
          <h2>Change password</h2>
          <form id="password-form" class="account-form" method="post" action="/account" data-astro-reload>
            <label>Current password <input id="account-current-password" name="currentPassword" type="password" autocomplete="current-password" required /></label>
            <label>New password <input id="account-new-password" name="password" type="password" autocomplete="new-password" minlength="10" required /></label>
            <button type="submit" class="btn btn-ghost">Update password</button>
          </form>
        </section>

        <section id="email-card" class="card stack-form account-section" hidden>
          <h2>Change email</h2>
          <form id="email-form" class="account-form" method="post" action="/api/account/email" data-astro-reload>
            <input type="hidden" name="csrfToken" class="wcag-csrf-field" value="" />
            <label>New email <input id="account-new-email" name="email" type="email" autocomplete="email" required /></label>
            <label>Current password <input id="email-password" name="password" type="password" autocomplete="current-password" required /></label>
            <button type="submit" class="btn btn-ghost">Send confirmation</button>
          </form>
        </section>

        <div id="account-projects" class="card stack-form account-section" hidden></div>

        <section id="scans-card" class="card stack-form account-section" hidden>
          <h2>Scan history</h2>
          <div class="table-wrap">
            <table class="account-table">
              <thead>
                <tr>
                  <th scope="col">Project</th>
                  <th scope="col">Date</th>
                  <th scope="col">Pages</th>
                  <th scope="col">Score</th>
                  <th scope="col">Status</th>
                </tr>
              </thead>
              <tbody id="scans-body"></tbody>
            </table>
          </div>
        </section>

        <section id="payments-card" class="card stack-form account-section" hidden>
          <h2>Payment history</h2>
          <p id="payments-empty" class="muted">No payments yet.</p>
          <div class="table-wrap" id="payments-table-wrap" hidden>
            <table class="account-table">
              <thead>
                <tr>
                  <th scope="col">Date</th>
                  <th scope="col">Description</th>
                  <th scope="col">Amount</th>
                  <th scope="col">Status</th>
                </tr>
              </thead>
              <tbody id="payments-body"></tbody>
            </table>
          </div>
        </section>

        <section id="delete-card" class="card stack-form account-section" hidden>
          <h2>Delete account</h2>
          <form id="delete-form" class="account-form" method="post" action="/api/account/delete" data-astro-reload>
            <input type="hidden" name="csrfToken" class="wcag-csrf-field" value="" />
            <p class="muted">This cannot be undone. Enter your current password to confirm.</p>
            <label>Current password <input id="delete-password" name="password" type="password" autocomplete="current-password" required /></label>
            <button type="submit" class="btn btn-ghost" id="delete-btn">Delete account</button>
          </form>
        </section>

        <div class="account-actions">
          <a class="btn btn-primary" href="/">Scan a page</a>
          <a class="btn btn-ghost" href="/api/account/export">Export JSON</a>
          <a class="btn btn-ghost" href="/api/account/export?format=csv">Export CSV</a>
        </div>
        <p id="account-msg" class="muted" role="status"></p>
      </article>
    </main>
  </div>
</Layout>
<script>
  const api = (p) => (typeof globalThis.wcagApiUrl === 'function' ? globalThis.wcagApiUrl(p) : p);
  const creds = typeof globalThis.wcagFetchCredentials === 'function' ? globalThis.wcagFetchCredentials() : 'same-origin';
  const headers = () =>
    typeof globalThis.wcagHeaders === 'function' ? globalThis.wcagHeaders({ 'Content-Type': 'application/json' }) : { 'Content-Type': 'application/json' };

  function setMsg(text, isError = false) {
    const billing = document.getElementById('account-billing-msg');
    const msg = billing || document.getElementById('account-msg');
    if (!msg) return;
    msg.textContent = text || '';
    msg.setAttribute('role', isError ? 'alert' : 'status');
    if (billing && billing !== document.getElementById('account-msg')) {
      const fallback = document.getElementById('account-msg');
      if (fallback && fallback !== billing) fallback.textContent = '';
    }
  }

  function fillForm(form, user) {
    if (!form || !user) return;
    for (const el of form.elements) {
      if (!el.name || user[el.name] == null) continue;
      if (el instanceof HTMLInputElement && el.type === 'checkbox') continue;
      el.value = user[el.name];
    }
    const business = document.getElementById('buying-for-business');
    const fields = document.getElementById('business-fields');
    const isBusiness = user.customerType === 'business';
    if (business instanceof HTMLInputElement) business.checked = isBusiness;
    if (fields) fields.hidden = !isBusiness;
  }

  function formatMoney(cents, currency) {
    const amount = Number(cents || 0) / 100;
    try {
      return new Intl.NumberFormat('en-GB', { style: 'currency', currency: (currency || 'eur').toUpperCase() }).format(amount);
    } catch {
      return `${amount.toFixed(2)} ${(currency || 'eur').toUpperCase()}`;
    }
  }

  async function attachGuestIfPresent() {
    const guest = new URLSearchParams(window.location.search).get('guest') || '';
    if (!guest) return;
    const res = await fetch(api('/api/account/attach-guest'), {
      method: 'POST',
      credentials: creds,
      headers: headers(),
      body: JSON.stringify({ guestToken: guest }),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) {
      setMsg(data.error || 'Could not attach that snapshot.', true);
      return;
    }
    setMsg(`Saved ${data.project?.domain || 'that snapshot'} to your projects.`);
  }

  async function load() {
    const res = await fetch(api('/api/account'), { credentials: creds });
    const data = await res.json().catch(() => ({}));
    const status = document.getElementById('account-status');
    const list = document.getElementById('account-projects');
    if (!res.ok) {
      if (status) status.textContent = data.error || 'Sign in first.';
      return;
    }
    if (status) status.textContent = `${data.user?.email || ''} · ${data.role}`;

      const usageCard = document.getElementById('usage-card');
      const tokensCard = document.getElementById('tokens-card');
      const contactCard = document.getElementById('contact-card');
      const passwordCard = document.getElementById('password-card');
      const emailCard = document.getElementById('email-card');
      const deleteCard = document.getElementById('delete-card');
      if (data.role === 'customer') {
        if (usageCard) usageCard.hidden = false;
        if (tokensCard) tokensCard.hidden = false;
        if (contactCard) contactCard.hidden = false;
        if (passwordCard) passwordCard.hidden = false;
        if (emailCard) emailCard.hidden = false;
        if (deleteCard) deleteCard.hidden = false;
        fillForm(document.getElementById('contact-form'), data.user);
        const planName = document.getElementById('plan-name');
        const planStatus = document.getElementById('plan-status');
        const usage = data.usage || {};
        const sub = data.subscription || {};
        const isPro = data.plan?.id === 'pro' && ['active', 'trialing', 'past_due'].includes(sub.status);
        const interval = sub.billingInterval === 'yearly' ? 'billed yearly' : 'billed monthly';
        if (planName) {
          planName.textContent = isPro ? `Pro · ${interval}` : 'No Pro subscription';
        }
        if (planStatus) {
          if (isPro && sub.cancelAtPeriodEnd && sub.currentPeriodEnd) {
            planStatus.textContent = `Cancels on ${new Date(sub.currentPeriodEnd).toLocaleDateString()} — you keep Pro until then.`;
          } else if (isPro && sub.currentPeriodEnd) {
            planStatus.textContent = `Active until ${new Date(sub.currentPeriodEnd).toLocaleDateString()}.`;
          } else {
            planStatus.textContent = 'Buy tokens or subscribe to Pro to run full scans.';
          }
        }
        const used = Number(usage.pagesScanned || 0);
        const max = isPro ? Number(usage.maxPagesPerMonth || 300) : 0;
        const pct = max ? Math.min(100, Math.round((used / max) * 100)) : 0;
        const fill = document.getElementById('usage-fill');
        if (fill) fill.style.width = max ? `${pct}%` : '0%';
        const usageLabel = document.getElementById('usage-label');
        if (usageLabel) {
          usageLabel.textContent = isPro
            ? `${used} of ${max} pages this month`
            : 'Pro pages apply after you subscribe.';
        }
        const tokenBalance = document.getElementById('token-balance');
        const tokensLeft = Number(data.tokens?.tokens || 0);
        const expires = data.tokens?.nextExpiresAt
          ? ` Next lot expires ${new Date(data.tokens.nextExpiresAt).toLocaleDateString()}.`
          : '';
        if (tokenBalance) tokenBalance.textContent = `${tokensLeft} token${tokensLeft === 1 ? '' : 's'} left.${expires}`;
        const subscribeActions = document.getElementById('subscribe-actions');
        if (subscribeActions) subscribeActions.hidden = isPro;
      }

    const projects = Array.isArray(data.projects) ? data.projects : [];
    if (list) {
      list.hidden = false;
      if (!projects.length) {
        list.innerHTML = '<h2>Projects</h2><p class="muted">No saved projects yet. Run a scan or attach a guest snapshot after signup. Each domain is one project; a subdomain is a new project.</p>';
      } else {
        list.innerHTML = `<h2>Projects</h2>${projects
          .map((p) => {
            const href = `/report/${encodeURIComponent(p.domain)}/history`;
            return `<p><a class="link" href="${href}">${p.domain}</a> · ${p.runIds?.length || 0} run(s)</p>`;
          })
          .join('')}`;
      }
    }

    const scans = Array.isArray(data.scans) ? data.scans : [];
    const scansCard = document.getElementById('scans-card');
    const scansBody = document.getElementById('scans-body');
    if (scansCard && scansBody) {
      scansCard.hidden = false;
      if (!scans.length) {
        scansBody.innerHTML = '<tr><td colspan="5" class="muted">No scans in this account yet.</td></tr>';
      } else {
        scansBody.innerHTML = scans
          .map((row) => {
            const href = row.run_id
              ? `/report/${encodeURIComponent(row.project_domain)}/${encodeURIComponent(row.run_id)}/`
              : `/report/${encodeURIComponent(row.project_domain)}/history`;
            const date = row.scan_date ? new Date(row.scan_date).toLocaleString() : '—';
            const score = row.score == null ? '—' : String(row.score);
            return `<tr>
              <td><a class="link" href="${href}">${row.project_domain}</a></td>
              <td>${date}</td>
              <td>${row.pages_scanned ?? '—'}</td>
              <td>${score}</td>
              <td>${row.status || '—'}</td>
            </tr>`;
          })
          .join('');
      }
    }

    const payments = Array.isArray(data.payments) ? data.payments : [];
    const paymentsCard = document.getElementById('payments-card');
    const paymentsEmpty = document.getElementById('payments-empty');
    const paymentsWrap = document.getElementById('payments-table-wrap');
    const paymentsBody = document.getElementById('payments-body');
    if (paymentsCard) {
      paymentsCard.hidden = false;
      if (!payments.length) {
        if (paymentsEmpty) paymentsEmpty.hidden = false;
        if (paymentsWrap) paymentsWrap.hidden = true;
      } else {
        if (paymentsEmpty) paymentsEmpty.hidden = true;
        if (paymentsWrap) paymentsWrap.hidden = false;
        if (paymentsBody) {
          paymentsBody.innerHTML = payments
            .map((row) => {
              const date = row.createdAt ? new Date(row.createdAt).toLocaleDateString() : '—';
              const freebie = row.status === 'freebie';
              return `<tr>
                <td>${date}</td>
                <td>${row.description || '—'}</td>
                <td>${freebie ? 'Free' : formatMoney(row.amountCents, row.currency)}</td>
                <td>${freebie ? 'Freebie' : row.status || '—'}</td>
              </tr>`;
            })
            .join('');
        }
      }
    }
  }

  function markInvalid(ids, isError) {
    for (const id of ids) {
      const field = document.getElementById(id);
      if (!field) continue;
      if (isError) {
        field.setAttribute('aria-invalid', 'true');
        field.setAttribute('aria-describedby', 'account-msg');
      } else {
        field.removeAttribute('aria-invalid');
        field.removeAttribute('aria-describedby');
      }
    }
  }

  function bootAccount() {
    if (!document.getElementById('account-status')) return;
    if (typeof globalThis.wcagFillCsrfFields === 'function') globalThis.wcagFillCsrfFields();
    const params = new URLSearchParams(window.location.search);
    const err = params.get('error');
    if (err === 'csrf') {
      setMsg('Could not confirm this request. Refresh the page and try Delete account again.', true);
    } else if (err === 'delete') {
      setMsg('Password is incorrect.', true);
      markInvalid(['delete-password'], true);
    }
    const billingFlag = params.get('billing');
    if (billingFlag === 'success') setMsg('Payment received. Tokens and Pro update as soon as Stripe confirms the webhook.');
    if (billingFlag === 'portal') setMsg('Back from billing. Subscription changes apply when Stripe confirms them.');
    attachGuestIfPresent().finally(load);
  }

  if (!globalThis.__wcagAccountDelegated) {
    globalThis.__wcagAccountDelegated = true;
    document.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement) || target.id !== 'buying-for-business') return;
      const fields = document.getElementById('business-fields');
      if (fields) fields.hidden = !target.checked;
    });
    document.addEventListener(
      'submit',
      async (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement)) return;
        if (form.id === 'contact-form') {
          event.preventDefault();
          event.stopPropagation();
          const body = Object.fromEntries(new FormData(form).entries());
          const business = document.getElementById('buying-for-business');
          body.buyingForBusiness = business instanceof HTMLInputElement && business.checked;
          body.customerType = body.buyingForBusiness ? 'business' : 'consumer';
          const res = await fetch(api('/api/account'), {
            method: 'PUT',
            credentials: creds,
            headers: headers(),
            body: JSON.stringify(body),
          });
          const data = await res.json().catch(() => ({}));
          setMsg(res.ok ? 'Details saved.' : data.error || 'Could not save details.', !res.ok);
          markInvalid(['account-name'], !res.ok);
          return;
        }
        if (form.id === 'password-form') {
          event.preventDefault();
          event.stopPropagation();
          const body = Object.fromEntries(new FormData(form).entries());
          const res = await fetch(api('/api/account/password'), {
            method: 'PUT',
            credentials: creds,
            headers: headers(),
            body: JSON.stringify(body),
          });
          const data = await res.json().catch(() => ({}));
          setMsg(res.ok ? 'Password updated.' : data.error || 'Could not update password.', !res.ok);
          markInvalid(['account-current-password', 'account-new-password'], !res.ok);
          if (res.ok) form.reset();
          return;
        }
        if (form.id === 'email-form') {
          event.preventDefault();
          event.stopPropagation();
          const body = Object.fromEntries(new FormData(form).entries());
          const res = await fetch(api('/api/account/email'), {
            method: 'PUT',
            credentials: creds,
            headers: headers(),
            body: JSON.stringify(body),
          });
          const data = await res.json().catch(() => ({}));
          setMsg(res.ok ? 'Confirmation sent to the new address.' : data.error || 'Could not change email.', !res.ok);
          markInvalid(['account-new-email', 'email-password'], !res.ok);
          if (res.ok) form.reset();
          return;
        }
        if (form.id === 'delete-form') {
          event.preventDefault();
          event.stopPropagation();
          const body = Object.fromEntries(new FormData(form).entries());
          const res = await fetch(api('/api/account/delete'), {
            method: 'POST',
            credentials: creds,
            headers: headers(),
            body: JSON.stringify({ password: body.password }),
          });
          const data = await res.json().catch(() => ({}));
          if (res.ok) {
            window.location.href = '/';
            return;
          }
          setMsg(data.error || 'Could not delete account.', true);
          markInvalid(['delete-password'], true);
        }
      },
      true
    );
    document.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (!target.closest('#manage-billing-btn')) return;
      try {
        const res = await fetch(api('/api/billing/portal'), { method: 'POST', credentials: creds, headers: headers() });
        const data = await res.json().catch(() => ({}));
        if (data.url) {
          window.location.href = data.url;
          return;
        }
        setMsg(data.error || 'Could not open the billing portal.', true);
      } catch {
        setMsg('Could not open the billing portal. Check your connection and try again.', true);
      }
    });
    document.addEventListener('astro:page-load', bootAccount);
  }
  bootAccount();

  function checkoutMessageEl() {
    return (
      document.getElementById('account-billing-msg') ||
      document.getElementById('pricing-msg') ||
      document.getElementById('account-msg')
    );
  }

  function showCheckoutMessage(text, isError = false) {
    const msg = checkoutMessageEl();
    if (!msg) return;
    msg.textContent = text || '';
    msg.setAttribute('role', isError ? 'alert' : 'status');
    if (msg.id === 'account-billing-msg') {
      const fallback = document.getElementById('account-msg');
      if (fallback && fallback !== msg) fallback.textContent = '';
    }
  }

  function checkoutBodyFromButton(btn) {
    const kind = btn.getAttribute('data-kind');
    if (kind === 'pro') {
      return { kind: 'pro', interval: btn.getAttribute('data-interval') || 'monthly', withdrawalWaiver: true };
    }
    const packId = btn.getAttribute('data-pack');
    if (kind === 'pack' || packId) {
      return { kind: 'pack', packId, withdrawalWaiver: true };
    }
    return null;
  }

  async function startCheckout(btn) {
    const waiver = document.getElementById('withdrawal-waiver');
    if (!(waiver instanceof HTMLInputElement) || !waiver.checked) {
      showCheckoutMessage('Tick the immediate-delivery box before checkout.', true);
      waiver?.focus?.();
      return;
    }
    const body = checkoutBodyFromButton(btn);
    if (!body) {
      showCheckoutMessage('Could not start checkout.', true);
      return;
    }
    btn.disabled = true;
    showCheckoutMessage('Starting checkout…');
    try {
      const auth = await fetch(api('/api/auth/status'), { credentials: creds }).then((r) => r.json()).catch(() => ({}));
      if (auth.authenticated !== true || auth.role !== 'customer') {
        const next = document.getElementById('pricing-msg') ? '/pricing' : '/account';
        window.location.href = `/signup?next=${next}`;
        return;
      }
      const res = await fetch(api('/api/billing/checkout'), {
        method: 'POST',
        credentials: creds,
        headers: headers(),
        body: JSON.stringify(body),
      });
      const data = await res.json().catch(() => ({}));
      if (data.url) {
        window.location.href = data.url;
        return;
      }
      showCheckoutMessage(data.error || 'Could not start checkout.', true);
    } catch {
      showCheckoutMessage('Could not start checkout. Check your connection and try again.', true);
    } finally {
      if (btn.isConnected) btn.disabled = false;
    }
  }

  // Same flag as pricing.astro so ClientRouter cannot leave Buy/Subscribe unbound.
  if (!globalThis.__wcagBillingCheckoutBound) {
    globalThis.__wcagBillingCheckoutBound = true;
    document.addEventListener(
      'click',
      (event) => {
        const target = event.target instanceof Element ? event.target : event.target?.parentElement;
        const btn = target?.closest?.('.pricing-checkout, .token-buy');
        if (!(btn instanceof HTMLButtonElement)) return;
        event.preventDefault();
        startCheckout(btn);
      },
      true
    );
  }
</script>
