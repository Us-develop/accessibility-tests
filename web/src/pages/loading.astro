---
import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/AppHeader.astro';
import ReportCrumbs from '../components/ReportCrumbs.astro';
import LoadingMonitor from '../components/LoadingMonitor.svelte';
import { usePageLang } from '../lib/page-lang.js';

export const prerender = false;
const tr = usePageLang(Astro);

const url = new URL(Astro.request.url);
const domain = url.searchParams.get('domain') || url.searchParams.get('id') || '';
const runId = url.searchParams.get('runId') || '';
const token = url.searchParams.get('token') || '';

if (!token && (!domain || !runId)) {
  // Tolerate the legacy ?id=domain shape: we cannot recover runId here, so render a soft error.
}
---

<Layout title={tr('loading.title', { site: domain || 'Us' })} description={tr('loading.description')} noindex={true} authMode="guest-ok">
  <div class="app-shell">
    <AppHeader crumb={tr('loading.crumb')} />
    <main id="main" class="app-main" tabindex="-1">
      <ReportCrumbs domain={domain || null} runId={runId || null} active={null} />
      {token ? (
        <LoadingMonitor client:only="svelte" guestToken={token} lang={tr.lang} />
      ) : domain && runId ? (
        <LoadingMonitor client:only="svelte" domain={domain} runId={runId} lang={tr.lang} />
      ) : (
        <div class="container-narrow" style="padding: clamp(32px, 6vw, 64px) 0;">
          <h1>{tr('loading.missing.h1')}</h1>
          <p class="p-large muted" style="margin-top: 12px;">
            {tr('loading.missing.before')} <a class="link" href="/">{tr('loading.missing.link')}</a> {tr('loading.missing.after')}
          </p>
        </div>
      )}
    </main>
  </div>
</Layout>
