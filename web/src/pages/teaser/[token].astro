---
import Layout from '../../layouts/Layout.astro';
import AppHeader from '../../components/AppHeader.astro';
import ResultsDashboard from '../../components/ResultsDashboard.svelte';
import GuestLeadForm from '../../components/GuestLeadForm.svelte';
import LoadingMonitor from '../../components/LoadingMonitor.svelte';
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { buildAstroMainReportPayload } from '../../../../report-astro-payload.js';
import { isValidReportId } from '../../../../server/fs-utils.js';
import { runDir, isValidRunId } from '../../../../server/run-ids.js';
import { dbPool, dbGetRunByGuestToken } from '../../../../server/db.js';
import { isValidGuestToken, readGuestTokenRecord } from '../../../../server/guest.mjs';
import { MANUAL_TODO_GROUPS } from '../../../../manual-checklist.js';

export const prerender = false;

const token = String(Astro.params.token || '');

/** @type {string | null} */
let loadError = null;
let pending = false;
/** @type {Record<string, unknown> | null} */
let dashboardProps = null;
let pageTitle = 'Your accessibility snapshot · Us';

function lockFixItems(items) {
  return (Array.isArray(items) ? items : []).map((item) => ({
    ...item,
    snippet: '',
    fixCode: '',
    fixCodeLanguage: undefined,
  }));
}

if (!isValidGuestToken(token)) {
  loadError = 'This snapshot link is invalid.';
} else {
  let binding = readGuestTokenRecord(token);
  if (!binding && dbPool) {
    try {
      const row = await dbGetRunByGuestToken(token);
      if (row) binding = { domain: row.domain, runId: row.runId, url: null };
    } catch {
      loadError = 'We could not look up this scan.';
    }
  }
  if (!loadError && !binding) {
    loadError = 'We could not find this scan.';
  } else if (!loadError && binding) {
    const domain = String(binding.domain || '');
    const runId = String(binding.runId || '');
    if (!isValidReportId(domain) || !isValidRunId(runId)) {
      loadError = 'This snapshot link is invalid.';
    } else {
      const resultsPath = join(runDir(domain, runId), 'accessibility-results.json');
      if (!existsSync(resultsPath)) {
        pending = true;
        pageTitle = 'Audit in progress · Us';
      } else {
        try {
          const json = JSON.parse(readFileSync(resultsPath, 'utf8'));
          const payload = buildAstroMainReportPayload(json);
          const principles = payload.principles || [];
          const disabilities = payload.disabilities || [];
          const lockedFixes = lockFixItems(payload.fixOrderItems || []);
          const suggestedFixes = payload.suggestedFixes || { points: 0, tickets: [] };
          const trendDate = payload.auditedDate?.slice(0, 6) || 'now';
          const manualTotal = MANUAL_TODO_GROUPS.reduce((s, g) => s + g.items.length, 0);
          pageTitle = `Accessibility snapshot · ${payload.primaryHost}`;
          dashboardProps = {
            primaryHost: payload.primaryHost,
            auditedDate: payload.auditedDate,
            scoreClamp: payload.scoreClamp,
            pass: payload.pass,
            fail: payload.fail,
            warn: payload.warn,
            info: payload.info,
            totalAxeViolations: payload.totalAxeViolations,
            totalAxePasses: payload.totalAxePasses,
            severityCounts: payload.severityCounts,
            trend: [{ date: trendDate, score: payload.scoreClamp }],
            pagesTable: payload.pagesTable,
            rulesTable: payload.rulesTable,
            fixOrderItems: lockedFixes,
            principles,
            disabilities,
            urls: payload.urls,
            reportData: {},
            domain,
            runId,
            sprintPoints: suggestedFixes.points,
            scoreAvailable: payload.scoreAvailable !== false,
            totalAxeIncomplete: payload.totalAxeIncomplete ?? 0,
            pagesScanned: payload.urls.length,
            rulesChecked: payload.rulesTable.length,
            previousScore: null,
            manualGroups: MANUAL_TODO_GROUPS,
            manualInitialChecked: [],
            manualTotal,
            autoPassed: payload.scoreBreakdown?.passed ?? 0,
            autoApplicable: payload.scoreBreakdown?.applicable ?? 0,
            coveredScCount: payload.coveredScCount ?? 0,
            locked: true,
          };
        } catch {
          loadError = 'Failed to read this snapshot.';
        }
      }
    }
  }
}
---

<Layout title={pageTitle} indexable={true} authMode="guest-ok">
  <div class="app-shell">
    <AppHeader crumb="Snapshot" />
    <main class="app-main">
      {loadError ? (
        <div class="container-narrow" style="padding: clamp(32px, 5vw, 56px) 0 clamp(48px, 8vw, 96px);">
          <div class="card" style="padding: 32px;">
            <h1 style="font-size: 28px; margin-bottom: 8px;">Snapshot unavailable</h1>
            <p class="muted">{loadError}</p>
            <p style="margin-top: 16px;"><a class="link" href="/">Try another URL</a></p>
          </div>
        </div>
      ) : pending ? (
        <LoadingMonitor client:only="svelte" guestToken={token} />
      ) : dashboardProps ? (
        <>
          <ResultsDashboard client:load {...dashboardProps} />
          <div class="container" style="padding: 0 32px 80px;">
            <GuestLeadForm client:load token={token} />
          </div>
        </>
      ) : (
        <div class="container-narrow" style="padding: clamp(32px, 5vw, 56px) 0;">
          <p class="muted">Could not load this snapshot.</p>
        </div>
      )}
    </main>
  </div>
</Layout>
