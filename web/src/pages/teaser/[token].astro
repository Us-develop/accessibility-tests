---
import Layout from '../../layouts/Layout.astro';
import AppHeader from '../../components/AppHeader.astro';
import ResultsDashboard from '../../components/ResultsDashboard.svelte';
import LoadingMonitor from '../../components/LoadingMonitor.svelte';
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { buildAstroMainReportPayload } from '../../../../report-astro-payload.js';
import { isValidReportId } from '../../../../server/fs-utils.js';
import { runDir, isValidRunId } from '../../../../server/run-ids.js';
import { dbPool, dbGetRunByGuestToken } from '../../../../server/db.js';
import { isValidGuestToken, readGuestTokenRecord } from '../../../../server/guest.mjs';
import { MANUAL_TODO_GROUPS } from '../../../../manual-checklist.js';
import { buildLockedDashboardData } from '../../../../server/teaser-payload.mjs';
import { usePageLang } from '../../lib/page-lang.js';

export const prerender = false;
const tr = usePageLang(Astro);

const token = String(Astro.params.token || '');

/** @type {string | null} */
let loadError = null;
let pending = false;
/** @type {Record<string, unknown> | null} */
let dashboardProps = null;
let pageTitle = tr('teaser.titleUnavailable');
let notFound = false;

if (!isValidGuestToken(token)) {
  notFound = true;
  loadError = tr('teaser.error.notFound');
} else {
  let binding = readGuestTokenRecord(token);
  if (!binding && dbPool) {
    try {
      const row = await dbGetRunByGuestToken(token);
      if (row) binding = { domain: row.domain, runId: row.runId, url: null };
    } catch {
      loadError = tr('teaser.error.load');
    }
  }
  if (!loadError && !binding) {
    notFound = true;
    loadError = tr('teaser.error.notFound');
  } else if (!loadError && binding) {
    const domain = String(binding.domain || '');
    const runId = String(binding.runId || '');
    if (!isValidReportId(domain) || !isValidRunId(runId)) {
      notFound = true;
      loadError = tr('teaser.error.notFound');
    } else {
      const resultsPath = join(runDir(domain, runId), 'accessibility-results.json');
      if (!existsSync(resultsPath)) {
        pending = true;
        pageTitle = tr('teaser.titlePending');
      } else {
        try {
          const json = JSON.parse(readFileSync(resultsPath, 'utf8'));
          const payload = buildAstroMainReportPayload(json, { lang: tr.lang });
          const principles = payload.principles || [];
          const disabilities = payload.disabilities || [];
          // Nothing real goes behind the blur: see buildLockedDashboardData.
          const lockedData = buildLockedDashboardData(payload, json);
          const suggestedFixes = payload.suggestedFixes || { points: 0, tickets: [] };
          const trendDate = payload.auditedDate?.slice(0, 6) || 'now';
          const manualTotal = MANUAL_TODO_GROUPS.reduce((s, g) => s + g.items.length, 0);
          pageTitle = tr('teaser.title', { site: payload.primaryHost || domain });
          dashboardProps = {
            primaryHost: payload.primaryHost || domain.replace(/^www\./, '') || tr('dash.thisScan'),
            auditedDate: payload.auditedDate,
            scoreClamp: payload.scoreClamp,
            pass: payload.pass,
            fail: payload.fail,
            warn: payload.warn,
            info: payload.info,
            totalAxeViolations: payload.totalAxeViolations,
            totalAxePasses: payload.totalAxePasses,
            severityCounts: payload.severityCounts,
            trend: [{ date: trendDate, score: payload.scoreClamp }],
            pagesTable: payload.pagesTable,
            rulesTable: lockedData.rulesTable,
            fixOrderItems: lockedData.fixOrderItems,
            topIssues: lockedData.topIssues,
            principles,
            disabilities,
            urls: payload.urls,
            reportData: {},
            domain,
            runId,
            sprintPoints: suggestedFixes.points,
            scoreAvailable: payload.scoreAvailable === true,
            pagesLoaded: payload.pagesLoaded === true,
            loadFailures: payload.loadFailures || [],
            totalAxeIncomplete: payload.totalAxeIncomplete ?? 0,
            pagesScanned: payload.urls.length,
            rulesChecked: payload.rulesTable.length,
            previousScore: null,
            manualGroups: MANUAL_TODO_GROUPS,
            manualInitialChecked: [],
            manualTotal,
            // Only the number of findings to review is needed for the score; the keys
            // would name rules and pages, so they are replaced by placeholders.
            scoreModel: {
              ...payload.scoreModel,
              reviewKeys: (payload.scoreModel?.reviewKeys || []).map((_, i) => `locked-${i}`),
            },
            coveredScCount: payload.coveredScCount ?? 0,
            locked: true,
            guestToken: token,
            lang: tr.lang,
          };
        } catch {
          loadError = tr('teaser.error.read');
        }
      }
    }
  }
}
if (notFound) {
  Astro.response.status = 404;
}
---

<Layout
  title={pageTitle}
  description={tr('teaser.description')}
  noindex={true}
  authMode="guest-ok"
>
  <div class="app-shell">
    <AppHeader crumb={tr('teaser.crumb')} />
    <main id="main" class="app-main" tabindex="-1">
      {loadError ? (
        <div class="container-narrow" style="padding-block: clamp(32px, 5vw, 56px) clamp(48px, 8vw, 96px);">
          <div class="card" style="padding: 32px;">
            <h1 style="font-size: 28px; margin-bottom: 8px;">{tr('teaser.unavailable')}</h1>
            <p class="muted">{loadError}</p>
            <p style="margin-top: 16px;"><a class="link" href="/">{tr('teaser.tryAnother')}</a></p>
          </div>
        </div>
      ) : pending ? (
        <LoadingMonitor client:only="svelte" guestToken={token} lang={tr.lang} />
      ) : dashboardProps ? (
        <>
          <ResultsDashboard client:load {...dashboardProps} />
          <div class="container teaser-cta">
            <div class="card teaser-unlock">
              <h2 style="font-size: 22px; margin: 0 0 8px;">{tr('teaser.next.h2')}</h2>
              <p class="muted">{tr('teaser.next.body')}</p>
              <div class="guest-cta-row">
                <a class="btn btn-primary" href="/pricing">{tr('teaser.next.report')}</a>
                <a class="btn btn-secondary" href={`/contact?source=teaser&guest=${encodeURIComponent(token)}`}>{tr('cta.expert')}</a>
              </div>
            </div>
          </div>
        </>
      ) : (
        <div class="container-narrow" style="padding-block: clamp(32px, 5vw, 56px);">
          <p class="muted">{tr('teaser.error.load')}</p>
        </div>
      )}
    </main>
  </div>
</Layout>
