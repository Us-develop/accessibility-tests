---
import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/AppHeader.astro';
import { customerLoginNext, isPricingNext } from '../../../server/login-redirect.mjs';
import { usePageLang } from '../lib/page-lang.js';

export const prerender = false;
const tr = usePageLang(Astro);
const guestToken = Astro.url.searchParams.get('guest') || '';
const requestedNext = Astro.url.searchParams.get('next') || '';
const nextPath = customerLoginNext(requestedNext);
const checkEmail = Astro.url.searchParams.get('check-email') === '1';
const signupError = Astro.url.searchParams.get('error') === '1';
const pricingArrival = isPricingNext(nextPath);
const lead = pricingArrival
  ? tr('signup.lead.pricing')
  : guestToken
    ? tr('signup.lead.guest')
    : tr('signup.lead.default');
const loginHref = `/login?next=${encodeURIComponent(nextPath)}`;
---
<Layout title={tr('signup.title')} description={tr('signup.description')} noindex={true} authMode="guest-ok">
  <div class="app-shell">
    <AppHeader crumb={tr('signup.crumb')} />
    <main id="main" class="app-main" tabindex="-1">
      <article class="container-narrow page-article">
        <h1>{checkEmail ? tr('signup.h1.checkEmail') : tr('signup.h1')}</h1>
        {checkEmail ? (
          <div id="signup-success" class="card stack-form" role="status">
            <p class="muted prose-width prose-lead">
              {tr('signup.check.body')}
            </p>
            {pricingArrival ? (
              <p class="muted prose-width">{tr('signup.check.pricing')}</p>
            ) : null}
            <p class="muted" style="font-size: 13px; margin: 0;">
              {tr('signup.check.already')} <a class="link" href={loginHref}>{tr('cta.signIn')}</a>.
            </p>
          </div>
        ) : (
          <>
        <p class="muted prose-width prose-lead" id="signup-lead">
          {lead}
        </p>
        <form id="signup-form" class="card stack-form" method="post" action="/api/auth/signup" autocomplete="on" data-astro-reload>
          {guestToken ? <input type="hidden" name="guestToken" value={guestToken} /> : null}
          {requestedNext ? <input type="hidden" name="next" id="signup-next" value={nextPath} /> : null}
          <div class="field">
            <label class="field-label" for="name">{tr('signup.name')}</label>
            <input class="input" id="name" name="name" autocomplete="name" />
          </div>
          <div class="field">
            <label class="field-label" for="email">{tr('signup.email')}</label>
            <input class="input" id="email" name="email" type="email" autocomplete="email" required />
            <p id="email-error" class="field-error" hidden></p>
          </div>
          <div class="field">
            <label class="field-label" for="password">{tr('signup.password')}</label>
            <input class="input" id="password" name="password" type="password" autocomplete="new-password" required minlength="10" />
            <p id="password-error" class="field-error" hidden></p>
          </div>
          <label class="legal-check">
            <input type="checkbox" id="buying-for-business" name="buyingForBusiness" value="true" />
            <span>{tr('signup.business')}</span>
          </label>
          <div id="business-fields" hidden>
            <div class="field">
              <label class="field-label" for="company">{tr('signup.company')}</label>
              <input class="input" id="company" name="company" autocomplete="organization" />
              <p id="company-error" class="field-error" hidden></p>
            </div>
            <div class="field">
              <label class="field-label" for="vatNumber">{tr('signup.vat')}</label>
              <input class="input" id="vatNumber" name="vatNumber" autocomplete="off" />
              <p id="vatNumber-error" class="field-error" hidden></p>
            </div>
          </div>
          <div class="field">
            <label class="legal-check">
              <input type="checkbox" id="accept-terms" name="acceptTerms" value="true" required />
              <span>
                {tr('signup.accept.before')}
                <a class="link" href="/terms" target="_blank" rel="noopener noreferrer">{tr('signup.accept.terms')}</a>
                {tr('signup.accept.middle')}
                <a class="link" href="/privacy" target="_blank" rel="noopener noreferrer">{tr('signup.accept.privacy')}</a>
              </span>
            </label>
            <p id="acceptTerms-error" class="field-error" hidden></p>
          </div>
          <button type="submit" class="btn btn-primary" id="signup-btn">{tr('signup.submit')}</button>
          <p id="signup-msg" class="muted" role={signupError ? 'alert' : 'status'}>
            {signupError ? tr('signup.error.query') : ''}
          </p>
          <p class="muted" style="font-size: 13px; margin: 0;">
            {tr('signup.haveAccount')} <button type="button" class="linklike" id="signup-open-login">{tr('signup.login')}</button>.
          </p>
        </form>
          </>
        )}
      </article>
    </main>
  </div>
</Layout>
<script>
  import { isSafeRelativePath } from '../../../server/safe-path.mjs';
  import { pageLang, t } from '../../../i18n/index.mjs';

  /** Server messages are English for now: mark them when the page is not. */
  function markServerText(el, fromServer) {
    if (!el) return;
    if (fromServer && pageLang() !== 'en') el.setAttribute('lang', 'en');
    else el.removeAttribute('lang');
  }

  if (!globalThis.__wcagSignupDelegated) {
    globalThis.__wcagSignupDelegated = true;
    const SIGNUP_FIELD_IDS = {
      email: 'email',
      password: 'password',
      company: 'company',
      vatNumber: 'vatNumber',
      acceptTerms: 'accept-terms',
    };
    function clearSignupFieldErrors() {
      for (const [field, inputId] of Object.entries(SIGNUP_FIELD_IDS)) {
        const input = document.getElementById(inputId);
        const hint = document.getElementById(`${field}-error`);
        if (input) {
          input.removeAttribute('aria-invalid');
          input.removeAttribute('aria-describedby');
        }
        if (hint) {
          hint.textContent = '';
          hint.hidden = true;
        }
      }
    }
    function showSignupFieldError(field, message) {
      const inputId = SIGNUP_FIELD_IDS[field];
      if (!inputId) return;
      if (field === 'company' || field === 'vatNumber') {
        const fields = document.getElementById('business-fields');
        if (fields) fields.hidden = false;
      }
      const input = document.getElementById(inputId);
      const hint = document.getElementById(`${field}-error`);
      if (hint) {
        hint.textContent = message;
        markServerText(hint, true);
        hint.hidden = false;
      }
      if (input) {
        input.setAttribute('aria-invalid', 'true');
        if (hint) input.setAttribute('aria-describedby', hint.id);
        input.focus();
      }
    }
    function signupQuery() {
      return new URLSearchParams(window.location.search);
    }
    function safeClientNext(raw, fallback) {
      const t = String(raw || '').trim();
      if (!isSafeRelativePath(t) || t === '/login') return fallback;
      return t;
    }
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element) || !target.closest('#signup-open-login')) return;
      const next = safeClientNext(signupQuery().get('next'), '/account');
      window.location.href = `/login?next=${encodeURIComponent(next)}`;
    });
    document.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement) || target.id !== 'buying-for-business') return;
      const fields = document.getElementById('business-fields');
      if (fields) fields.hidden = !target.checked;
    });
    document.addEventListener('submit', async (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || form.id !== 'signup-form') return;
      event.preventDefault();
      event.stopPropagation();
      const msg = document.getElementById('signup-msg');
      clearSignupFieldErrors();
      if (msg) {
        msg.textContent = '';
        msg.setAttribute('role', 'status');
      }
      const fd = new FormData(form);
      const api = typeof globalThis.wcagApiUrl === 'function' ? globalThis.wcagApiUrl : (p) => p;
      const creds = typeof globalThis.wcagFetchCredentials === 'function' ? globalThis.wcagFetchCredentials() : 'same-origin';
      const params = signupQuery();
      const guest = String(fd.get('guestToken') || params.get('guest') || '');
      const next = safeClientNext(fd.get('next') || params.get('next'), '/account');
      const res = await fetch(api('/api/auth/signup'), {
        method: 'POST',
        credentials: creds,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: fd.get('name'),
          email: fd.get('email'),
          password: fd.get('password'),
          guestToken: guest,
          next,
          acceptTerms: fd.get('acceptTerms') === 'true',
          buyingForBusiness: fd.get('buyingForBusiness') === 'true',
          company: fd.get('company'),
          vatNumber: fd.get('vatNumber'),
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        const error = data.error || t(pageLang(), 'signup.error.generic');
        if (msg) {
          msg.textContent = error;
          msg.setAttribute('role', 'alert');
          markServerText(msg, Boolean(data.error));
        }
        showSignupFieldError(data.field, error);
        return;
      }
      if (data.needsVerification) {
        const dest = new URLSearchParams();
        dest.set('check-email', '1');
        if (next && next !== '/account') dest.set('next', next);
        if (guest) dest.set('guest', guest);
        window.location.href = `/signup?${dest.toString()}`;
        return;
      }
      window.location.href = safeClientNext(data.next, next);
    }, true);
  }
</script>
