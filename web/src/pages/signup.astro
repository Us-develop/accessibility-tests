---
import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/AppHeader.astro';
import { customerLoginNext, isPricingNext } from '../../../server/login-redirect.mjs';
import { usePageLang } from '../lib/page-lang.js';

export const prerender = false;
const tr = usePageLang(Astro);
const guestToken = Astro.url.searchParams.get('guest') || '';
const requestedNext = Astro.url.searchParams.get('next') || '';
const nextPath = customerLoginNext(requestedNext);
const checkEmail = Astro.url.searchParams.get('check-email') === '1';
const signupError = Astro.url.searchParams.get('error') === '1';
const pricingArrival = isPricingNext(nextPath);
const lead = pricingArrival ? tr('signup.lead.pricing') : tr('signup.lead.default');
const loginHref = `/login?next=${encodeURIComponent(nextPath)}`;
---
<Layout title={tr('signup.title')} description={tr('signup.description')} noindex={true} authMode="guest-ok">
  <div class="app-shell">
    <AppHeader crumb={tr('signup.crumb')} />
    <main id="main" class="app-main" tabindex="-1">
      <article class="page-wrap">
        <div class="page-intro">
          <h1 class="page-title">{checkEmail ? tr('signup.h1.checkEmail') : tr('signup.h1')}</h1>
          {checkEmail ? null : <p class="page-lead" id="signup-lead">{lead}</p>}
        </div>
        {checkEmail ? (
          <div id="signup-success" class="panel signup-panel" role="status">
            <p class="page-lead">
              {tr('signup.check.body')}
            </p>
            {pricingArrival ? (
              <p>{tr('signup.check.pricing')}</p>
            ) : null}
            <p class="text-small">
              {tr('signup.check.already')} <a class="link" href={loginHref}>{tr('cta.signIn')}</a>.
            </p>
          </div>
        ) : (
        <form id="signup-form" class="panel signup-panel" method="post" action="/api/auth/signup" autocomplete="on" data-astro-reload>
          {guestToken ? <input type="hidden" name="guestToken" value={guestToken} /> : null}
          {requestedNext ? <input type="hidden" name="next" id="signup-next" value={nextPath} /> : null}
          <fieldset class="selector-group signup-type">
            <legend class="sr-only">{tr('signup.type.legend')}</legend>
            <label class="selector">
              <input type="radio" name="customerType" value="business" id="signup-type-business" />
              <span class="selector-box" aria-hidden="true"></span>
              <span class="selector-text">{tr('signup.type.business')}</span>
            </label>
            <label class="selector">
              <input type="radio" name="customerType" value="consumer" id="signup-type-consumer" checked />
              <span class="selector-box" aria-hidden="true"></span>
              <span class="selector-text">{tr('signup.type.consumer')}</span>
            </label>
          </fieldset>
          <div class="line-form">
            <div class="line-row">
              <div class="line-field">
                <label class="line-label" for="firstName">{tr('signup.firstName')}</label>
                <div class="line-control">
                  <input class="line-input" id="firstName" name="firstName" autocomplete="given-name" placeholder={tr('signup.firstName.placeholder')} required />
                </div>
                <p id="firstName-error" class="field-error" hidden></p>
              </div>
              <div class="line-field">
                <label class="line-label" for="lastName">{tr('signup.lastName')}</label>
                <div class="line-control">
                  <input class="line-input" id="lastName" name="lastName" autocomplete="family-name" placeholder={tr('signup.lastName.placeholder')} required />
                </div>
                <p id="lastName-error" class="field-error" hidden></p>
              </div>
            </div>
            <div class="line-row">
              <div class="line-field">
                <label class="line-label" for="email">{tr('signup.email')}</label>
                <div class="line-control">
                  <input class="line-input" id="email" name="email" type="email" autocomplete="email" placeholder={tr('signup.email.placeholder')} required />
                </div>
                <p id="email-error" class="field-error" hidden></p>
              </div>
              <div class="line-field">
                <div class="line-label">
                  <label for="password">{tr('signup.password')}</label>
                  <span id="password-hint" class="line-label-hint">{tr('signup.password.hint')}</span>
                </div>
                <div class="line-control">
                  <input class="line-input" id="password" name="password" type="password" autocomplete="new-password" required minlength="10" aria-describedby="password-hint" data-hint="password-hint" />
                  <button type="button" class="line-toggle" data-password-toggle="password" aria-pressed="false" aria-label={tr('signup.password.show')}>
                    <img src="/assets/icons/visibility.svg" width="16" height="16" alt="" />
                  </button>
                </div>
                <p id="password-error" class="field-error" hidden></p>
              </div>
            </div>
            <div class="line-row" id="business-fields" hidden>
              <div class="line-field">
                <label class="line-label" for="company">{tr('signup.company')}</label>
                <div class="line-control">
                  <input class="line-input" id="company" name="company" autocomplete="organization" placeholder={tr('signup.company.placeholder')} />
                </div>
                <p id="company-error" class="field-error" hidden></p>
              </div>
              <div class="line-field">
                <div class="line-label">
                  <label for="vatNumber">{tr('signup.vat')}</label>
                  <span id="vatNumber-hint" class="line-label-hint">{tr('signup.vat.hint')}</span>
                </div>
                <div class="line-control">
                  <input class="line-input" id="vatNumber" name="vatNumber" autocomplete="off" aria-describedby="vatNumber-hint" data-hint="vatNumber-hint" />
                </div>
                <p id="vatNumber-error" class="field-error" hidden></p>
              </div>
            </div>
          </div>
          <div class="signup-end">
            <div>
              <label class="selector">
                <input type="checkbox" id="accept-terms" name="acceptTerms" value="true" required />
                <span class="selector-box" aria-hidden="true"></span>
                <span>
                  {tr('signup.accept.before')}
                  <a href="/terms" target="_blank" rel="noopener noreferrer">{tr('signup.accept.terms')}</a>
                  {tr('signup.accept.middle')}
                  <a href="/privacy" target="_blank" rel="noopener noreferrer">{tr('signup.accept.privacy')}</a>{tr('signup.accept.after')}
                </span>
              </label>
              <p id="acceptTerms-error" class="field-error" hidden></p>
            </div>
            <button type="submit" class="btn btn-primary" id="signup-btn">
              {tr('signup.submit')}
              <img src="/assets/icons/arrow-circle-right-light.svg" width="20" height="20" alt="" />
            </button>
            <p id="signup-msg" class="muted" role={signupError ? 'alert' : 'status'}>
              {signupError ? tr('signup.error.query') : ''}
            </p>
            <p class="text-light">
              {tr('signup.haveAccount')} <button type="button" class="linklike" id="signup-open-login">{tr('signup.login')}</button>
            </p>
          </div>
        </form>
        )}
      </article>
    </main>
  </div>
</Layout>
<script>
  import { isSafeRelativePath } from '../../../server/safe-path.mjs';
  import { pageLang, serverMessageLang, t } from '../../../i18n/index.mjs';
  import { bindPasswordToggles } from '../lib/password-toggle.js';

  bindPasswordToggles();

  /** Mark a message written in another language than the page (some server messages are still English). */
  function markServerText(el, messageLang) {
    if (!el) return;
    if (messageLang && messageLang !== pageLang()) el.setAttribute('lang', messageLang);
    else el.removeAttribute('lang');
  }

  if (!globalThis.__wcagSignupDelegated) {
    globalThis.__wcagSignupDelegated = true;
    const SIGNUP_FIELD_IDS = {
      firstName: 'firstName',
      lastName: 'lastName',
      email: 'email',
      password: 'password',
      company: 'company',
      vatNumber: 'vatNumber',
      acceptTerms: 'accept-terms',
    };
    function clearSignupFieldErrors() {
      for (const [field, inputId] of Object.entries(SIGNUP_FIELD_IDS)) {
        const input = document.getElementById(inputId);
        const hint = document.getElementById(`${field}-error`);
        if (input) {
          input.removeAttribute('aria-invalid');
          // Back to the field's own hint ("Optional", "At least 10 characters"), if it has one.
          if (input.dataset.hint) input.setAttribute('aria-describedby', input.dataset.hint);
          else input.removeAttribute('aria-describedby');
        }
        if (hint) {
          hint.textContent = '';
          hint.hidden = true;
        }
      }
    }
    function showSignupFieldError(field, message, messageLang = '') {
      const inputId = SIGNUP_FIELD_IDS[field];
      if (!inputId) return;
      if (field === 'company' || field === 'vatNumber') {
        const fields = document.getElementById('business-fields');
        if (fields) fields.hidden = false;
      }
      const input = document.getElementById(inputId);
      const hint = document.getElementById(`${field}-error`);
      if (hint) {
        hint.textContent = message;
        markServerText(hint, messageLang);
        hint.hidden = false;
      }
      if (input) {
        input.setAttribute('aria-invalid', 'true');
        if (hint) input.setAttribute('aria-describedby', [hint.id, input.dataset.hint].filter(Boolean).join(' '));
        input.focus();
      }
    }
    function signupQuery() {
      return new URLSearchParams(window.location.search);
    }
    function safeClientNext(raw, fallback) {
      const t = String(raw || '').trim();
      if (!isSafeRelativePath(t) || t === '/login') return fallback;
      return t;
    }
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element) || !target.closest('#signup-open-login')) return;
      const next = safeClientNext(signupQuery().get('next'), '/account');
      window.location.href = `/login?next=${encodeURIComponent(next)}`;
    });
    document.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement) || target.name !== 'customerType' || !target.closest('#signup-form')) return;
      const fields = document.getElementById('business-fields');
      if (fields) fields.hidden = target.value !== 'business';
    });
    document.addEventListener('submit', async (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || form.id !== 'signup-form') return;
      event.preventDefault();
      event.stopPropagation();
      const msg = document.getElementById('signup-msg');
      clearSignupFieldErrors();
      if (msg) {
        msg.textContent = '';
        msg.setAttribute('role', 'status');
      }
      const fd = new FormData(form);
      const api = typeof globalThis.wcagApiUrl === 'function' ? globalThis.wcagApiUrl : (p) => p;
      const creds = typeof globalThis.wcagFetchCredentials === 'function' ? globalThis.wcagFetchCredentials() : 'same-origin';
      const params = signupQuery();
      const guest = String(fd.get('guestToken') || params.get('guest') || '');
      const next = safeClientNext(fd.get('next') || params.get('next'), '/account');
      const res = await fetch(api('/api/auth/signup'), {
        method: 'POST',
        credentials: creds,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          firstName: fd.get('firstName'),
          lastName: fd.get('lastName'),
          email: fd.get('email'),
          password: fd.get('password'),
          guestToken: guest,
          next,
          acceptTerms: fd.get('acceptTerms') === 'true',
          customerType: fd.get('customerType') === 'business' ? 'business' : 'consumer',
          company: fd.get('company'),
          vatNumber: fd.get('vatNumber'),
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        const error = data.error || t(pageLang(), 'signup.error.generic');
        if (msg) {
          msg.textContent = error;
          msg.setAttribute('role', 'alert');
          markServerText(msg, data.error ? serverMessageLang(data) : '');
        }
        showSignupFieldError(data.field, error, data.error ? serverMessageLang(data) : '');
        return;
      }
      if (data.needsVerification) {
        const dest = new URLSearchParams();
        dest.set('check-email', '1');
        if (next && next !== '/account') dest.set('next', next);
        if (guest) dest.set('guest', guest);
        window.location.href = `/signup?${dest.toString()}`;
        return;
      }
      window.location.href = safeClientNext(data.next, next);
    }, true);
  }
</script>
<style>
  .signup-panel {
    max-width: var(--text-max);
    display: grid;
    gap: 24px;
    padding: 48px;
  }
  .signup-end {
    display: grid;
    gap: 16px;
    justify-items: start;
    margin-top: 24px;
  }
  .signup-end .field-error { margin-top: 4px; }
  #signup-msg:empty { display: none; }
  @media (max-width: 720px) {
    .signup-panel { padding: 32px 16px; }
  }
</style>
