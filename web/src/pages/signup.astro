---
import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/AppHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { langFromAstro } from '../lib/page-lang.mjs';

export const prerender = false;
const lang = langFromAstro(Astro);
const nl = lang === 'nl';
---
<Layout title={nl ? 'Account maken · Us' : 'Create account · Us'} indexable={true} authMode="guest-ok">
  <div class="app-shell">
    <AppHeader crumb={nl ? 'Account maken' : 'Create account'} />
    <main class="app-main">
      <article class="container-narrow page-article">
        <h1>{nl ? 'Account maken' : 'Create account'}</h1>
        <p class="muted prose-width prose-lead">
          {nl
            ? 'Daarna kun je Pro nemen. Gratis snapshots blijven beschikbaar zonder account.'
            : 'Then you can subscribe to Pro. Free snapshots stay available without an account.'}
        </p>
        <form id="signup-form" class="card stack-form">
          <div class="field">
            <label class="field-label" for="name">{nl ? 'Naam' : 'Name'}</label>
            <input class="input" id="name" name="name" autocomplete="name" />
          </div>
          <div class="field">
            <label class="field-label" for="email">Email</label>
            <input class="input" id="email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label class="field-label" for="password">{nl ? 'Wachtwoord (min. 10 tekens)' : 'Password (min. 10 characters)'}</label>
            <input class="input" id="password" name="password" type="password" autocomplete="new-password" required minlength="10" />
          </div>
          <label class="check">
            <input type="checkbox" name="agree" required />
            <span class="box"></span>
            <span>
              {nl ? 'Ik ga akkoord met de' : 'I agree to the'}
              <a class="link" href="/terms">{nl ? 'voorwaarden' : 'terms'}</a>
              {nl ? 'en het' : 'and'}
              <a class="link" href="/privacy">privacy</a>
              {nl ? 'beleid. De dienst mag onmiddellijk starten.' : 'policy. The service may start immediately.'}
            </span>
          </label>
          <button type="submit" class="btn btn-primary" id="signup-btn">{nl ? 'Account maken' : 'Create account'}</button>
          <p id="signup-msg" class="muted" role="status"></p>
        </form>
      </article>
    </main>
    <SiteFooter lang={lang} />
  </div>
</Layout>
<script>
  document.getElementById('signup-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget;
    const msg = document.getElementById('signup-msg');
    const fd = new FormData(form);
    const api = typeof globalThis.wcagApiUrl === 'function' ? globalThis.wcagApiUrl : (p) => p;
    const creds = typeof globalThis.wcagFetchCredentials === 'function' ? globalThis.wcagFetchCredentials() : 'same-origin';
    const guest = new URLSearchParams(window.location.search).get('guest') || '';
    const res = await fetch(api('/api/auth/signup'), {
      method: 'POST',
      credentials: creds,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        name: fd.get('name'),
        email: fd.get('email'),
        password: fd.get('password'),
        guestToken: guest,
      }),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) {
      if (msg) msg.textContent = data.error || 'Could not create account.';
      return;
    }
    window.location.href = data.needsVerification ? '/pricing' : '/account';
  });
</script>
