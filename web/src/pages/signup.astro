---
import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/AppHeader.astro';

export const prerender = false;
const guestToken = Astro.url.searchParams.get('guest') || '';
const checkEmail = Astro.url.searchParams.get('check-email') === '1';
const signupError = Astro.url.searchParams.get('error') === '1';
---
<Layout title="Create account · Us" indexable={true} authMode="guest-ok">
  <div class="app-shell">
    <AppHeader crumb="Create account" />
    <main class="app-main">
      <article class="container-narrow page-article">
        <h1>Create account</h1>
        <p class="muted prose-width prose-lead">
          Save guest snapshots to your email. The public 1-page check stays free without an account.
        </p>
        <form id="signup-form" class="card stack-form" method="post" action="/api/auth/signup" autocomplete="on" data-astro-reload>
          {guestToken ? <input type="hidden" name="guestToken" value={guestToken} /> : null}
          <div class="field">
            <label class="field-label" for="name">Name</label>
            <input class="input" id="name" name="name" autocomplete="name" />
          </div>
          <div class="field">
            <label class="field-label" for="email">Email</label>
            <input class="input" id="email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label class="field-label" for="password">Password (min. 10 characters)</label>
            <input class="input" id="password" name="password" type="password" autocomplete="new-password" required minlength="10" />
          </div>
          <button type="submit" class="btn btn-primary" id="signup-btn">Create account</button>
          <p id="signup-msg" class="muted" role="status">
            {checkEmail
              ? 'Check your email to verify the account, then sign in.'
              : signupError
                ? 'Could not create account. Try a different email, or log in if you already have one.'
                : ''}
          </p>
          <p class="muted" style="font-size: 13px; margin: 0;">
            Already have an account? Use <button type="button" class="linklike" id="signup-open-login">Log in</button>.
          </p>
        </form>
      </article>
    </main>
  </div>
</Layout>
<script>
  if (!globalThis.__wcagSignupDelegated) {
    globalThis.__wcagSignupDelegated = true;
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element) || !target.closest('#signup-open-login')) return;
      document.dispatchEvent(new CustomEvent('wcag:open-login'));
    });
    document.addEventListener('submit', async (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || form.id !== 'signup-form') return;
      event.preventDefault();
      event.stopPropagation();
      const msg = document.getElementById('signup-msg');
      const fd = new FormData(form);
      const api = typeof globalThis.wcagApiUrl === 'function' ? globalThis.wcagApiUrl : (p) => p;
      const creds = typeof globalThis.wcagFetchCredentials === 'function' ? globalThis.wcagFetchCredentials() : 'same-origin';
      const guest = String(fd.get('guestToken') || new URLSearchParams(window.location.search).get('guest') || '');
      const res = await fetch(api('/api/auth/signup'), {
        method: 'POST',
        credentials: creds,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: fd.get('name'),
          email: fd.get('email'),
          password: fd.get('password'),
          guestToken: guest,
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        if (msg) msg.textContent = data.error || 'Could not create account.';
        return;
      }
      if (data.needsVerification) {
        if (msg) msg.textContent = 'Check your email to verify the account, then sign in.';
        return;
      }
      window.location.href = '/account';
    }, true);
  }
</script>
