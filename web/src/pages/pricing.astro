---
import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/AppHeader.astro';
import { NONE_PLAN_ID, PRO_PLAN_ID, TOKEN_PACKS, planFeatureList } from '../../../server/plan-catalog.mjs';
import { billingPublicConfig } from '../../../server/stripe.mjs';
import { formatVatInclusivePrice } from '../../../server/vat-display.mjs';
import { WITHDRAWAL_WAIVER_TEXT } from '../../../server/legal-versions.mjs';

export const prerender = false;
const canceled = Astro.url.searchParams.get('billing') === 'cancel';
const pack10 = TOKEN_PACKS.find((p) => p.id === 'pack_10');
const pack50 = TOKEN_PACKS.find((p) => p.id === 'pack_50');
const pack100 = TOKEN_PACKS.find((p) => p.id === 'pack_100');
const unitPrice = formatVatInclusivePrice(100);
const pack10Price = formatVatInclusivePrice(pack10?.priceCents || 1000);
const pack50Price = formatVatInclusivePrice(pack50?.priceCents || 4500);
const pack100Price = formatVatInclusivePrice(pack100?.priceCents || 8000);
const proMonth = formatVatInclusivePrice(4900);
const proYear = formatVatInclusivePrice(49000);
const siteOrigin = String(Astro.site ?? 'https://wcag.about-us.be').replace(/\/$/, '');
const tokenFeatures = planFeatureList(NONE_PLAN_ID);
const proFeatures = planFeatureList(PRO_PLAN_ID);
// What can actually be bought right now. A button whose price is not connected
// to Stripe would only answer "503"; say so instead of offering it.
const billing = await billingPublicConfig();
const packReady = Object.fromEntries(billing.packs.map((pack) => [pack.id, pack.checkoutReady]));
const anyPackReady = billing.packs.some((pack) => pack.checkoutReady);
const proMonthlyReady = billing.pro.checkoutReadyMonthly;
const proYearlyReady = billing.pro.checkoutReadyYearly;
const proReady = proMonthlyReady || proYearlyReady;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Us accessibility scanner',
  description: 'Automated WCAG 2.2 AA snapshots, token packs, and a Pro subscription for full reports.',
  brand: { '@type': 'Organization', name: 'Us' },
  url: `${siteOrigin}/pricing`,
  offers: [
    {
      '@type': 'Offer',
      name: 'Gratis snapshot',
      price: '0',
      priceCurrency: 'EUR',
      url: `${siteOrigin}/`,
    },
    ...TOKEN_PACKS.map((pack) => ({
      '@type': 'Offer',
      name: pack.name,
      price: ((pack.priceCents || 0) / 100).toFixed(2),
      priceCurrency: 'EUR',
      url: `${siteOrigin}/pricing#tokens`,
    })),
    {
      '@type': 'Offer',
      name: 'Pro monthly',
      price: (4900 / 100).toFixed(2),
      priceCurrency: 'EUR',
      url: `${siteOrigin}/pricing#pro`,
    },
    {
      '@type': 'Offer',
      name: 'Pro yearly',
      price: (49000 / 100).toFixed(2),
      priceCurrency: 'EUR',
      url: `${siteOrigin}/pricing#pro`,
    },
  ],
};
---
<Layout
  title="Pricing · Us accessibility scanner"
  description="Gratis snapshot, token packs, Pro subscription, and Us-diensten. Prices in EUR including VAT."
  noindex={false}
  authMode="guest-ok"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <div class="app-shell">
    <AppHeader crumb="Pricing" />
    <main id="main" class="app-main" tabindex="-1">
      <article class="container-narrow page-article">
        <span class="eyebrow"><span class="dot"></span>Prices incl. VAT · EUR</span>
        <h1>Gratis snapshot, tokens, Pro, or Us-diensten</h1>
        <p class="muted p-large prose-width prose-lead">
          Scan one public page for free. Buy tokens for occasional full reports, subscribe to Pro for monthly page-scans,
          or ask Us for manual testing and remediation.
        </p>
        <p id="pricing-msg" class="muted" role="status" aria-live="polite">{canceled ? 'Checkout was cancelled. No charge was made.' : ''}</p>

        <div id="pricing-grid" class="pricing-grid">
          <section class="card pricing-card" id="gratis">
            <h2>Gratis snapshot</h2>
            <p class="pricing-price">€ 0</p>
            <p class="muted">1 public URL. Score and the top 3 issues. One free snapshot per person — guest or signed in, not both. After that, buy tokens or subscribe.</p>
            <div class="pricing-cta">
              <a class="btn btn-ghost" href="/">Scan this page for free</a>
            </div>
          </section>

          <section class="card pricing-card" id="tokens" data-checkout-scope>
            <h2>Tokens</h2>
            <p class="pricing-price">{unitPrice} <span>per URL-scan</span></p>
            <p class="muted">Pay per page, no subscription. 1 token = 1 URL. Minimum 10. Unused tokens expire after 12 months.</p>
            <ul class="pricing-packs">
              <li>10 tokens · {pack10Price}</li>
              <li>50 tokens · {pack50Price} (−10%)</li>
              <li>100 tokens · {pack100Price} (−20%)</li>
            </ul>
            <h3 style="font-size: 16px; margin: 16px 0 8px;">Each scan includes</h3>
            <ul class="pricing-packs" style="list-style: none; padding-left: 0;">
              {tokenFeatures.map((feature) => (
                <li class={feature.included ? undefined : 'muted'}>
                  <span aria-hidden="true">{feature.included ? '✓' : '–'}</span>
                  {feature.included ? feature.label : `${feature.label}: Pro only`}
                </li>
              ))}
            </ul>
            {anyPackReady ? (
              <Fragment>
                <label class="legal-check" style="margin-top: 16px;">
                  <input type="checkbox" class="checkout-waiver" id="withdrawal-waiver-tokens" name="withdrawalWaiver" value="true" />
                  <span>{WITHDRAWAL_WAIVER_TEXT}</span>
                </label>
                <p class="checkout-msg muted" role="status" aria-live="polite"></p>
                <div class="pricing-cta pricing-pack-actions">
                  {packReady.pack_10 ? <button type="button" class="btn btn-primary pricing-checkout" data-kind="pack" data-pack="pack_10">Buy 10</button> : null}
                  {packReady.pack_50 ? <button type="button" class="btn btn-primary pricing-checkout" data-kind="pack" data-pack="pack_50">Buy 50</button> : null}
                  {packReady.pack_100 ? <button type="button" class="btn btn-primary pricing-checkout" data-kind="pack" data-pack="pack_100">Buy 100</button> : null}
                </div>
              </Fragment>
            ) : (
              <p class="muted" role="status">
                Token packs cannot be bought online yet. <a class="link" href="/contact?source=pricing">Contact Us</a> and we will set you up.
              </p>
            )}
          </section>

          <section class="card pricing-card" id="pro" data-checkout-scope>
            <h2>Pro</h2>
            <p class="pricing-price">{proMonth} <span>/ month</span></p>
            <p class="muted">or {proYear} / year (2 months free). 300 page-scans a month, up to 50 URLs per run, one scan at a time, unlimited own projects, email support.</p>
            <h3 style="font-size: 16px; margin: 16px 0 8px;">Each scan includes</h3>
            <ul class="pricing-packs" style="list-style: none; padding-left: 0;">
              {proFeatures.map((feature) => (
                <li class={feature.included ? undefined : 'muted'}>
                  <span aria-hidden="true">{feature.included ? '✓' : '–'}</span>
                  {feature.label}
                </li>
              ))}
            </ul>
            {proReady ? (
              <Fragment>
                <label class="legal-check" style="margin-top: 16px;">
                  <input type="checkbox" class="checkout-waiver" id="withdrawal-waiver-pro" name="withdrawalWaiver" value="true" />
                  <span>{WITHDRAWAL_WAIVER_TEXT}</span>
                </label>
                <p class="checkout-msg muted" role="status" aria-live="polite"></p>
                <div class="pricing-cta">
                  {proMonthlyReady ? <button type="button" class="btn btn-primary pricing-checkout" data-kind="pro" data-interval="monthly">Subscribe monthly</button> : null}
                  {proYearlyReady ? <button type="button" class="btn btn-ghost pricing-checkout" data-kind="pro" data-interval="yearly">Subscribe yearly</button> : null}
                </div>
              </Fragment>
            ) : (
              <p class="muted" role="status">
                Pro cannot be bought online yet. <a class="link" href="/contact?source=pricing">Contact Us</a> and we will set you up.
              </p>
            )}
          </section>

          <section class="card pricing-card" id="us-diensten">
            <h2>Us-diensten</h2>
            <p class="pricing-price">Quote only</p>
            <p class="muted">Manual AT testing, remediation, legally oriented statement, and training. No Stripe checkout — we scope this with you.</p>
            <div class="pricing-cta">
              <a class="btn btn-secondary" href="/contact?source=pricing">Talk to a WCAG expert</a>
            </div>
          </section>
        </div>

        <p class="muted" style="font-size: 13px; max-width: 640px; margin-top: 24px;">
          Businesses outside Belgium with a valid EU VAT number are charged without VAT under the reverse-charge rule. Belgian businesses pay 21 % VAT. Prices shown include Belgian VAT; consumers in other EU countries see their local rate at checkout.
        </p>
      </article>
    </main>
  </div>
</Layout>
<script>
  import { bindCheckout, resumeCheckout } from '../lib/checkout.js';

  bindCheckout();
  // Returning from sign-up with ?checkout=<item>: continue the purchase.
  if (!globalThis.__wcagPricingResumeBound) {
    globalThis.__wcagPricingResumeBound = true;
    document.addEventListener('astro:page-load', () => {
      if (window.location.pathname === '/pricing') resumeCheckout();
    });
  }
</script>
