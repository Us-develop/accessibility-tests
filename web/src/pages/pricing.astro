---
import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/AppHeader.astro';
import { MAX_PAGES_PER_CUSTOMER_RUN, NONE_PLAN_ID, PRO_PAGES_PER_MONTH, PRO_PLAN_ID, TOKEN_PACKS, planFeatureList } from '../../../server/plan-catalog.mjs';
import { billingPublicConfig } from '../../../server/stripe.mjs';
import { usePageLang } from '../lib/page-lang.js';
import { formatVatInclusivePrice } from '../../../server/vat-display.mjs';
import { WITHDRAWAL_WAIVER_TEXT } from '../../../server/legal-versions.mjs';

export const prerender = false;
const tr = usePageLang(Astro);
// The waiver is recorded in English, the binding language. Other languages get
// the English sentence plus a note with a translation.
const waiverNote = tr.lang === 'en' ? '' : tr('checkout.waiver.note');
const canceled = Astro.url.searchParams.get('billing') === 'cancel';
const pack10 = TOKEN_PACKS.find((p) => p.id === 'pack_10');
const pack50 = TOKEN_PACKS.find((p) => p.id === 'pack_50');
const pack100 = TOKEN_PACKS.find((p) => p.id === 'pack_100');
const unitPrice = formatVatInclusivePrice(100);
const pack10Price = formatVatInclusivePrice(pack10?.priceCents || 1000);
const pack50Price = formatVatInclusivePrice(pack50?.priceCents || 4500);
const pack100Price = formatVatInclusivePrice(pack100?.priceCents || 8000);
const proMonth = formatVatInclusivePrice(4900);
const proYear = formatVatInclusivePrice(49000);
const siteOrigin = String(Astro.site ?? 'https://wcag.about-us.be').replace(/\/$/, '');
const tokenFeatures = planFeatureList(NONE_PLAN_ID);
const proFeatures = planFeatureList(PRO_PLAN_ID);
const proLimits = [
  tr('pricing.pro.pages', { n: PRO_PAGES_PER_MONTH }),
  tr('pricing.pro.perRun', { n: MAX_PAGES_PER_CUSTOMER_RUN }),
  tr('pricing.pro.oneAtATime'),
  tr('pricing.pro.projects'),
  tr('pricing.pro.support'),
];
// What can actually be bought right now. A button whose price is not connected
// to Stripe would only answer "503"; say so instead of offering it.
const billing = await billingPublicConfig();
const packReady = Object.fromEntries(billing.packs.map((pack) => [pack.id, pack.checkoutReady]));
const anyPackReady = billing.packs.some((pack) => pack.checkoutReady);
const proMonthlyReady = billing.pro.checkoutReadyMonthly;
const proYearlyReady = billing.pro.checkoutReadyYearly;
const proReady = proMonthlyReady || proYearlyReady;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Us accessibility scanner',
  description: 'Automated WCAG 2.2 AA snapshots, token packs, and a Pro subscription for full reports.',
  brand: { '@type': 'Organization', name: 'Us' },
  url: `${siteOrigin}/pricing`,
  offers: [
    {
      '@type': 'Offer',
      name: 'Free scan',
      price: '0',
      priceCurrency: 'EUR',
      url: `${siteOrigin}/`,
    },
    ...TOKEN_PACKS.map((pack) => ({
      '@type': 'Offer',
      name: pack.name,
      price: ((pack.priceCents || 0) / 100).toFixed(2),
      priceCurrency: 'EUR',
      url: `${siteOrigin}/pricing#tokens`,
    })),
    {
      '@type': 'Offer',
      name: 'Pro monthly',
      price: (4900 / 100).toFixed(2),
      priceCurrency: 'EUR',
      url: `${siteOrigin}/pricing#pro`,
    },
    {
      '@type': 'Offer',
      name: 'Pro yearly',
      price: (49000 / 100).toFixed(2),
      priceCurrency: 'EUR',
      url: `${siteOrigin}/pricing#pro`,
    },
  ],
};
---
<Layout
  title={tr('pricing.title')}
  description={tr('pricing.description')}
  noindex={false}
  authMode="guest-ok"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <div class="app-shell">
    <AppHeader crumb={tr('pricing.crumb')} />
    <main id="main" class="app-main" tabindex="-1">
      <article class="container-narrow page-article">
        <span class="eyebrow"><span class="dot"></span>{tr('pricing.eyebrow')}</span>
        <h1>{tr('pricing.h1')}</h1>
        <p class="muted p-large prose-width prose-lead">{tr('pricing.lead')}</p>
        <p id="pricing-msg" class="muted" role="status" aria-live="polite">{canceled ? tr('pricing.canceled') : ''}</p>

        <div id="pricing-grid" class="pricing-grid">
          <section class="card pricing-card" id="gratis">
            <h2>{tr('pricing.free.h2')}</h2>
            <p class="pricing-price">€ 0</p>
            <p class="muted">{tr('pricing.free.body')}</p>
            <div class="pricing-cta">
              <a class="btn btn-ghost" href="/">{tr('pricing.free.cta')}</a>
            </div>
          </section>

          <section class="card pricing-card" id="tokens" data-checkout-scope>
            <h2>{tr('pricing.tokens.h2')}</h2>
            <p class="pricing-price">{unitPrice} <span>{tr('pricing.tokens.unit')}</span></p>
            <p class="muted">{tr('pricing.tokens.body')}</p>
            <ul class="pricing-packs">
              <li>{tr('pricing.tokens.pack', { n: 10, price: pack10Price })}</li>
              <li>{tr('pricing.tokens.pack', { n: 50, price: pack50Price })}</li>
              <li>{tr('pricing.tokens.pack', { n: 100, price: pack100Price })}</li>
            </ul>
            <h3 style="font-size: 16px; margin: 16px 0 8px;">{tr('pricing.includes')}</h3>
            <ul class="pricing-packs" style="list-style: none; padding-left: 0;">
              {tokenFeatures.map((feature) => (
                <li class={feature.included ? undefined : 'muted'}>
                  <span aria-hidden="true">{feature.included ? '✓' : '–'}</span>
                  {feature.included ? tr(`feature.${feature.key}`) : tr('pricing.proOnly', { feature: tr(`feature.${feature.key}`) })}
                </li>
              ))}
            </ul>
            {anyPackReady ? (
              <Fragment>
                <label class="legal-check" style="margin-top: 16px;">
                  <input type="checkbox" class="checkout-waiver" id="withdrawal-waiver-tokens" name="withdrawalWaiver" value="true" aria-describedby={waiverNote ? 'waiver-note-tokens' : undefined} />
                  <span lang={tr.lang === 'en' ? undefined : 'en'}>{WITHDRAWAL_WAIVER_TEXT}</span>
                </label>
                {waiverNote ? <p id="waiver-note-tokens" class="muted" style="font-size: 12px;">{waiverNote}</p> : null}
                <p class="checkout-msg muted" role="status" aria-live="polite"></p>
                <div class="pricing-cta pricing-pack-actions">
                  {packReady.pack_10 ? <button type="button" class="btn btn-primary pricing-checkout" data-kind="pack" data-pack="pack_10">{tr('pricing.tokens.buy', { n: 10 })}</button> : null}
                  {packReady.pack_50 ? <button type="button" class="btn btn-primary pricing-checkout" data-kind="pack" data-pack="pack_50">{tr('pricing.tokens.buy', { n: 50 })}</button> : null}
                  {packReady.pack_100 ? <button type="button" class="btn btn-primary pricing-checkout" data-kind="pack" data-pack="pack_100">{tr('pricing.tokens.buy', { n: 100 })}</button> : null}
                </div>
              </Fragment>
            ) : (
              <p class="muted" role="status">
                {tr('pricing.tokens.unavailable')} <a class="link" href="/contact?source=pricing">{tr('cta.contactUs')}</a> {tr('pricing.unavailable.contact')}
              </p>
            )}
          </section>

          <section class="card pricing-card" id="pro" data-checkout-scope>
            <h2>{tr('pricing.pro.h2')}</h2>
            <p class="pricing-price">{proMonth} <span>{tr('pricing.pro.perMonth')}</span></p>
            <p class="muted">{tr('pricing.pro.yearlyNote', { yearly: proYear })}</p>
            <ul class="pricing-packs" style="list-style: none; padding-left: 0;">
              {proLimits.map((label) => (
                <li><span aria-hidden="true">✓</span> {label}</li>
              ))}
              {proFeatures.map((feature) => (
                <li class={feature.included ? undefined : 'muted'}>
                  <span aria-hidden="true">{feature.included ? '✓' : '–'}</span>
                  {tr(`feature.${feature.key}`)}
                </li>
              ))}
            </ul>
            {proReady ? (
              <Fragment>
                <label class="legal-check" style="margin-top: 16px;">
                  <input type="checkbox" class="checkout-waiver" id="withdrawal-waiver-pro" name="withdrawalWaiver" value="true" aria-describedby={waiverNote ? 'waiver-note-pro' : undefined} />
                  <span lang={tr.lang === 'en' ? undefined : 'en'}>{WITHDRAWAL_WAIVER_TEXT}</span>
                </label>
                {waiverNote ? <p id="waiver-note-pro" class="muted" style="font-size: 12px;">{waiverNote}</p> : null}
                <p class="checkout-msg muted" role="status" aria-live="polite"></p>
                <div class="pricing-cta">
                  {proMonthlyReady ? <button type="button" class="btn btn-primary pricing-checkout" data-kind="pro" data-interval="monthly">{tr('pricing.pro.monthly')}</button> : null}
                  {proYearlyReady ? <button type="button" class="btn btn-ghost pricing-checkout" data-kind="pro" data-interval="yearly">{tr('pricing.pro.yearly')}</button> : null}
                </div>
              </Fragment>
            ) : (
              <p class="muted" role="status">
                {tr('pricing.pro.unavailable')} <a class="link" href="/contact?source=pricing">{tr('cta.contactUs')}</a> {tr('pricing.unavailable.contact')}
              </p>
            )}
          </section>

          <section class="card pricing-card" id="us-diensten">
            <h2>{tr('pricing.services.h2')}</h2>
            <p class="muted">{tr('pricing.services.body')}</p>
            <div class="pricing-cta">
              <a class="btn btn-secondary" href="/contact?source=pricing">{tr('cta.expert')}</a>
            </div>
          </section>
        </div>

        <p class="muted" style="font-size: 13px; max-width: 640px; margin-top: 24px;">{tr('pricing.vatNote')}</p>
      </article>
    </main>
  </div>
</Layout>
<script>
  import { bindCheckout, resumeCheckout } from '../lib/checkout.js';

  bindCheckout();
  // Returning from sign-up with ?checkout=<item>: continue the purchase.
  if (!globalThis.__wcagPricingResumeBound) {
    globalThis.__wcagPricingResumeBound = true;
    document.addEventListener('astro:page-load', () => {
      if (window.location.pathname === '/pricing') resumeCheckout();
    });
  }
</script>
