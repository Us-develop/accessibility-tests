---
import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/AppHeader.astro';
import { TOKEN_PACKS } from '../../../server/plan-catalog.mjs';
import { centsWithVat, formatVatInclusivePrice } from '../../../server/vat-display.mjs';
import { WITHDRAWAL_WAIVER_TEXT } from '../../../server/legal-versions.mjs';

export const prerender = false;
const canceled = Astro.url.searchParams.get('billing') === 'cancel';
const pack10 = TOKEN_PACKS.find((p) => p.id === 'pack_10');
const pack50 = TOKEN_PACKS.find((p) => p.id === 'pack_50');
const pack100 = TOKEN_PACKS.find((p) => p.id === 'pack_100');
const unitPrice = formatVatInclusivePrice(100);
const pack10Price = formatVatInclusivePrice(pack10?.priceCents || 1000);
const pack50Price = formatVatInclusivePrice(pack50?.priceCents || 4500);
const pack100Price = formatVatInclusivePrice(pack100?.priceCents || 8000);
const proMonth = formatVatInclusivePrice(4900);
const proYear = formatVatInclusivePrice(49000);
const siteOrigin = String(Astro.site ?? 'https://wcag.about-us.be').replace(/\/$/, '');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Us accessibility scanner',
  description: 'Automated WCAG 2.2 AA snapshots, token packs, and a Pro subscription for full reports.',
  brand: { '@type': 'Organization', name: 'Us' },
  url: `${siteOrigin}/pricing`,
  offers: [
    {
      '@type': 'Offer',
      name: 'Gratis snapshot',
      price: '0',
      priceCurrency: 'EUR',
      url: `${siteOrigin}/`,
    },
    ...TOKEN_PACKS.map((pack) => ({
      '@type': 'Offer',
      name: pack.name,
      price: (centsWithVat(pack.priceCents) / 100).toFixed(2),
      priceCurrency: 'EUR',
      url: `${siteOrigin}/pricing#tokens`,
    })),
    {
      '@type': 'Offer',
      name: 'Pro monthly',
      price: (centsWithVat(4900) / 100).toFixed(2),
      priceCurrency: 'EUR',
      url: `${siteOrigin}/pricing#pro`,
    },
    {
      '@type': 'Offer',
      name: 'Pro yearly',
      price: (centsWithVat(49000) / 100).toFixed(2),
      priceCurrency: 'EUR',
      url: `${siteOrigin}/pricing#pro`,
    },
  ],
};
---
<Layout
  title="Pricing · Us accessibility scanner"
  description="Gratis snapshot, token packs, Pro subscription, and Us-diensten. Prices in EUR including VAT."
  noindex={false}
  authMode="guest-ok"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <div class="app-shell">
    <AppHeader crumb="Pricing" />
    <main id="main" class="app-main" tabindex="-1">
      <article class="container-narrow page-article">
        <span class="eyebrow"><span class="dot"></span>Prices incl. VAT · EUR</span>
        <h1>Gratis snapshot, tokens, Pro, or Us-diensten</h1>
        <p class="muted p-large prose-width prose-lead">
          Scan one public page for free. Buy tokens for occasional full reports, subscribe to Pro for monthly page-scans,
          or ask Us for manual testing and remediation.
        </p>
        <p id="pricing-msg" class="muted" role="status">{canceled ? 'Checkout was cancelled. No charge was made.' : ''}</p>
        <label class="legal-check" style="max-width: 640px; margin: 0 0 20px;">
          <input type="checkbox" id="withdrawal-waiver" name="withdrawalWaiver" value="true" />
          <span>{WITHDRAWAL_WAIVER_TEXT}</span>
        </label>

        <div id="pricing-grid" class="pricing-grid">
          <section class="card pricing-card" id="gratis">
            <h2>Gratis snapshot</h2>
            <p class="pricing-price">€ 0</p>
            <p class="muted">1 public URL. Score and the top 3 issues. One free snapshot per person — guest or signed in, not both. After that, buy tokens or subscribe.</p>
            <div class="pricing-cta">
              <a class="btn btn-ghost" href="/">Scan this page for free</a>
            </div>
          </section>

          <section class="card pricing-card" id="tokens">
            <h2>Tokens</h2>
            <p class="pricing-price">{unitPrice} <span>per URL-scan</span></p>
            <p class="muted">Pay-per-scan packs. 1 token = 1 URL. Minimum 10. Unused tokens expire after 12 months. Full Pro deliverables for each spent token.</p>
            <ul class="pricing-packs">
              <li>10 tokens · {pack10Price}</li>
              <li>50 tokens · {pack50Price} (−10%)</li>
              <li>100 tokens · {pack100Price} (−20%)</li>
            </ul>
            <div class="pricing-cta pricing-pack-actions">
              <button type="button" class="btn btn-primary pricing-checkout" data-kind="pack" data-pack="pack_10">Buy 10</button>
              <button type="button" class="btn btn-primary pricing-checkout" data-kind="pack" data-pack="pack_50">Buy 50</button>
              <button type="button" class="btn btn-primary pricing-checkout" data-kind="pack" data-pack="pack_100">Buy 100</button>
            </div>
          </section>

          <section class="card pricing-card" id="pro">
            <h2>Pro</h2>
            <p class="pricing-price">{proMonth} <span>/ month</span></p>
            <p class="muted">or {proYear} / year (2 months free). 300 page-scans/month, max 50 URLs per run, 1 concurrent scan, unlimited own projects, email support. Full UI: dashboard, history, statement, sales deck, developer guide, manual checklist, Jira.</p>
            <div class="pricing-cta">
              <button type="button" class="btn btn-primary pricing-checkout" data-kind="pro" data-interval="monthly">Subscribe monthly</button>
              <button type="button" class="btn btn-ghost pricing-checkout" data-kind="pro" data-interval="yearly">Subscribe yearly</button>
            </div>
          </section>

          <section class="card pricing-card" id="us-diensten">
            <h2>Us-diensten</h2>
            <p class="pricing-price">Quote only</p>
            <p class="muted">Manual AT testing, remediation, legally oriented statement, and training. No Stripe checkout — we scope this with you.</p>
            <div class="pricing-cta">
              <a class="btn btn-secondary" href="https://about-us.be/contact/">Talk to a WCAG expert</a>
            </div>
          </section>
        </div>

        <p class="muted" style="font-size: 13px; max-width: 640px; margin-top: 24px;">
          Businesses outside Belgium with a valid EU VAT number are charged without VAT under the reverse-charge rule. Belgian businesses pay 21 % VAT. Prices shown include Belgian VAT; consumers in other EU countries see their local rate at checkout.
        </p>
      </article>
    </main>
  </div>
</Layout>
<script>
  const api = (p) => (typeof globalThis.wcagApiUrl === 'function' ? globalThis.wcagApiUrl(p) : p);
  const creds = typeof globalThis.wcagFetchCredentials === 'function' ? globalThis.wcagFetchCredentials() : 'same-origin';
  const headers = () =>
    typeof globalThis.wcagHeaders === 'function' ? globalThis.wcagHeaders({ 'Content-Type': 'application/json' }) : { 'Content-Type': 'application/json' };

  async function startCheckout(btn) {
    const msg = document.getElementById('pricing-msg');
    const waiver = document.getElementById('withdrawal-waiver');
    if (!(waiver instanceof HTMLInputElement) || !waiver.checked) {
      if (msg) msg.textContent = 'Tick the immediate-delivery box before checkout.';
      return;
    }
    const kind = btn.getAttribute('data-kind');
    const body =
      kind === 'pack'
        ? { kind: 'pack', packId: btn.getAttribute('data-pack'), withdrawalWaiver: true }
        : { kind: 'pro', interval: btn.getAttribute('data-interval') || 'monthly', withdrawalWaiver: true };
    btn.disabled = true;
    const auth = await fetch(api('/api/auth/status'), { credentials: creds }).then((r) => r.json()).catch(() => ({}));
    if (auth.authenticated !== true || auth.role !== 'customer') {
      window.location.href = '/signup?next=/pricing';
      return;
    }
    const res = await fetch(api('/api/billing/checkout'), {
      method: 'POST',
      credentials: creds,
      headers: headers(),
      body: JSON.stringify(body),
    });
    const data = await res.json().catch(() => ({}));
    if (data.url) {
      window.location.href = data.url;
      return;
    }
    if (msg) msg.textContent = data.error || 'Could not start checkout.';
    btn.disabled = false;
  }

  document.querySelectorAll('.pricing-checkout').forEach((btn) => {
    btn.addEventListener('click', () => startCheckout(btn));
  });
</script>
