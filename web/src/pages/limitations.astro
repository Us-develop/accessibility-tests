---
import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/AppHeader.astro';
import { usePageLang } from '../lib/page-lang.js';

export const prerender = false;
const tr = usePageLang(Astro);
const faq = [1, 2, 3, 4].map((n) => ({
  '@type': 'Question',
  name: tr(`lim.faq.q${n}`),
  acceptedAnswer: { '@type': 'Answer', text: tr(`lim.faq.a${n}`) },
}));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: tr.lang,
  mainEntity: faq,
};
---

<Layout
  title={tr('lim.title')}
  description={tr('lim.description')}
  noindex={false}
  authMode="guest-ok"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <div class="app-shell">
    <AppHeader crumb={tr('lim.crumb')} />
    <main id="main" class="app-main" tabindex="-1">
      <article class="container-narrow" style="padding: clamp(32px, 5vw, 56px) 0 clamp(48px, 8vw, 96px);">
        <span class="eyebrow"><span class="dot"></span>WCAG 2.2 AA · EN 301 549</span>
        <h1 style="font-size: clamp(32px, 4.5vw, 48px); margin: 12px 0 16px;">{tr('lim.h1')}</h1>
        <p class="p-large muted" style="max-width: 640px;">{tr('lim.lead')}</p>

        <section style="margin-top: 40px;">
          <h2 style="font-size: 22px; margin-bottom: 10px;">{tr('lim.run.h')}</h2>
          <ul class="muted" style="padding-left: 20px; display: flex; flex-direction: column; gap: 8px; max-width: 640px;">
            <li>{tr('lim.run.1')}</li>
            <li>{tr('lim.run.2')}</li>
            <li>{tr('lim.run.3')}</li>
          </ul>
        </section>

        <section style="margin-top: 32px;">
          <h2 style="font-size: 22px; margin-bottom: 10px;">{tr('lim.cannot.h')}</h2>
          <ul class="muted" style="padding-left: 20px; display: flex; flex-direction: column; gap: 8px; max-width: 640px;">
            <li>{tr('lim.cannot.1')}</li>
            <li>{tr('lim.cannot.2')}</li>
            <li>{tr('lim.cannot.3')}</li>
            <li>{tr('lim.cannot.4')}</li>
            <li>{tr('lim.cannot.5')}</li>
          </ul>
        </section>

        <section style="margin-top: 32px;">
          <h2 style="font-size: 22px; margin-bottom: 10px;">{tr('lim.score.h')}</h2>
          <p class="muted" style="max-width: 640px;">{tr('lim.score.body')}</p>
          <p class="muted" style="max-width: 640px;">{tr('lim.score.caveat')}</p>
        </section>

        <section style="margin-top: 32px;">
          <h2 style="font-size: 22px; margin-bottom: 10px;">{tr('lim.eaa.h')}</h2>
          <p class="muted" style="max-width: 640px;">{tr('lim.eaa.body')}</p>
        </section>

        <p style="margin-top: 40px;">
          <a class="btn btn-primary" href="/">{tr('lim.cta')}</a>
        </p>
      </article>
    </main>
  </div>
</Layout>
