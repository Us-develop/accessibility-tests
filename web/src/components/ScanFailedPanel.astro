---
import { translator } from '../../../i18n/index.mjs';

interface Props {
  domain: string;
  runId: string;
  primaryHost?: string;
  loadFailures?: Array<{ url?: string; message?: string }>;
  title?: string;
  /** Language of the page around it; pages not translated yet pass nothing. */
  lang?: string;
}

const { domain, runId, primaryHost = '', loadFailures = [], lang = 'en' } = Astro.props;
const tr = translator(lang);
const title = Astro.props.title || tr('failed.title');

const host = primaryHost || domain.replace(/^www\./, '') || tr('dash.thisScan');
const reportHref = `/report/${encodeURIComponent(domain)}/${encodeURIComponent(runId)}/`;
---

<div class="container-narrow" style="padding: clamp(32px, 5vw, 56px) 0 80px;">
  <a class="btn btn-ghost btn-sm" href={reportHref}>{tr('cov.back')}</a>
  <h1 style="font-size: clamp(28px, 4vw, 40px); margin: 18px 0 10px;">{title}</h1>
  <p class="muted" style="max-width: 640px;">
    {tr('failed.before')} <strong>{host}</strong>{tr('failed.after')}
  </p>
  {loadFailures.length > 0 ? (
    <ul style="margin: 16px 0; padding-left: 18px;">
      {loadFailures.map((row) => (
        <li style="font-size: 14px; margin-bottom: 6px;">
          <code>{row.url}</code>
          {row.message ? <span lang={lang === 'en' ? undefined : 'en'}>{` — ${row.message}`}</span> : ''}
        </li>
      ))}
    </ul>
  ) : null}
  <p style="margin-top: 20px;">
    <a class="btn btn-primary" href={reportHref}>{tr('failed.view')}</a>
  </p>
</div>
