---
import { chromeTranslator } from '../lib/page-lang.js';
import { LANGS } from '../../../i18n/index.mjs';

interface Props {
  /** Not shown since the floating header; kept so pages can still pass it. */
  crumb?: string;
}

const tr = chromeTranslator(Astro);
// Language switch: a small form, so it works without JavaScript and is not a GET.
const backTo = `${Astro.url.pathname}${Astro.url.search}`;
const LANG_NAMES: Record<string, string> = { nl: 'Nederlands', en: 'English' };

const access = Astro.locals?.access;
const sessionHint = access?.role === 'staff' || access?.role === 'customer';
const isCustomer = access?.role === 'customer';
const onHome = Astro.url.pathname === '/';
const firstName = String(access?.firstName || '').trim();
const greeting = firstName ? tr('header.greeting', { name: firstName }) : tr('header.account');
---

<header class="app-header" data-screen-label="App header">
  <div class="app-header-inner">
    <a class="brand" href="/" aria-label={tr('header.home')}>
      <img src="/assets/icons/logo-us-light.svg" width="66" height="32" alt="" />
    </a>

    <details class="app-header-nav">
      <summary class="app-header-menu-toggle" aria-label={tr('header.menu')}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </summary>
      <div class="app-header-chrome">
        <a class="nav-cta" href="/" aria-current={onHome ? 'page' : undefined}><img src="/assets/icons/plus.svg" width="24" height="24" alt="" />{tr('header.startScan')}</a>
        <a class="nav-link" href="/pricing" aria-current={Astro.url.pathname === '/pricing' ? 'page' : undefined}>{tr('header.pricing')}</a>
        <span class="nav-divider" aria-hidden="true"></span>
        <a class="nav-link wcag-header-signup" href="/signup" aria-current={Astro.url.pathname === '/signup' ? 'page' : undefined}>{tr('header.signup')}</a>
        <button type="button" class="nav-link wcag-header-login" id="wcag-header-login">
          {tr('header.login')}
        </button>
        {/* Signed in: the greeting opens the account menu. */}
        <details class="nav-account wcag-header-account">
          <summary class="nav-link">
            {greeting}
            <img src="/assets/icons/chevron-down-light.svg" width="20" height="20" alt="" />
          </summary>
          <div class="nav-account-menu">
            {/* Every scan of the signed-in account. The site name in the crumbs leads to that site's history. */}
            <a
              class="nav-menu-item btn-all-scans wcag-header-account"
              href="/audits"
              aria-current={Astro.url.pathname === '/audits' ? 'page' : undefined}
            >
              {tr('header.allScans')}
            </a>
            <a class="nav-menu-item" href="/account" aria-current={Astro.url.pathname === '/account' ? 'page' : undefined}>{tr('header.account')}</a>
            <div id="wcag-session-bar" class="wcag-session-bar" hidden={!sessionHint}>
              <button type="button" id="wcag-logout-btn" class="nav-menu-item wcag-session-logout">
                {tr('header.logout')}
              </button>
            </div>
          </div>
        </details>
        <form class="wcag-lang-switch" method="post" action="/lang" role="group" aria-label={tr('header.lang.label')} data-astro-reload>
          <input type="hidden" name="next" value={backTo} />
          {LANGS.map((code) => (
            <button
              type="submit"
              class="nav-link"
              name="lang"
              value={code}
              lang={code}
              aria-pressed={Astro.locals?.lang === code ? 'true' : 'false'}
            >
              <span aria-hidden="true">{code.toUpperCase()}</span>
              <span class="sr-only">{LANG_NAMES[code]}</span>
            </button>
          ))}
        </form>
      </div>
    </details>
    <a
      class="nav-balance wcag-header-balance"
      id="wcag-header-balance"
      href="/account#tokens"
      data-customer={isCustomer ? '1' : undefined}
      hidden
    ><span class="nav-balance-value"></span><img src="/assets/icons/star-pink.svg" width="16" height="16" alt="" /></a>
  </div>

</header>

<script>
  import { balanceLong, balanceShort, fetchBalance } from '../lib/balance.js';
  import { pageLang, t } from '../../../i18n/index.mjs';

  /** Fill the balance link for a signed-in customer; keep it hidden for everyone else. */
  async function refreshHeaderBalance(force = false) {
    const el = document.getElementById('wcag-header-balance');
    if (!el) return;
    if (!force && el.dataset.customer !== '1') {
      el.hidden = true;
      return;
    }
    const balance = await fetchBalance();
    if (!balance) {
      el.hidden = true;
      return;
    }
    el.dataset.customer = '1';
    // The number of tokens with a star; Pro adds the pages left this month.
    const value = el.querySelector('.nav-balance-value');
    if (value) value.textContent = balance.pro ? balanceShort(balance) : String(balance.tokens);
    el.setAttribute('aria-label', t(pageLang(), 'header.balance.label', { balance: balanceLong(balance) }));
    el.hidden = false;
  }

  function syncHeaderNav() {
    document.querySelectorAll('details.app-header-nav').forEach((el) => {
      if (!(el instanceof HTMLDetailsElement)) return;
      if (window.matchMedia('(min-width: 961px)').matches) el.open = true;
    });
  }

  /** Close the open header menus, except the one that holds `keep`. */
  function closeHeaderMenus(keep = null) {
    document.querySelectorAll('.app-header details[open]').forEach((el) => {
      if (keep && el.contains(keep)) return;
      if (el.classList.contains('app-header-nav') && window.matchMedia('(min-width: 961px)').matches) return;
      el.open = false;
    });
  }
  if (!globalThis.__wcagHeaderLoginBound) {
    globalThis.__wcagHeaderLoginBound = true;
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      // Any element marked data-open-login opens the sign-in dialog, on every page.
      if (target.closest('#wcag-header-login, [data-open-login]')) {
        document.dispatchEvent(new CustomEvent('wcag:open-login'));
      }
      closeHeaderMenus(target);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const open = document.querySelector('.app-header .nav-account[open]');
      if (!open) return;
      open.open = false;
      open.querySelector('summary')?.focus();
    });
    window.addEventListener('resize', syncHeaderNav);
    document.addEventListener('astro:page-load', () => {
      syncHeaderNav();
      refreshHeaderBalance();
    });
    document.addEventListener('wcag:logged-in', (event) => {
      if (event.detail?.role === 'customer') refreshHeaderBalance(true);
    });
    document.addEventListener('wcag:balance-changed', () => refreshHeaderBalance(true));
  }
  syncHeaderNav();
</script>

<style>
  :global(body.is-staff) .wcag-header-login,
  :global(body.is-customer) .wcag-header-login,
  :global(body.is-staff) .wcag-header-signup,
  :global(body.is-customer) .wcag-header-signup {
    display: none;
  }
  :global(body:not(.is-staff):not(.is-customer)) .wcag-header-account {
    display: none;
  }
  /* Display rules below would otherwise beat the hidden attribute. */
  .wcag-header-balance[hidden] {
    display: none;
  }
  .app-header-nav > summary,
  .nav-account > summary {
    list-style: none;
  }
  .app-header-nav > summary::-webkit-details-marker,
  .nav-account > summary::-webkit-details-marker {
    display: none;
  }
</style>
