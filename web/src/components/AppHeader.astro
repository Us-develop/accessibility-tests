---
interface Step {
  key: 'history' | 'results' | 'coverage' | 'sales' | 'statement' | 'developer';
  label: string;
}

interface Props {
  /** Domain (eg. "about-us.be") if an audit is loaded; null on the home/run-form page. */
  domain?: string | null;
  /** Run id under the domain, used to build links. */
  runId?: string | null;
  /** Which step is currently active. Pass null for the new-audit / loading screens. */
  active?: Step['key'] | null;
  /** Crumb shown when no audit is loaded. Defaults to "New scan". */
  crumb?: string;
}

const { domain = null, runId = null, active = null, crumb = 'New scan' } = Astro.props;

const STEPS: Step[] = [
  { key: 'history', label: 'History' },
  { key: 'results', label: 'Results' },
  { key: 'coverage', label: 'Coverage' },
  { key: 'sales', label: 'Sales' },
  { key: 'statement', label: 'Statement' },
  { key: 'developer', label: 'Developer' },
];

function stepHref(stepKey: Step['key']): string | null {
  if (!domain) return null;
  if (stepKey === 'history') return `/report/${encodeURIComponent(domain)}/history`;
  if (!runId) return null;
  if (stepKey === 'results') return `/report/${encodeURIComponent(domain)}/${encodeURIComponent(runId)}/`;
  if (stepKey === 'coverage') return `/report/${encodeURIComponent(domain)}/${encodeURIComponent(runId)}/coverage`;
  if (stepKey === 'sales') return `/report/${encodeURIComponent(domain)}/${encodeURIComponent(runId)}/sales`;
  if (stepKey === 'statement') return `/report/${encodeURIComponent(domain)}/${encodeURIComponent(runId)}/statement`;
  if (stepKey === 'developer') return `/report/${encodeURIComponent(domain)}/${encodeURIComponent(runId)}/accessibility-developers.html`;
  const _exhaustive: never = stepKey;
  return _exhaustive;
}

const activeLabel = STEPS.find((s) => s.key === active)?.label || '';
const access = Astro.locals?.access;
const sessionHint = access?.role === 'staff' || access?.role === 'customer';
const isCustomer = access?.role === 'customer';
const onHome = Astro.url.pathname === '/';
---

<header class="app-header" data-screen-label="App header">
  <div class="app-header-inner">
    <a class="brand" href="/" aria-label="Us home">
      <span class="brand-marks" aria-hidden="true">
        <img src="/assets/logo-u-dark.svg" width="28" height="28" alt="" />
        <img src="/assets/logo-s-dark.svg" width="28" height="28" alt="" />
      </span>
    </a>

    {domain ? (
      <nav class="nav-crumbs" aria-label="Audit progress" style="font-family: var(--font-mono);">
        {(() => {
          const href = stepHref('history');
          return href ? (
            <a class={`step ${active === 'history' ? 'active' : ''}`} href={href}>{domain}</a>
          ) : (
            <span class="step">{domain}</span>
          );
        })()}
        {active && active !== 'history' ? (
          <>
            <span class="sep">/</span>
            <span class="step active">{activeLabel}</span>
          </>
        ) : null}
      </nav>
    ) : (
      <nav class="nav-crumbs" aria-label="Audit setup">
        <span class="step active">{crumb}</span>
      </nav>
    )}

    <details class="app-header-nav">
      <summary class="app-header-menu-toggle" aria-label="Open menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </summary>
      <div class="app-header-chrome">
        {/* Every scan of the signed-in account. The site name in the crumbs leads to that site's history. */}
        <a
          class="btn btn-sm btn-secondary btn-all-scans wcag-header-account"
          href="/audits"
          aria-current={Astro.url.pathname === '/audits' ? 'page' : undefined}
        >
          All scans
        </a>
        <a class="btn btn-primary btn-sm" href="/" aria-current={onHome ? 'page' : undefined}>Start new scan</a>
        <a
          class="btn btn-ghost btn-sm wcag-header-balance"
          id="wcag-header-balance"
          href="/account#tokens"
          data-customer={isCustomer ? '1' : undefined}
          hidden
        ></a>
        <a class="btn btn-ghost btn-sm wcag-header-account" href="/account">Account</a>
        <a class="btn btn-ghost btn-sm" href="/pricing">Pricing</a>
        <span class="muted" style="font-size: 13px;">WCAG 2.2 AA aligned</span>
        <a class="btn btn-ghost wcag-header-signup" href="/signup">Create account</a>
        <button type="button" class="btn btn-ghost wcag-header-login" id="wcag-header-login">
          Log in
        </button>
        <div id="wcag-session-bar" class="wcag-session-bar" hidden={!sessionHint}>
          <button type="button" id="wcag-logout-btn" class="wcag-session-logout" aria-label="Log out">
            Log out
          </button>
        </div>
      </div>
    </details>
  </div>
</header>

<script>
  import { balanceLong, balanceShort, fetchBalance } from '../lib/balance.js';

  /** Fill the balance link for a signed-in customer; keep it hidden for everyone else. */
  async function refreshHeaderBalance(force = false) {
    const el = document.getElementById('wcag-header-balance');
    if (!el) return;
    if (!force && el.dataset.customer !== '1') {
      el.hidden = true;
      return;
    }
    const balance = await fetchBalance();
    if (!balance) {
      el.hidden = true;
      return;
    }
    el.dataset.customer = '1';
    el.textContent = balanceShort(balance);
    el.setAttribute('aria-label', `Your balance: ${balanceLong(balance)}. Open your account.`);
    el.hidden = false;
  }

  function syncHeaderNav() {
    document.querySelectorAll('details.app-header-nav').forEach((el) => {
      if (!(el instanceof HTMLDetailsElement)) return;
      if (window.matchMedia('(min-width: 481px)').matches) el.open = true;
    });
  }
  if (!globalThis.__wcagHeaderLoginBound) {
    globalThis.__wcagHeaderLoginBound = true;
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      // Any element marked data-open-login opens the sign-in dialog, on every page.
      if (target.closest('#wcag-header-login, [data-open-login]')) {
        document.dispatchEvent(new CustomEvent('wcag:open-login'));
      }
    });
    window.addEventListener('resize', syncHeaderNav);
    document.addEventListener('astro:page-load', () => {
      syncHeaderNav();
      refreshHeaderBalance();
    });
    document.addEventListener('wcag:logged-in', (event) => {
      if (event.detail?.role === 'customer') refreshHeaderBalance(true);
    });
    document.addEventListener('wcag:balance-changed', () => refreshHeaderBalance(true));
  }
  syncHeaderNav();
</script>

<style>
  :global(body.is-staff) .wcag-header-login,
  :global(body.is-customer) .wcag-header-login,
  :global(body.is-staff) .wcag-header-signup,
  :global(body.is-customer) .wcag-header-signup {
    display: none;
  }
  :global(body:not(.is-staff):not(.is-customer)) .wcag-header-account {
    display: none;
  }
  /* .btn sets display, which would otherwise beat the hidden attribute. */
  .wcag-header-balance[hidden] {
    display: none;
  }
  .btn-all-scans {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }
  .app-header-nav > summary {
    list-style: none;
  }
  .app-header-nav > summary::-webkit-details-marker {
    display: none;
  }
</style>
