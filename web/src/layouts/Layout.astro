---
import { ClientRouter } from 'astro:transitions';
import LoginModal from '../components/LoginModal.astro';

interface Props {
  title?: string;
  /** Allow search engines on the public teaser landing and result pages. */
  indexable?: boolean;
  /** guest-ok: public pages. required: staff report/admin pages still lock until login. */
  authMode?: 'required' | 'guest-ok';
}
const { title = 'Accessibility audit · Us', indexable = false, authMode = 'required' } = Astro.props;
const publicAppBase = import.meta.env.PUBLIC_APP_BASE?.trim() ?? '';
const devApiBase =
  import.meta.env.DEV && (import.meta.env.PUBLIC_DEV_API_URL?.trim() ?? '')
    ? import.meta.env.PUBLIC_DEV_API_URL.trim()
    : '';
/** In dev, prefer direct API URL so multipart POST skips Vite proxy; production still uses PUBLIC_APP_BASE. */
const appBaseMeta =
  import.meta.env.DEV && devApiBase ? devApiBase : publicAppBase || devApiBase;
/** Non-HttpOnly hint cookie so SSR can skip the login overlay on staff navigations. */
const staffHint = Astro.cookies.get('wcag_ui')?.value === '1';
const gateLocked = authMode === 'required' && !staffHint;
---
<!DOCTYPE html>
<html lang="en" class={staffHint ? 'wcag-staff' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ClientRouter />
    {indexable ? (
      <meta name="robots" content="index, follow" />
    ) : (
      <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    )}
    <title>{title}</title>
    {appBaseMeta ? <meta name="accessibility-app-base" content={appBaseMeta} /> : null}
    <link rel="icon" href="/assets/us-favicon.png" type="image/png" sizes="88x88" />
    <link rel="apple-touch-icon" href="/assets/us-favicon.png" />
    <link rel="stylesheet" href="/styles/tokens.css" />
    <link rel="stylesheet" href="/styles/app.css" />
    <script is:inline>
      (function () {
        try {
          var staff = false;
          try { staff = sessionStorage.getItem('wcagStaff') === '1'; } catch (e) {}
          if (!staff && typeof document.cookie === 'string' && /(^|; )wcag_ui=1(;|$)/.test(document.cookie)) {
            staff = true;
          }
          if (staff) document.documentElement.classList.add('wcag-staff');
        } catch (e) {}
        var m = document.querySelector('meta[name="accessibility-app-base"]');
        var base = (m && m.getAttribute('content')) ? m.getAttribute('content').trim().replace(/\/$/, '') : '';
        globalThis.wcagApiUrl = function (path) {
          var p = path.charAt(0) === '/' ? path : '/' + path;
          if (!base) return p;
          if (/^https?:\/\//i.test(base)) return base + p;
          return base + p;
        };
        globalThis.wcagFetchCredentials = function () {
          if (!base) return 'same-origin';
          if (/^https?:\/\//i.test(base)) return 'include';
          return 'same-origin';
        };
      })();
    </script>
  </head>
  <body data-wcag-auth={authMode}>
    <div
      id="wcag-main"
      class="wcag-main-shell"
      hidden={gateLocked}
      inert={gateLocked ? true : undefined}
    >
      <slot />
    </div>
    <div id="wcag-session-bar" class="wcag-session-bar" hidden={!staffHint}>
      <button type="button" id="wcag-logout-btn" class="wcag-session-logout" aria-label="Log out">
        Log out
      </button>
    </div>
    <LoginModal startLocked={gateLocked} />
    <script is:inline>
      (function () {
        if (!document.documentElement.classList.contains('wcag-staff')) return;
        var main = document.getElementById('wcag-main');
        if (main) {
          main.hidden = false;
          main.removeAttribute('inert');
        }
        var overlay = document.getElementById('wcag-login-modal');
        if (overlay && overlay.getAttribute('data-start-locked') === 'true') {
          overlay.hidden = true;
          overlay.setAttribute('aria-hidden', 'true');
        }
        var bar = document.getElementById('wcag-session-bar');
        if (bar) bar.hidden = false;
        document.body.classList.add('is-staff');
      })();
    </script>
    <noscript>
      <div class="wcag-noscript">
        {authMode === 'guest-ok'
          ? 'Enable JavaScript to run a free accessibility check.'
          : 'Enable JavaScript to sign in and use this app.'}
      </div>
    </noscript>
    <style is:global>
      html.wcag-staff #wcag-login-modal {
        display: none !important;
      }
      html.wcag-staff #wcag-main.wcag-main-shell[hidden] {
        display: block !important;
      }
      @keyframes wcag-fade-out {
        to { opacity: 0; }
      }
      @keyframes wcag-fade-in {
        from { opacity: 0; }
      }
      @media (prefers-reduced-motion: no-preference) {
        ::view-transition-old(root) {
          animation: 160ms ease-out both wcag-fade-out;
        }
        ::view-transition-new(root) {
          animation: 220ms ease-in both wcag-fade-in;
        }
      }
      @media print {
        .app-header,
        .wcag-session-bar,
        .wcag-login-overlay {
          display: none !important;
        }
      }
      .wcag-session-bar {
        position: fixed;
        top: 0;
        right: 0;
        z-index: 99900;
        padding: calc(12px + env(safe-area-inset-top, 0px)) calc(16px + env(safe-area-inset-right, 0px))
          calc(12px + env(safe-area-inset-bottom, 0px)) calc(16px + env(safe-area-inset-left, 0px));
        pointer-events: auto;
      }
      .wcag-session-logout {
        font-family: var(--font-body, 'Public Sans', system-ui, sans-serif);
        font-size: 0.875rem;
        font-weight: 600;
        padding: 8px 14px;
        border-radius: 10px;
        border: 1px solid rgba(25, 25, 27, 0.12);
        background: rgba(255, 255, 255, 0.85);
        color: var(--fg-1, #19191b);
        cursor: pointer;
        box-shadow: 0 2px 10px rgba(25, 25, 27, 0.06);
      }
      .wcag-session-logout:hover {
        filter: brightness(0.97);
        border-color: rgba(25, 25, 27, 0.2);
      }
      .wcag-session-logout:focus-visible {
        outline: 2px solid var(--focus-ring, #6257e8);
        outline-offset: 2px;
      }
      .wcag-noscript {
        position: fixed;
        inset: 0;
        z-index: 100000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: var(--us-cream, #f5f4e5);
        font-family: var(--font-body, system-ui, sans-serif);
        font-size: 1rem;
        color: var(--fg-1, #19191b);
      }
    </style>
  </body>
</html>
