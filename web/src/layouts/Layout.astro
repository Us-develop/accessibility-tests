---
import { existsSync, readdirSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { ClientRouter } from 'astro:transitions';
import LoginModal from '../components/LoginModal.astro';
import { companyIdentity } from '../../../server/company.mjs';

interface Props {
  title?: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  /** guest-ok: public pages. required: staff report/admin pages still lock until login. */
  authMode?: 'required' | 'guest-ok';
}
const {
  title = 'Accessibility audit · Us',
  description,
  canonical,
  ogImage = '/assets/og-default.png',
  noindex = true,
  authMode = 'required',
} = Astro.props;
const company = companyIdentity();
const publicAppBase = import.meta.env.PUBLIC_APP_BASE?.trim() ?? '';
const devApiBase =
  import.meta.env.DEV && (import.meta.env.PUBLIC_DEV_API_URL?.trim() ?? '')
    ? import.meta.env.PUBLIC_DEV_API_URL.trim()
    : '';
/** In dev, prefer direct API URL so multipart POST skips Vite proxy; production still uses PUBLIC_APP_BASE. */
const appBaseMeta =
  import.meta.env.DEV && devApiBase ? devApiBase : publicAppBase || devApiBase;
/** Non-HttpOnly hint cookie so SSR can skip the login overlay on signed-in navigations. */
const uiHint = Astro.cookies.get('wcag_ui')?.value;
const staffHint = uiHint === '1' || uiHint === 'c';
const signedRole = uiHint === '1' ? 'staff' : uiHint === 'c' ? 'customer' : '';
const gateLocked = authMode === 'required' && !staffHint;

const siteOrigin = String(Astro.site ?? import.meta.env.PUBLIC_BASE_URL ?? 'https://wcag.about-us.be')
  .trim()
  .replace(/\/$/, '');
const canonicalHref =
  canonical || `${siteOrigin}${Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '') || '/'}`;
const ogImageAbs = ogImage.startsWith('http') ? ogImage : `${siteOrigin}${ogImage.startsWith('/') ? ogImage : `/${ogImage}`}`;
const siteName = company.legalName || 'Us';

const ownersDir = join(dirname(fileURLToPath(import.meta.url)), '../../public/fonts/owners');
const ownerFiles = existsSync(ownersDir)
  ? readdirSync(ownersDir).filter((name) => name.toLowerCase().endsWith('.woff2'))
  : [];
const wideOwner = ownerFiles.find((name) => /wide/i.test(name));
const displayPreload = wideOwner ? `/fonts/owners/${wideOwner}` : '/fonts/archivo-700-normal.woff2';

function ownerFamily(filename: string): string {
  return /wide/i.test(filename) ? 'owners-wide' : 'owners';
}
function ownerWeight(filename: string): string {
  const match = filename.match(/(300|400|500|600|700|800|900)/);
  return match ? match[1] : '700';
}
---
<!DOCTYPE html>
<html lang="en" class={staffHint ? 'wcag-staff' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ClientRouter />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    {appBaseMeta ? <meta name="accessibility-app-base" content={appBaseMeta} /> : null}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/assets/us-favicon.png" type="image/png" sizes="88x88" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" sizes="180x180" />
    <link rel="preload" href="/fonts/public-sans-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/public-sans-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayPreload} as="font" type="font/woff2" crossorigin />
    {ownerFiles.length ? (
      <style>
        {ownerFiles.map((file) => `@font-face{font-family:"${ownerFamily(file)}";src:url("/fonts/owners/${file}") format("woff2");font-weight:${ownerWeight(file)};font-style:normal;font-display:swap;unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}`).join('')}
      </style>
    ) : null}
    <link rel="stylesheet" href="/styles/tokens.css" />
    <link rel="stylesheet" href="/styles/app.css" />
    <slot name="head" />
    <script is:inline>
      (function () {
        try {
          var params = new URLSearchParams(window.location.search);
          var dirty = false;
          ['password', 'currentPassword', 'newPassword', 'username'].forEach(function (key) {
            if (params.has(key)) {
              params.delete(key);
              dirty = true;
            }
          });
          if (dirty) {
            var qs = params.toString();
            history.replaceState(null, '', window.location.pathname + (qs ? '?' + qs : '') + window.location.hash);
          }
        } catch (e) {}
        try {
          var staff = false;
          try { staff = sessionStorage.getItem('wcagStaff') === '1'; } catch (e) {}
          if (!staff && typeof document.cookie === 'string' && /(^|; )wcag_ui=(?:1|c)(;|$)/.test(document.cookie)) {
            staff = true;
          }
          if (staff) document.documentElement.classList.add('wcag-staff');
        } catch (e) {}
        var m = document.querySelector('meta[name="accessibility-app-base"]');
        var base = (m && m.getAttribute('content')) ? m.getAttribute('content').trim().replace(/\/$/, '') : '';
        globalThis.wcagApiUrl = function (path) {
          var p = path.charAt(0) === '/' ? path : '/' + path;
          if (!base) return p;
          if (/^https?:\/\//i.test(base)) return base + p;
          return base + p;
        };
        globalThis.wcagFetchCredentials = function () {
          if (!base) return 'same-origin';
          if (/^https?:\/\//i.test(base)) return 'include';
          return 'same-origin';
        };
        globalThis.wcagCsrfToken = function () {
          var match = typeof document.cookie === 'string' ? document.cookie.match(/(?:^|; )wcag_csrf=([^;]*)/) : null;
          return match ? decodeURIComponent(match[1]) : '';
        };
        globalThis.wcagHeaders = function (extra) {
          var headers = extra ? Object.assign({}, extra) : {};
          var token = globalThis.wcagCsrfToken();
          if (token) headers['X-CSRF-Token'] = token;
          return headers;
        };
        function fillCsrfFields() {
          var token = globalThis.wcagCsrfToken();
          if (!token) return;
          document.querySelectorAll('input.wcag-csrf-field').forEach(function (el) {
            el.value = token;
          });
        }
        globalThis.wcagFillCsrfFields = fillCsrfFields;
        document.addEventListener('DOMContentLoaded', fillCsrfFields);
        document.addEventListener('astro:page-load', fillCsrfFields);
      })();
    </script>
  </head>
  <body data-wcag-auth={authMode} class={signedRole === 'staff' ? 'is-staff' : signedRole === 'customer' ? 'is-customer' : undefined}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <div
      id="wcag-main"
      class="wcag-main-shell"
      hidden={gateLocked}
      inert={gateLocked ? true : undefined}
    >
      <slot />
    </div>
    <LoginModal startLocked={gateLocked} />
    <footer class="site-legal">
      <nav class="site-legal-links" aria-label="Legal">
        <a href="/pricing">Pricing</a>
        <a href="/terms">Terms</a>
        <a href="/privacy">Privacy</a>
        <a href="/cookies">Cookies</a>
        <a href="/legal/subprocessors">Subprocessors</a>
        <a href="/accessibility">Accessibility</a>
        <a href="https://about-us.be/contact/">Us-diensten</a>
      </nav>
      {company.legalName ? (
        <p class="site-legal-identity">
          {company.legalName}
          {company.vat ? ` · VAT ${company.vat}` : ''}
          {company.kbo ? ` · KBO ${company.kbo}` : ''}
          {company.address ? ` · ${company.address}` : ''}
          {company.email ? (
            <>
              {' · '}
              <a href={`mailto:${company.email}`}>{company.email}</a>
            </>
          ) : null}
        </p>
      ) : null}
    </footer>
    <script is:inline>
      (function () {
        if (!document.documentElement.classList.contains('wcag-staff')) return;
        var main = document.getElementById('wcag-main');
        if (main) {
          main.hidden = false;
          main.removeAttribute('inert');
        }
        var overlay = document.getElementById('wcag-login-modal');
        if (overlay && overlay.getAttribute('data-start-locked') === 'true') {
          overlay.hidden = true;
          overlay.setAttribute('aria-hidden', 'true');
        }
        var bar = document.getElementById('wcag-session-bar');
        if (bar) bar.hidden = false;
        if (/(?:^|; )wcag_ui=c(?:;|$)/.test(document.cookie || '')) {
          document.body.classList.add('is-customer');
          document.body.classList.remove('is-staff');
        } else {
          document.body.classList.add('is-staff');
        }
      })();
    </script>
    <noscript>
      <div class="wcag-noscript">
        {authMode === 'guest-ok'
          ? 'Enable JavaScript to run a free accessibility check.'
          : 'Enable JavaScript to sign in and use this app.'}
      </div>
    </noscript>
    <style is:global>
      html.wcag-staff #wcag-login-modal {
        display: none !important;
      }
      html.wcag-staff #wcag-main.wcag-main-shell[hidden] {
        display: block !important;
      }
      @keyframes wcag-fade-out {
        to { opacity: 0; }
      }
      @keyframes wcag-fade-in {
        from { opacity: 0; }
      }
      @media (prefers-reduced-motion: no-preference) {
        ::view-transition-old(root) {
          animation: 160ms ease-out both wcag-fade-out;
        }
        ::view-transition-new(root) {
          animation: 220ms ease-in both wcag-fade-in;
        }
      }
      @media print {
        .app-header,
        .wcag-session-bar,
        .wcag-login-overlay {
          display: none !important;
        }
      }
      .wcag-noscript {
        position: fixed;
        inset: 0;
        z-index: 100000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: var(--us-cream, #f5f4e5);
        font-family: var(--font-body, system-ui, sans-serif);
        font-size: 1rem;
        color: var(--fg-1, #19191b);
      }
    </style>
  </body>
</html>
