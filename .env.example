# Root env template. Copy to `.env.local` (gitignored) for local work.
# Production: put these in `/etc/accessibility.env` (`chmod 600`). Host-injected
# values win over every dotenv file when NODE_ENV=production.
# Flag: "required in production" means the process exits or the feature is unusable without it.

# Runtime
# NODE_ENV=production  # required in production (systemd also sets this)
# PORT=3000  # required in production (Caddy proxies to localhost:3000). Local default 3456.
# REPORTS_BASE=  # not required in production (default ./reports)

# Auth / sessions
# AUTH_ENABLED=true  # required in production (keep true)
# APP_USERNAME=  # required in production
# APP_PASSWORD=  # required in production when AUTH_ENABLED=true; ≥12 characters
# SESSION_SECRET=  # required in production; ≥32 characters
# STAFF_SESSION_VERSION=1  # not required in production (default 1)
# AUTH_COOKIE_SECURE=true  # required in production (forced true)
# AUTH_COOKIE_SAMESITE=Lax  # not required in production (default Lax)
# TRUST_PROXY_HOPS=1  # not required in production (default 1)
# AUTH_EMAIL_VERIFY=required  # not required in production (default required when NODE_ENV=production)
# WCAG_DISABLE_RATE_LIMIT=  # tests only; do not set in production
# DEBUG_ENDPOINTS=false  # not required in production (default off)

# Public URL (emails, Stripe, scanner UA)
# PUBLIC_BASE_URL=https://wcag.about-us.be  # required in production (must not contain localhost)
# PUBLIC_APP_BASE=  # not required in production (Astro split-host API origin)
# PUBLIC_DEV_API_URL=  # not required in production (local astro dev only)
# ALLOWED_ORIGIN=*  # not required in production
# RELAX_CORS_LOCALHOST=false  # not required in production
# DEFER_ROOT_LOGIN_TO_SHELL=true  # not required in production (run-server.mjs default)
# ASTRO_NODE_AUTOSTART=disabled  # not required in production (run-server.mjs default)

# Company identity
# COMPANY_LEGAL_NAME=  # required in production
# COMPANY_KBO=  # required in production
# COMPANY_VAT=  # required in production
# COMPANY_ADDRESS=  # required in production
# COMPANY_EMAIL=  # required in production
# VAT_RATE_DISPLAY=0.21  # not required in production (default 0.21)

# Mail
# MAIL_FROM=noreply@about-us.be  # required in production (must not end with @localhost)
# SMTP_HOST=  # not required in production unless sending mail
# SMTP_PORT=587  # not required in production (default 587)
# SMTP_SECURE=false  # not required in production
# SMTP_USER=
# SMTP_PASSWORD=
# ACCESS_REQUEST_TO=info@about-us.be  # not required in production (default info@about-us.be)

# Postgres
# DATABASE_URL=  # required in production for concurrent accounts
# DATABASE_SSL=false  # not required in production for localhost Postgres
# DATABASE_CA=  # not required in production unless DATABASE_SSL=true and the CA is not in the system store

# Stripe
# STRIPE_SECRET_KEY=  # required in production to sell
# STRIPE_API_KEY=  # not required (legacy alias of STRIPE_SECRET_KEY)
# STRIPE_WEBHOOK_SECRET=  # required in production to sell
# STRIPE_PRICE_PACK_10=
# STRIPE_PRICE_PACK_50=
# STRIPE_PRICE_PACK_100=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_YEARLY=
# STRIPE_AUTOMATIC_TAX=true  # required in production (keep true)
# STRIPE_TAX_CODE=txcd_10103001  # not required in production; server warns if unset

# Scans
# SCAN_MAX_CONCURRENT=3  # not required in production (default 3)
# SCAN_JOB_TTL_MS=86400000  # not required in production (default 86400000)
# MAX_URLS_PER_RUN=  # not required in production
# URL_CONCURRENCY=1  # not required in production
# PAGE_GOTO_TIMEOUT_MS=90000  # not required in production
# WAIT_FOR_NETWORKIDLE=false  # not required in production
# BLOCK_MEDIA_REQUESTS=true  # not required in production
# LARGE_DOM_THRESHOLD=6000  # not required in production
# AUTO_DISABLE_CONTRAST_ON_LARGE_DOM=true  # not required in production
# ENABLE_CONTRAST_CHECKS=true  # not required in production
# ENABLE_AXE_PASSES=false  # not required in production
# SCANNER_NO_SANDBOX=false  # not required in production
# PLAYWRIGHT_BROWSERS_PATH=  # not required in production

# Guests / Turnstile / retention
# TURNSTILE_SITE_KEY=  # not required in production
# PUBLIC_TURNSTILE_SITE_KEY=  # not required (alias of TURNSTILE_SITE_KEY)
# TURNSTILE_SECRET_KEY=  # not required in production
# TURNSTILE_SEND_IP=false  # not required in production
# GUEST_IP_HASH_SALT=  # not required in production (falls back to SESSION_SECRET)
# LEAD_RETENTION_DAYS=365  # not required in production (default 365)
# GUEST_RUN_RETENTION_DAYS=30  # not required in production (default 30)

# FTP (optional). Default FTPS; production refuses plaintext.
# FTP_HOST=
# FTP_USER=
# FTP_PASSWORD=
# FTP_SECURE=true  # required in production if FTP is configured (default true)
# FTP_REMOTE_PATH=

# Jira / Atlassian (staff). Keep ATLASSIAN_CLIENT_SECRET only in the production env file.
# ATLASSIAN_CLIENT_ID=
# ATLASSIAN_CLIENT_SECRET=  # rotate in the Atlassian console; never commit
# ATLASSIAN_REDIRECT_URI=

# Optional Anthropic write-up
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5  # not required in production
